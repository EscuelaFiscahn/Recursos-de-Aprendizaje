Cell["\<\
La ventaja mec\[AAcute]nica (V.M.) se define como la raz\[OAcute]n de los m\
\[OAcute]dulos de la fuerza resistencia y potencia. \
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9604650382285175`*^9, 3.9604650711127453`*^9}, {
  3.9621104970966644`*^9, 3.9621105008015385`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"d2697ffa-5173-a648-ae51-e6261cf1395c"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["V", "TI"], ".", 
       StyleBox["M", "TI"], ".", "\[LongEqual]", 
       FractionBox[
        StyleBox["R", "TI"], 
        StyleBox["F", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
   "V.M.=\\frac{R}{F}", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{3.960465079303793*^9},
 TextAlignment->Center,ExpressionUUID->"ccbabae9-ea06-c447-980f-2cacb8c63019"],

Cell["\<\
Si las fuerzas son perpendiculares a la palanca, la relaci\[OAcute]n de las \
fuerzas ser\[IAcute]a: \
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9604651130547447`*^9, 3.9604651397805767`*^9}, {
  3.9604651928004856`*^9, 3.960465210935089*^9}, {3.977658194391254*^9, 
  3.977658195025091*^9}},
 TextAlignment->Center,
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"ed714419-8787-ed41-a03b-11c6485dea91"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], ".", 
         StyleBox["M", "TI"], ".", "\[LongEqual]", 
         FractionBox[
          SubscriptBox[
           StyleBox["d", "TI"], "1"], 
          SubscriptBox[
           StyleBox["d", "TI"], "2"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "V.M.=\\frac{d_1}{d_2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], 
   RowBox[{"(", 
    RowBox[{"Fuerzas", 
     TemplateBox[<|
      "boxes" -> FormBox["\[Perpendicular]", TraditionalForm], "errors" -> {},
        "input" -> "\\perp", "state" -> "Boxes"|>,
      "TeXAssistantTemplate"], "palanca"}], ")"}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{3.9776581902526827`*^9},
 TextAlignment->Center,ExpressionUUID->"3bab828c-d5ba-4910-9066-b84fcf1e66d0"],

Cell["\<\
El desarrollo evolutivo de brazos, piernas y otras estructuras del esqueleto \
en el hombre y en los animales han sido fuertemente influidos por las \
necesidades de los animales. \
\>", "Text",

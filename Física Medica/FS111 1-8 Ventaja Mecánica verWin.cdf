Cell[TextData[{
 "La pata delantera de un caballo de carreras tiene una ventaja \
mec\[AAcute]nica relativamente peque\[NTilde]a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], ".", 
         StyleBox["M", "TI"], ".", "\[LongEqual]", "0.08"}], TraditionalForm],
      "errors" -> {}, "input" -> "V.M.=0.08", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7d596f8e-c8df-394f-939a-6f2d35e71266"],
 ". El armadillo tiene una pata delantera cuya ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], ".", 
         StyleBox["M", "TI"], ".", "\[LongEqual]", "0.25"}], TraditionalForm],
      "errors" -> {}, "input" -> "V.M.=0.25", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3c9759ba-542d-2c46-bc1b-65147d9d20a4"],
 ". Podemos ver que el armadillo aunque no puede moverse con tanta velocidad, \
tiene la fuerza suficiente para excavar. "
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9604655130273514`*^9, 3.9604656066415157`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"77b70673-dbce-af43-a16a-58dba14d230b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Animal\>\"", "->", "\"\<Armadillo\>\""}], ",", 
        RowBox[{"\"\<BrazoDePotencia\>\"", "->", "4"}], ",", 
        RowBox[{"\"\<BrazoDeResistencia\>\"", "->", "2"}], ",", 
        RowBox[{"\"\<VM\>\"", "->", 
         RowBox[{"4", "/", "2"}]}], ",", 
        RowBox[{"\"\<Funcion\>\"", 
         "->", "\"\<Excavaci\[OAcute]n (fuerza)\>\""}]}], "|>"}], ",", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Animal\>\"", "->", "\"\<Caballo\>\""}], ",", 
        RowBox[{"\"\<BrazoDePotencia\>\"", "->", "10"}], ",", 
        RowBox[{"\"\<BrazoDeResistencia\>\"", "->", "75"}], ",", 
        RowBox[{"\"\<VM\>\"", "->", 
         RowBox[{"10", "/", "75"}]}], ",", 
        RowBox[{"\"\<Funcion\>\"", "->", "\"\<Carrera (velocidad)\>\""}]}], 
       "|>"}]}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"Values", ",", "data"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Animal\>\"", ",", "\"\<Brazo de Potencia (cm)\>\"", 
       ",", "\"\<Brazo de Resistencia (cm)\>\"", ",", "\"\<VM estimada\>\"", 
       ",", "\"\<Funci\[OAcute]n dominante\>\""}], "}"}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"ItemStyle", "->", "Bold"}]}], "]"}]}], "Input",
 CellOpen->False,
 CellChangeTimes->{{3.9622052925510826`*^9, 3.9622052935855236`*^9}},
 CellLabel->
  "In[146]:=",ExpressionUUID->"25c73426-c9f4-e04c-acd3-749cee2ca6f6"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Animal\"\>", "\<\"Brazo de Potencia (cm)\"\>", "\<\"Brazo de \
Resistencia (cm)\"\>", "\<\"VM estimada\"\>", "\<\"Funci\[OAcute]n \
dominante\"\>"},
    {"\<\"Armadillo\"\>", "4", "2", 
     "2", "\<\"Excavaci\[OAcute]n (fuerza)\"\>"},
    {"\<\"Caballo\"\>", "10", "75", 
     FractionBox["2", "15"], "\<\"Carrera (velocidad)\"\>"}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxItemStyle->{"Columns" -> {{Bold}}, "Rows" -> {{Bold}}}],
  "Grid"]], "Output",
 CellChangeTimes->{3.962205294022793*^9, 3.9776656903520517`*^9},
 TextAlignment->Center,
 CellLabel->
  "Out[147]=",ExpressionUUID->"3c9dcf45-2afb-46ec-8844-588fdf53a86d"]
}, Open  ]],


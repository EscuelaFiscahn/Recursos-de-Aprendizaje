  0.94, 0.91, 0.88],ExpressionUUID->"7febade8-ac2c-4fd0-af9a-c776c4dd8c64"],

Cell[TextData[{
 "Recordemos que cuando las fuerzas son perpendiculares a una palanca, la \
ventaja mec\[AAcute]nica es: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], ".", 
         StyleBox["M", "TI"], ".", "\[LongEqual]", 
         FractionBox[
          SubscriptBox[
           StyleBox["d", "TI"], "1"], 
          SubscriptBox[
           StyleBox["d", "TI"], "2"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "V.M.=\\frac{d_1}{d_2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6459d9f6-45dd-da4e-8617-f92dfccd983a"],
 ", por lo tanto\nLas extremidades cortas con peque\[NTilde]os valores de ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["d", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "d_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2fe2631e-9d46-4f42-a445-e4882d9a8339"],
 ", tendr\[AAcute]n ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], ".", 
         StyleBox["M", "TI"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "V.M.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e87e341c-d4bf-444b-ae27-9855aa9cac51"],
 " relativamente grandes o ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], ".", 
         StyleBox["M", "TI"], ">", "1"}], TraditionalForm], "errors" -> {}, 
     "input" -> "V.M >1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3cfa08ad-c7fd-254c-a85f-4f9b89921d0e"],
 " y ser\[AAcute]n capaces de ejercer grandes fuerzas. Y por lo tanto, las \
extremidades largas ser\[IAcute]a lo opuesto, con ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], ".", 
         StyleBox["M", "TI"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "V.M.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e6b1bf4f-fd07-1548-b027-ac99d3aecbd4"],
 " relativamente peque\[NTilde]as o ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], ".", 
         StyleBox["M", "TI"], ".", "<", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "V.M. <1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8030760b-70ea-0943-b784-7b7886f40006"],
 " y ser\[AAcute]n capaces de alcanzar altas velocidades. "
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.960465264179405*^9, 3.960465427261059*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"7e08f886-2de1-de4f-ae06-b99e25feed2a"],


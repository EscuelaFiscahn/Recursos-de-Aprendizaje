Cell[TextData[{
 "Puede obtener las ventajas mec\[AAcute]nicas, de los tres tipos de palanca \
descritos anteriormente. Comenzando con la palanca de clase I, donde ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["d", "TI"], "1"], "\[LongEqual]", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "d_1=2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "961719d6-eae8-344f-90be-cb7f1a5dd453"],
 " cm  y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["d", "TI"], "2"], "\[LongEqual]", "8"}], TraditionalForm], 
     "errors" -> {}, "input" -> "d_2=8", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "92286b0b-7339-7344-99b1-e147752cc416"],
 " cm. "
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.965978310881405*^9, 3.965978405418705*^9}, {
  3.965978932408964*^9, 3.9659789331109295`*^9}, {3.977658253526648*^9, 
  3.977658253952107*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"05ff89e1-7b80-5043-9a48-40c577f56436"],


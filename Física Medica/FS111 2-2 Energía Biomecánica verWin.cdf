Cell[TextData[{
 StyleBox["2. Energ\[IAcute]a Potencial Gravitatoria (U):",
  FontWeight->"Bold"],
 " \n\nLa energ\[IAcute]a asociada a las configuraciones  debido a la posici\
\[OAcute]n de un cuerpo en un campo gravitatorio. Se relaciona directamente \
con la altura de  del cuerpo en funci\[OAcute]n de un sistema de referencia."
}], "Text",

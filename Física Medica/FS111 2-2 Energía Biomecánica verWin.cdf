          RowBox[{"Darker", "@", "Blue"}]}], "]"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generar", " ", "la", " ", "tabla", " ", "en", " ", "formato", " ", "de", 

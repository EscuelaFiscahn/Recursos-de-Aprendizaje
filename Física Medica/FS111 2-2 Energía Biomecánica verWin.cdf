Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Datos", " ", "para", " ", "la", " ", "tabla", " ", "de", " ", 
     "energ\[IAcute]a"}], ",", 
    RowBox[{
    "sin", " ", "la", " ", "columna", " ", "de", " ", "Prefijos", " ", 
     "SI"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"tablaEnergia", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\"\<Actividad/Escenario\>\"", ",", "\"\<Descripci\[OAcute]n\>\"", 
         ",", "\"\<Valor de Energ\[IAcute]a (Joules, J)\>\"", ",", 
         "\"\<Aplicaci\[OAcute]n M\[EAcute]dica\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Caminar 1 km\>\"", ",", 
         "\"\<Gasto energ\[EAcute]tico aproximado por caminar en una \
superficie plana.\>\"", ",", "\"\<210000 J\>\"", ",", 
         "\"\<Medicina deportiva, fisioterapia, manejo del peso.\>\""}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Subir 10 escalones (70 kg)\>\"", ",", 
         "\"\<Trabajo contra la gravedad al subir un cuerpo de 70 kg una \
altura de 3 m (aprox. 10 escalones).\>\"", ",", "\"\<2058 J\>\"", ",", 
         "\"\<Evaluaci\[OAcute]n de la fuerza muscular de las piernas, \
rehabilitaci\[OAcute]n card\[IAcute]aca.\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Levantar un objeto (10 kg) a 1 m\>\"", ",", 
         "\"\<Trabajo para levantar un objeto de 10 kg contra la \
gravedad.\>\"", ",", "\"\<98.1 J\>\"", ",", 
         "\"\<Fisioterapia post-operatoria, ergonom\[IAcute]a \
ocupacional.\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Impacto de cabeza en f\[UAcute]tbol americano\>\"", ",", 
         "\"\<Energ\[IAcute]a absorbida por el cr\[AAcute]neo en un impacto a \
8.9 m/s (20 mph).\>\"", ",", "\"\<3000 J - 10000 J\>\"", ",", 
         "\"\<Traumatolog\[IAcute]a, neurocirug\[IAcute]a, dise\[NTilde]o de \
cascos de protecci\[OAcute]n.\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Desfibrilador Card\[IAcute]aco\>\"", ",", 
         "\"\<Energ\[IAcute]a liberada en un pulso el\[EAcute]ctrico para \
restaurar el ritmo card\[IAcute]aco.\>\"", ",", "\"\<200 J - 360 J\>\"", ",", 
         "\"\<Cardiolog\[IAcute]a, medicina de emergencia.\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Contracci\[OAcute]n muscular\>\"", ",", 
         "\"\<Energ\[IAcute]a liberada por una contracci\[OAcute]n muscular \
simple.\>\"", ",", "\"\<10\:207b\.b3 J - 10\:207b\.b9 J\>\"", ",", 
         "\"\<Electromiograf\[IAcute]a (EMG), fisiolog\[IAcute]a del \
ejercicio.\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Energ\[IAcute]a potencial de un salto\>\"", ",", 
         "\"\<Energ\[IAcute]a potencial ganada por un salto de 1 m de altura \
(70 kg).\>\"", ",", "\"\<686.7 J\>\"", ",", 
         "\"\<An\[AAcute]lisis de la marcha y el rendimiento deportivo, \
evaluaci\[OAcute]n de la fuerza.\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Energ\[IAcute]a de 1 kg de grasa corporal\>\"", ",", 
         "\"\<Energ\[IAcute]a almacenada en el tejido adiposo, que el cuerpo \
usa como reserva.\>\"", ",", "\"\<3.77 x 10\:2077 J (aprox.)\>\"", ",", 
         "\"\<Nutrici\[OAcute]n cl\[IAcute]nica, manejo de la obesidad, diet\
\[EAcute]tica.\>\""}], "}"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Nuevo", " ", "estilo", " ", "de", " ", "la", " ", "tabla", " ", "con", 
     " ", "colores", " ", "azules", " ", "y", " ", "grises"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"estiloTabla", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Frame", "->", "All"}], ",", 
       RowBox[{"Background", "->", 
        RowBox[{"{", 
         RowBox[{"None", ",", 
          RowBox[{"{", 
           RowBox[{"LightBlue", ",", 
            RowBox[{"{", 
             RowBox[{"Lighter", "@", "Yellow"}], "}"}]}], "}"}]}], "}"}]}], 
       ",", 
       RowBox[{"Alignment", "->", 
        RowBox[{"{", 
         RowBox[{"Left", ",", "Center"}], "}"}]}], ",", 
       RowBox[{"Dividers", "->", 
        RowBox[{"{", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"True", ",", "True", ",", 
            RowBox[{"{", "False", "}"}], ",", "True"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"ItemSize", "->", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", "Automatic"}], "}"}]}], ",", 
       RowBox[{"Spacings", "->", 
        RowBox[{"{", 

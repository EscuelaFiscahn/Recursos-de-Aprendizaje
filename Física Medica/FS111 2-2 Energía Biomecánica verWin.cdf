Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["U", "TI"], "\[LongEqual]", 
       FractionBox["1", "2"], 
       StyleBox["k", "TI"], "\[CapitalDelta]", 
       SuperscriptBox[
        StyleBox["x", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
   "input" -> "U = \\frac {1} {2} k \\Delta x^2", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9798164840109615`*^9, 3.979816487678688*^9}},
 TextAlignment->Center,ExpressionUUID->"9b6219d5-b6ab-f84f-9ba3-20cb30302199"],

Cell[TextData[{
 "Se puede describir el mecanismo de almacenamiento y liberaci\[OAcute]n de \
energ\[IAcute]a como ciclo de carga y descarga donde el m\[UAcute]sculo y \
tend\[OAcute]n opera como un sistema de almacenamiento y liberaci\[OAcute]n \
de energ\[IAcute]a.\n\n",
 StyleBox["1. Fase exc\[EAcute]ntrica (carga)",
  FontWeight->"Bold"],
 "\n* El m\[UAcute]sculo se activa mientras se estira\n* El tend\[OAcute]n se \
deforma (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "550c8848-d5dd-6940-a96b-b0b8aa2f1946"],
 " aumenta)\n* La energ\[IAcute]a mec\[AAcute]nica se convierte en energ\
\[IAcute]a potencial el\[AAcute]stica\n\n",
 StyleBox["2. Fase conc\[EAcute]ntrica (descarga)",
  FontWeight->"Bold"],
 "\n* La energ\[IAcute]a potencial el\[AAcute]stica se libera"
}], "Text",
 CellChangeTimes->{{3.959730955146678*^9, 3.959731004868496*^9}, {
   3.959731221973881*^9, 3.9597312426236067`*^9}, {3.9597312745241613`*^9, 

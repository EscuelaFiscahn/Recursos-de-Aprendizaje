Cell[TextData[{
 "donde ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["F", "TI"], 
        StyleBox["x", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "F_x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "284f972e-c41a-7643-bbfe-70abde4a33a4"],
 " es la fuerza aplicada al tend\[OAcute]n la cual se mide en (N), ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "231af329-544f-4d4b-8e9c-a770261af08f"],
 " es la constante de rigidez del tend\[OAcute]n medida en (N/m) y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cf691bfb-497c-5f4e-a2cb-5de5f8c8c969"],
 " es la deformaci\[OAcute]n o alargamiento del tend\[OAcute]n (m)."
}], "Text",
 CellChangeTimes->{{3.959730955146678*^9, 3.959731004868496*^9}, {

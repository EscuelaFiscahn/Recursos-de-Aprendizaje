Cell[CellGroupData[{

Cell["Fuerza explosiva", "Subsection",
 CellChangeTimes->{
  3.9700704296124096`*^9},ExpressionUUID->"87c37b93-9ae5-ba45-85b3-\
c7e844c10997"],

Cell[TextData[{
 "4. Fuerza explosiva: se refiere al desarrollo m\[AAcute]ximo de las \
tensiones musculares en un lapso de tiempo corto. Es decir, se realiza la \
mayor cantidad de fuerza posible en el menor tiempo posible.\n",

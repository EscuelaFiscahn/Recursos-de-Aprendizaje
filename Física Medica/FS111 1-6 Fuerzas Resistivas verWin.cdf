        SubscriptBox[
         StyleBox["N", "TI"], 
         StyleBox["w", "TI"]], 
        FractionBox[
         SubscriptBox[
          StyleBox["R", "TI"], 
          RowBox[{
            StyleBox["c", "TI"], 

Cell["\<\
Generalmente el volumen de desgaste aumenta proporcionalmente a la fuerza \
normal (carga aplicada) y a la distancia de desplazamiento:\
\>", "Text",
 CellChangeTimes->{{3.959707331010088*^9, 3.959707379902109*^9}, 
   3.9597074217248554`*^9, {3.9597074578099613`*^9, 3.9597075255095577`*^9}, {
   3.959707622426901*^9, 3.9597076279151287`*^9}, {3.959707732791094*^9, 
   3.9597078116706924`*^9}, {3.9776576449020033`*^9, 3.977657671928103*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"03c3743e-f88d-6844-b381-99007acabea6"],


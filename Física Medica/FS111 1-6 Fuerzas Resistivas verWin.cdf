Cell[BoxData[
 RowBox[{"QuestionObject", "[", 
  RowBox[{
  "\"\<La fuerza de fricci\[OAcute]n en una articulaci\[OAcute]n sana es \
aproximadamente 10 veces menor que en una articulaci\[OAcute]n con \
osteoartritis, debido a que el coeficiente de fricci\[OAcute]n del cart\
\[IAcute]lago hidratado es mucho menor que el de cart\[IAcute]lago \
degenerado.\>\"", ",", 
   RowBox[{"AssessmentFunction", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Verdadero\>\"", "->", "True"}], ",", 

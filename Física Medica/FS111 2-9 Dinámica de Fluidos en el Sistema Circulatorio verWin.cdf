Cell[TextData[{
 StyleBox["N\[UAcute]mero de Reynolds (Re):\n\n",
  FontWeight->"Bold"],
 "Es un n\[UAcute]mero adimensional en mec\[AAcute]nica de fluidos que \
predice el comportamiento del flujo, indicando si es laminar (ordenado) o \
turbulento (ca\[OAcute]tico). Se calcula como la relaci\[OAcute]n entre las \
fuerzas de inercia y las fuerzas viscosas en un fluido y depende de su \
velocidad, densidad, viscosidad y una dimensi\[OAcute]n \
caracter\[IAcute]stica."
}], "Text",
 CellChangeTimes->{{3.959783579750093*^9, 3.9597839729425364`*^9}, 
   3.960461468886182*^9, {3.960461593777936*^9, 3.960461725404254*^9}, {
   3.9637921756500626`*^9, 3.963792177301405*^9}, {3.963792334972908*^9, 
   3.9637924264005146`*^9}, 3.9690120237401333`*^9, {3.969012223296133*^9, 
   3.9690122371162148`*^9}, 3.9690123102626114`*^9, {3.969012962482609*^9, 
   3.969012977468567*^9}, {3.9690132210180264`*^9, 3.9690132405780983`*^9}, {
   3.9805174625672894`*^9, 3.980517465968912*^9}, 3.980522845440399*^9},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"160b0881-9684-2a42-8a4f-de04dd0264b1"],


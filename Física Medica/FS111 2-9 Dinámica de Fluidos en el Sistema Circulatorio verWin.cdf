        StyleBox["A", "TI"], "  ", "\[DoubleRightArrow]  ", 
        SubscriptBox[
         StyleBox["v", "TI"], "1"], 
        SubscriptBox[
         StyleBox["A", "TI"], "1"], "\[LongEqual]", 
        SubscriptBox[
         StyleBox["v", "TI"], "2"], 
        SubscriptBox[
         StyleBox["A", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
    "input" -> "Q = v A \\quad\\Rightarrow\\quad v_1 A_1 = v_2 A_2", "state" -> 
    "Boxes"|>,
   "TeXAssistantTemplate"], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.960461766791975*^9, 3.9604617759674253`*^9}, {
  3.9604618456379557`*^9, 3.9604618572890463`*^9}, {3.9637923077759666`*^9, 
  3.9637923112642136`*^9}, {3.9690121369170284`*^9, 3.9690121813283215`*^9}, {
  3.970079469179306*^9, 3.970079469179306*^9}, {3.9805013483480396`*^9, 
  3.980501358318325*^9}},
 TextAlignment->Center,
 FontSize->20,ExpressionUUID->"998ae55b-51e3-f54c-817e-385cf3e14d3d"],

Cell["\<\
Esto explica que, si una arteria se estrecha (disminuye su \[AAcute]rea \
transversal), la velocidad del flujo aumenta para mantener el mismo caudal. 

Este fen\[OAcute]meno es crucial en patolog\[IAcute]as como la estenosis \
arterial.\
\>", "Text",
 CellChangeTimes->{{3.959783579750093*^9, 3.9597839729425364`*^9}, 

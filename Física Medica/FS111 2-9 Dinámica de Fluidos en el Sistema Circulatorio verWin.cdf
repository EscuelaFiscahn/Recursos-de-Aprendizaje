Cell[TextData[{
 StyleBox["Ecuaci\[OAcute]n de Bernoulli:\n",
  FontWeight->"Bold"],
 "\nLa energ\[IAcute]a total del flujo (presi\[OAcute]n + energ\[IAcute]a cin\
\[EAcute]tica + energ\[IAcute]a potencial) se conserva:\t"
}], "Text",
 CellChangeTimes->{{3.959783579750093*^9, 3.9597839729425364`*^9}, 
   3.960461468886182*^9, {3.960461593777936*^9, 3.960461725404254*^9}, {
   3.9637921756500626`*^9, 3.963792177301405*^9}, {3.963792334972908*^9, 
   3.9637924264005146`*^9}, 3.9690120237401333`*^9, {3.969012223296133*^9, 
   3.9690122371162148`*^9}, 3.9690123102626114`*^9, {3.969012962482609*^9, 
   3.969012977468567*^9}, {3.980501165336668*^9, 3.980501165630251*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"1302d0b7-0aa0-4645-9aa2-1fc59132b2a9"],

Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        StyleBox["P", "TI"], "+", 
        FractionBox["1", "2"], "\[Rho]", 
        SuperscriptBox[
         StyleBox["v", "TI"], "2"], "+", "\[Rho]", 
        StyleBox["g", "TI"], 
        StyleBox["h", "TI"], "\[LongEqual]", 
        StyleBox["c", "TI"], 
        StyleBox["o", "TI"], 
        StyleBox["n", "TI"], 
        StyleBox["s", "TI"], 
        StyleBox["t", "TI"], 
        StyleBox["a", "TI"], 
        StyleBox["n", "TI"], 
        StyleBox["t", "TI"], 
        StyleBox["e", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
    "P+\\frac{1}{2}\\rho v^2+\\rho g h= constante", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.960461766791975*^9, 3.9604617759674253`*^9}, {
  3.9604618456379557`*^9, 3.9604618572890463`*^9}, {3.9637923077759666`*^9, 
  3.9637923112642136`*^9}, {3.9690121369170284`*^9, 3.9690121813283215`*^9}, {
  3.969012598285469*^9, 3.969012603643675*^9}, {3.9700794851529236`*^9, 
  3.9700794851589355`*^9}},
 TextAlignment->Center,
 FontSize->20,ExpressionUUID->"20d02deb-7d10-0e42-8bab-ebb8dbfa3eb4"],

Cell["\<\
En zonas donde la velocidad aumenta (por estrechamiento), la presi\[OAcute]n \
disminuye.

Este principio es la base de herramientas diagn\[OAcute]sticas como el \
ecocardiograma Doppler, que detecta diferencias de presi\[OAcute]n y \
velocidad en v\[AAcute]lvulas card\[IAcute]acas o arterias.\
\>", "Text",
 CellChangeTimes->{{3.959783579750093*^9, 3.9597839729425364`*^9}, 
   3.960461468886182*^9, {3.960461593777936*^9, 3.960461725404254*^9}, {
   3.9637921756500626`*^9, 3.963792177301405*^9}, {3.963792334972908*^9, 

   3.9690078833522816`*^9}, {3.9690079174896793`*^9, 
   3.9690079756450233`*^9}, {3.9690081009652805`*^9, 
   3.9690081166350136`*^9}, {3.969011952397148*^9, 3.969011958288391*^9}, {
   3.9805009175555286`*^9, 3.9805010018615665`*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"62fe6346-a2f3-964f-b103-75047882ded1"],

Cell[TextData[{
 StyleBox["Presi\[OAcute]n (P):",
  FontWeight->"Bold"],
 " \n\nFuerza que ejerce la sangre sobre las paredes vasculares, medida en \
mil\[IAcute]metros de mercurio (mmHg)."
}], "Text",
 CellChangeTimes->{{3.959783579750093*^9, 3.9597839729425364`*^9}, 
   3.960461468886182*^9, {3.960461593777936*^9, 3.960461725404254*^9}, {
   3.9637921756500626`*^9, 3.963792177301405*^9}, {3.969007880484579*^9, 
   3.9690078833522816`*^9}, {3.9690079174896793`*^9, 
   3.9690079756450233`*^9}, {3.9690081009652805`*^9, 
   3.9690081166350136`*^9}, {3.969011952397148*^9, 3.969011958288391*^9}, {
   3.9805009175555286`*^9, 3.9805010281305943`*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"b702940a-262b-1540-9134-d9ffc1ab6194"],

Cell[TextData[{
 StyleBox["Resistencia vascular (R):",
  FontWeight->"Bold"],
 " \n\nOposici\[OAcute]n al flujo, dependiente del radio, la viscosidad y la \
longitud del vaso."
}], "Text",
 CellChangeTimes->{{3.959783579750093*^9, 3.9597839729425364`*^9}, 
   3.960461468886182*^9, {3.960461593777936*^9, 3.960461725404254*^9}, {
   3.9637921756500626`*^9, 3.963792177301405*^9}, {3.969007880484579*^9, 
   3.9690078833522816`*^9}, {3.9690079174896793`*^9, 
   3.9690079756450233`*^9}, {3.9690081009652805`*^9, 
   3.9690081166350136`*^9}, {3.969011952397148*^9, 3.969011958288391*^9}, {
   3.9805009175555286`*^9, 3.9805009759822254`*^9}, {3.9805010358695602`*^9, 
   3.980501043323086*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"5840aeb7-8ebc-6a40-91bb-14140aa8f026"],

Cell[TextData[{
 StyleBox["Viscosidad (\[Eta]):",
  FontWeight->"Bold"],
 " \n\nPropiedad interna del fluido que ofrece resistencia al movimiento. En \
sangre, depende del hematocrito y de la temperatura corporal."
}], "Text",
 CellChangeTimes->{{3.959783579750093*^9, 3.9597839729425364`*^9}, 
   3.960461468886182*^9, {3.960461593777936*^9, 3.960461725404254*^9}, {
   3.9637921756500626`*^9, 3.963792177301405*^9}, {3.969007880484579*^9, 
   3.9690078833522816`*^9}, {3.9690079174896793`*^9, 
   3.9690079756450233`*^9}, {3.9690081009652805`*^9, 
   3.9690081166350136`*^9}, {3.969011952397148*^9, 3.969011958288391*^9}, {
   3.9805009175555286`*^9, 3.9805009759822254`*^9}, {3.9805010474542007`*^9, 
   3.980501052818062*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"1d9ae4a7-ab91-d943-ac4a-84dbcb592376"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Principios f\[IAcute]sicos", "Subsection",
 CellChangeTimes->{
  3.970079458179985*^9},ExpressionUUID->"2cfff862-8af2-fb4a-9bd9-\
daa2d527eed2"],

Cell[TextData[{
 StyleBox["Ecuaci\[OAcute]n de continuidad:",
  FontWeight->"Bold"],
 StyleBox["\n",
  FontSize->18,
  FontWeight->"Bold"],
 "\nEn el sistema circulatorio, el volumen de sangre que entra y sale de un \
segmento vascular se conserva:"
}], "Text",
 CellChangeTimes->{{3.959783579750093*^9, 3.9597839729425364`*^9}, 
   3.960461468886182*^9, {3.960461593777936*^9, 3.960461725404254*^9}, {
   3.9637921756500626`*^9, 3.963792177301405*^9}, {3.963792334972908*^9, 
   3.9637924264005146`*^9}, 3.9690120237401333`*^9, {3.980501114078079*^9, 
   3.9805011153574505`*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"50119c44-9fc5-434d-8024-283e9f14cc93"],


           StyleBox["v", "TI"], " ", 
           StyleBox["D", "TI"]}], "\[Eta]"]}], TraditionalForm], 
    "errors" -> {}, "input" -> "Re=\\frac{\\rho \\: v \\: D}{\\eta}", "state" -> 

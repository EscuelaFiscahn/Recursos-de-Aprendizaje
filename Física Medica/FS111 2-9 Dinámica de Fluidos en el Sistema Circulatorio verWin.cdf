Cell[TextData[{
 StyleBox["Ley de Poiseuille:",
  FontWeight->"Bold"],
 "\n\nDescribe el flujo laminar de un fluido viscoso a trav\[EAcute]s de un \
tubo:\t"
}], "Text",
 CellChangeTimes->{{3.959783579750093*^9, 3.9597839729425364`*^9}, 
   3.960461468886182*^9, {3.960461593777936*^9, 3.960461725404254*^9}, {

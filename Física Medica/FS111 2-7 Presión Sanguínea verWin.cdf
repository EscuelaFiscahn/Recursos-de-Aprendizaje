Cell[TextData[{
 "Entonces, la fuerza sobre el fondo del recipiente bajo la columna (o sobre \
la mano) es igual al peso del l\[IAcute]quido que constituye la columna: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["F", "TI"], "\[LongEqual]", 
         StyleBox["m", "TI"], 
         StyleBox["g", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "F=mg", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dfc5d2c7-32e4-2f4c-9905-c6f7944a5b4a"],
 ", la masa de la columna es igual  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "\[LongEqual]", "\[Rho]", 
         StyleBox["V", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "m=\\rho V", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c20caf40-f407-124d-99b5-daaa3fe62d65"],
 ", (Suponemos que el l\[IAcute]quido es incompresible, as\[IAcute] que \.04 ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Rho]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5dbf31ae-d3fd-4148-a78a-28d47664ca21"],
 " es constante). \n\nEl volumen de la columna aislada de l\[IAcute]quido es \
igual ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], "\[LongEqual]", 
         StyleBox["h", "TI"], 
         StyleBox["A", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "V=hA", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6960d4cd-4d42-a84e-ac25-d2b4caf1897e"],
 ". Entonces podemos escribir que:"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.96651223320615*^9, 3.966512360573698*^9}, {
  3.9799052807304*^9, 3.9799052907708282`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"f97bd0ec-2466-104b-8f45-f0b19aceac7e"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["F", "TI"], "\[LongEqual]", 
       StyleBox["m", "TI"], 
       StyleBox["g", "TI"], "\[LongEqual]", "\[Rho]", 
       StyleBox["V", "TI"], 
       StyleBox["g", "TI"], "\[LongEqual]", "\[Rho]", 
       StyleBox["h", "TI"], 
       StyleBox["A", "TI"], 
       StyleBox["g", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
   "F = m g = \\rho  V g = \\rho h A g", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9799053058530674`*^9, 3.9799053264075317`*^9}},
 TextAlignment->Center,ExpressionUUID->"2f4a9da9-a501-1341-a524-c8b540ce3cfe"],

Cell[TextData[{
 "Como la presi\[OAcute]n es ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "\[LongEqual]", 
         StyleBox["F", "TI"], "/", 
         StyleBox["A", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "p=F/A", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3fb95117-8eee-0b4b-8a1b-c33d5dd3a281"],
 ", entonces, la presi\[OAcute]n a una profundidad ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["h", "TI"], TraditionalForm], "errors" -> {}, "input" -> "h", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a304fd75-ffec-ae4d-bd08-f0d004c6e0c2"],
 ", debida al peso de la columna, es:"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9665124289132957`*^9, 3.9665124715300007`*^9}, 
   3.9665125280133324`*^9, {3.9677243295412292`*^9, 3.9677243408471756`*^9}, {

 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["p", "TI"], "\[LongEqual]", 
       FractionBox[
        StyleBox["F", "TI"], 
        StyleBox["A", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
   "p = \\frac {F} {A}", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9659367039877396`*^9, 3.965936727069603*^9}},
 TextAlignment->Center,ExpressionUUID->"7c523c4d-40c0-5043-829c-3073020a5f6d"],

Cell[TextData[{
 "Donde: La fuerza ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["F", "TI"], TraditionalForm], "errors" -> {}, "input" -> "F", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "59c1b86d-3327-3344-a2b9-96b0510d1f50"],
 " es aplicada de manera perpendicular a la superficie, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> "A", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b2495e61-f100-5e47-8b87-8b4c0bee9dd4"],
 " representa el \[AAcute]rea del fluido.\n\nLa unidad SI de presi\[OAcute]n: \
newton sobre metro cuadrado (N/m",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Null]", "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "42c61d3f-4dfb-2f46-a742-7dbee7c213cc"],
 " ) o pascal (Pa). La presi\[OAcute]n es una cantidad escalar (s\[OAcute]lo \
tiene magnitud) aunque la fuerza que la produce sea un vector."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9659367479492626`*^9, 3.9659367676718407`*^9}, {
  3.966511031797516*^9, 3.966511093002819*^9}, {3.967624975553648*^9, 
  3.9676250407816563`*^9}, {3.9799052144160137`*^9, 3.9799052220571613`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"f12969e3-7b10-c34b-8357-f80238731d85"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Presi\[OAcute]n y profundidad", "Subsection",
 CellChangeTimes->{
  3.9700789517136517`*^9},ExpressionUUID->"7c30580b-b921-ff4a-8903-\
c38565294b34"],

Cell[TextData[{
 StyleBox["Relaci\[OAcute]n de la presi\[OAcute]n con la profundidad\n",
  FontWeight->"Bold"],
 "\nLa presi\[OAcute]n aumenta con la profundidad. La forma en que la presi\
\[OAcute]n en un fluido var\[IAcute]a con la profundidad se demuestra \
considerando un recipiente de l\[IAcute]quido en reposo. Imaginemos que \
aislamos una columna rectangular de agua, como se muestra."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.966512083775593*^9, 3.96651210275655*^9}, {
  3.9665121403942432`*^9, 3.966512179149311*^9}, {3.967724147058628*^9, 

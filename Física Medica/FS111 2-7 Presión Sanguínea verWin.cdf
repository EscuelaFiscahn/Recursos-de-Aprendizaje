Cell[TextData[{
 "Para transportar un elemento de fluido (sombreado) desde 1 hasta 2 hay que \
realizar un trabajo (el volumen es constante) dado por: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["W", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["P", "TI"], "1"], "-", 
             SubscriptBox[
              StyleBox["P", "TI"], "2"]}], ")"}], 
         StyleBox["V", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "W=(P_1-P_2)V", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "92fce008-021e-4448-9748-c3e186531bca"],
 ", y En ausencia de rozamiento (fluido perfecto), \[EAcute]ste debe \
transformarse en un aumento de energ\[IAcute]a mec\[AAcute]nica:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["m", "TI"]], "\[LongEqual]", "\[CapitalDelta]", 
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["p", "TI"]], "+", "\[CapitalDelta]", 
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["c", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta E_m=\\Delta E_p+\\Delta E_c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "680bbeff-e6fa-444d-bd11-61d1147af597"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["m", "TI"]], "\[LongEqual]", 
         FractionBox["1", "2"], 
         StyleBox["m", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubsuperscriptBox[
              StyleBox["v", "TI"], "2", "2"], "-", 
             SubsuperscriptBox[
              StyleBox["v", "TI"], "1", "2"]}], ")"}], "+", 
         StyleBox["m", "TI"], 
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["y", "TI"], "2"], "-", 
             SubscriptBox[
              StyleBox["y", "TI"], "1"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Delta E_m = \\frac{1}{2}m(v_2^{2}-v_1^{2})+mg(y_2-y_1)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7f6be7b5-5383-8f4d-8d40-1fca24446ae4"],
 "\nsiendo ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["m", "TI"], TraditionalForm], "errors" -> {}, "input" -> "m ",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4c48ee06-953e-4848-95a1-fa6ec7b4ef32"],
 " la masa del elemento de fluido de densidad ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Rho]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "78cc932b-61c9-2f49-95dc-b7e5382fe53e"],
 " que se puede escribir ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "\[LongEqual]", "\[Rho]", 
         StyleBox["V", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "m=\\rho V", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "557e208a-78c0-7349-a918-77ca1bb0e02f"],
 ".Por tanto: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["W", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["P", "TI"], "1"], "-", 
             SubscriptBox[
              StyleBox["P", "TI"], "2"]}], ")"}], 
         StyleBox["V", "TI"], "\[LongEqual]", 
         FractionBox["1", "2"], "\[Rho]", 
         StyleBox["V", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubsuperscriptBox[
              StyleBox["v", "TI"], "2", "2"], "-", 
             SubsuperscriptBox[
              StyleBox["v", "TI"], "1", "2"]}], ")"}], "+", "\[Rho]", 
         StyleBox["V", "TI"], 
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["y", "TI"], "2"], "-", 
             SubscriptBox[
              StyleBox["y", "TI"], "1"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "W=(P_1-P_2)V=\\frac{1}{2}\\rho V (v_2^{2}-v_1^{2})+\\rho Vg (y_2-y_1)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "745da6c7-5a71-9b4c-85ef-9e65c7f5c122"],
 "\nLuego, entre dos puntos cualesquiera de la misma l\[IAcute]nea de flujo \
de un fluido incompresible perfecto tenemos:"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.968787897519169*^9, 3.968787912615864*^9}, {
   3.968787948298668*^9, 3.9687879586847095`*^9}, {3.9687880430617065`*^9, 
   3.9687880455058117`*^9}, {3.968788127588066*^9, 3.968788191728771*^9}, {
   3.9687882640004406`*^9, 3.968788275284399*^9}, 3.968788426936157*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"edf5cff6-a2ea-7b47-a205-38f198d7ac7b"],

Cell[BoxData[
 RowBox[{" ", 
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], "1"], "+", 
         FractionBox["1", "2"], "\[Rho]", 
         SubsuperscriptBox[
          StyleBox["v", "TI"], "1", "2"], "+", "\[Rho]", 
         StyleBox["g", "TI"], 
         SubscriptBox[
          StyleBox["y", "TI"], "1"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["P", "TI"], "2"], "+", 
         FractionBox["1", "2"], "\[Rho]", 
         SubsuperscriptBox[
          StyleBox["v", "TI"], "2", "2"], "+", "\[Rho]", 
         StyleBox["g", "TI"], 
         SubscriptBox[
          StyleBox["y", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "P_1 + \\frac{1}{2}\\rho v_1^{2}+\\rho g y_1=P_2+\\frac{1}{2}\\rho  \
v_2^{2}+\\rho g y_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"],
   TraditionalForm]}]], "DisplayFormulaNumbered",
 CellChangeTimes->{3.9687884329805794`*^9},
 TextAlignment->Center,ExpressionUUID->"9bbdc6f8-307e-364b-81ea-bebbf59b2fb4"],

Cell["o dicho de otro modo, en cualquier punto", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.9687884608003063`*^9, 3.9799058835598507`*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"035b24f1-fb15-6d47-9c1d-61fa52c503f4"],

Cell[BoxData[
 RowBox[{" ", 
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        StyleBox["P", "TI"], "+", 
        FractionBox["1", "2"], "\[Rho]", 
        SuperscriptBox[
         StyleBox["v", "TI"], "2"], "+", "\[Rho]", 
        StyleBox["g", "TI"], 
        StyleBox["y", "TI"], "\[LongEqual]", 
        StyleBox["c", "TI"], 
        StyleBox["o", "TI"], 
        StyleBox["n", "TI"], 
        StyleBox["s", "TI"], 
        StyleBox["t", "TI"], 
        StyleBox["a", "TI"], 
        StyleBox["n", "TI"], 
        StyleBox["t", "TI"], 
        StyleBox["e", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
    "P+\\frac{1}{2}\\rho v^{2}+\\rho g y =constante", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"]}]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9687883640806713`*^9, 3.9687883726581383`*^9}, {
   3.9687884156436405`*^9, 3.96878841683321*^9}, 3.979905881381317*^9},
 TextAlignment->Center,ExpressionUUID->"a3142560-9daa-3744-9e20-2546073c2e7c"],

Cell["\<\
Esta expresi\[OAcute]n se conoce como ecuaci\[OAcute]n de Bernoulli.

La siguiente expresi\[OAcute]n de la ecuaci\[OAcute]n de Bernoulli es \
especialmente \[UAcute]til para resolver problemas que luego son aplicados en \
la cl\[IAcute]nica: \
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{
  3.9687884608003063`*^9, {3.9799058885043316`*^9, 3.979906004671541*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"a49b15f2-f6ac-144d-8cfa-f9e5997cb613"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{"\[CapitalDelta]", 
       StyleBox["P", "TI"], "+", 
       FractionBox["1", "2"], "\[Rho]", 
       RowBox[{"(", 
         RowBox[{
           SubsuperscriptBox[
            StyleBox["v", "TI"], "2", "2"], "-", 
           SubsuperscriptBox[
            StyleBox["v", "TI"], "1", "2"]}], ")"}], "+", "\[Rho]", 
       StyleBox["g", "TI"], "\[CapitalDelta]", 
       StyleBox["y", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
   "errors" -> {}, "input" -> 
   "\\Delta P + \\frac {1} {2} \\rho  \\left(v_ 2^{2} - v_ 1^{2} \\right) + \
\\rho  g  \\Delta y = 0", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9799060521367035`*^9, 3.979906122535244*^9}},
 TextAlignment->Center,ExpressionUUID->"b8191fd7-5feb-614c-ab0c-7c30a24bc278"],


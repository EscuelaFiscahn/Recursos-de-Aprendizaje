Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox[
      TemplateBox[{
        TemplateBox[{"\"Bernoulli's Theorem\"", "\" \"", 
          ButtonBox[
           PaneSelectorBox[{False -> GraphicsBox[{
                Thickness[0.0588], {
                 FaceForm[{
                   RGBColor[0.996323, 0.45, 0.18], 

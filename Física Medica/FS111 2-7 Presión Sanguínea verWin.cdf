Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["p", "TI"], "\[LongEqual]", "\[Rho]", 
       StyleBox["g", "TI"], 
       StyleBox["h", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
   "p = \\rho gh", "state" -> "Boxes"|>,

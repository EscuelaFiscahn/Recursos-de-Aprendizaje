Cell[TextData[{
 "\[CapitalEAcute]ste es un resultado general para l\[IAcute]quidos \
incompresibles. La presi\[OAcute]n es la misma en todos los puntos de un \
plano horizontal a una profundidad ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["h", "TI"], TraditionalForm], "errors" -> {}, "input" -> "h ",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7ed1a773-ecd5-4b44-9aff-8c6fa27f05e7"],
 " (si ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Rho]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "55333238-92f9-ac4d-bb18-f6b9497409ed"],
 "\.04 y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g ",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9d906df3-8c4d-674c-b5ca-00bf4f10efc4"],
 " son constantes). \n\nLa presi\[OAcute]n a una profundidad ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["h", "TI"], TraditionalForm], "errors" -> {}, "input" -> "h", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7e22aeea-bf7a-a44a-b842-f2ec8f311bac"],
 " para dar una presi\[OAcute]n total de: "
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9665125262895355`*^9, 3.966512583689989*^9}, {
  3.96772436744499*^9, 3.9677243706865234`*^9}, {3.979905411609583*^9, 
  3.9799054121541862`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"64aaacea-597c-4d4a-a210-349f1a6c0ed8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["o", "TI"]], "+", "\[Rho]", 
         StyleBox["g", "TI"], 
         StyleBox["h", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "p=p_o+\\rho gh", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], "    ", 
   RowBox[{"(", 
    RowBox[{
    "l\[IAcute]quido", " ", "incompresible", " ", "de", " ", "densidad", " ", 
     "constante"}], ")"}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.966512590394552*^9, 3.9665125932761116`*^9}, {
  3.9665126258850136`*^9, 3.9665126356381207`*^9}, {3.9677243856442585`*^9, 
  3.967724411873436*^9}},
 TextAlignment->Center,ExpressionUUID->"bfa0d749-15bf-f446-b353-4ee8c316f608"],

Cell[TextData[{
 "donde ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["p", "TI"], 
        StyleBox["o", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "p_o", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e0852b78-faf7-d14e-bd4c-356f889ac5b7"],
 " es la presi\[OAcute]n aplicada a la superficie del l\[IAcute]quido (es \
decir, la presi\[OAcute]n en ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], "\.02", "\[LongEqual]", "0"}], TraditionalForm],
      "errors" -> {}, "input" -> "h \.02=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68f88220-4820-264f-845b-466de6b5f0b6"],
 "). \n\nEn el caso de un recipiente abierto, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["o", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["a", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "p_o=p_a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cc099fce-d818-8e4f-9bf1-ec04b302a7df"],
 " (la presi\[OAcute]n atmosf\[EAcute]rica), es decir, el peso (fuerza) por \
unidad de \[AAcute]rea de los gases atmosf\[EAcute]ricos que est\[AAcute]n \
arriba de la superficie del l\[IAcute]quido. \n\nLa presi\[OAcute]n atmosf\
\[EAcute]rica media en el nivel del mar se utiliza tambi\[EAcute]n como \
unidad, llamada atm\[OAcute]sfera (atm): 1 atm= 101.325 kPa =",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1.01325", "\[Cross]", 
         SuperscriptBox["10", "5"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "1.01325\\times {10}^{5}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7514f910-7c8c-9043-8a67-2de26fbf8730"],
 " Pa."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.966512619419201*^9, 3.9665126251395645`*^9}, {
   3.966512656997509*^9, 3.966512767635418*^9}, {3.9665128148594265`*^9, 
   3.9665128238343964`*^9}, 3.9665158446492996`*^9, 3.967724424552452*^9, {
   3.979905420396267*^9, 3.979905424786396*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"b024a1b7-40aa-0d43-98af-7a042ac2fcea"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Principio de Pascal ", "Subsection",
 CellChangeTimes->{{3.967724578367407*^9, 
  3.9677245818334064`*^9}},ExpressionUUID->"52cd493d-ddc5-3045-8649-\
cc37ae1af00a"],

Cell["\<\
La presi\[OAcute]n aplicada a un fluido encerrado se transmite sin \
p\[EAcute]rdida a todos los puntos del fluido y a las paredes del recipiente.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.967724596072645*^9, 3.9677245998197403`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"a54ec98a-d67f-f240-bda1-2b327be26fb4"],

Cell["\<\
A continuaci\[OAcute]n se muestra un simulador que tiene un conjunto de tubos \
interconectados abiertos en la parte superior, en el cual se vierte agua \
(coloreada en verde) en uno de ellos. \
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.967725518949188*^9, 3.9677255703577175`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"d8bf0075-fe6f-d440-84b8-b7e1c5f0995b"],


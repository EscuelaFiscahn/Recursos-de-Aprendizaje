Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TablaNivelesSonido", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\"\<Ejemplos\>\"", ",", "\"\<Decibeles (dB)\>\"", ",", 
        "\"\<El da\[NTilde]o puede ocurrir con exposici\[OAcute]n \
continua\>\"", ",", "\"\<Tiempo de exposici\[OAcute]n\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<D\[EAcute]bil\>\"", ",", "20", ",", 
        "\"\<Biblioteca tranquila, murmullos\>\"", ",", 
        "\"\<Ilimitado, No hay riesgo alguno\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Moderado\>\"", ",", "50", ",", 
        "\"\<Conversaci\[OAcute]n normal, m\[AAcute]quina de coser\>\"", ",", 
        "\"\<Ilimitado, No hay riesgo alguno\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Muy fuerte\>\"", ",", "70", ",", 
        "\"\<Tr\[AAcute]nsito cargado, restaurante ruidoso, llanto de ni\
\[NTilde]o\>\"", ",", "\"\<10 horas (o m\[AAcute]s)\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Muy fuerte\>\"", ",", "80", ",", 
        "\"\<F\[AAcute]brica promedio\>\"", ",", "\"\<Menos de 8 horas\>\""}],
        "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Muy fuerte\>\"", ",", "90", ",", 
        "\"\<Podadora, motocicleta, fiesta ruidosa\>\"", ",", 
        "\"\<Menos de 8 horas\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Extremadamente fuerte\>\"", ",", "100", ",", 
        "\"\<Taller de maquinaria\>\"", ",", "\"\<Menos de 2 horas\>\""}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Extremadamente fuerte\>\"", ",", "110", ",", 
        "\"\<Sierra de cadena, tren subterr\[AAcute]neo, trineo motorizado, \
Banda de rock con amplificadores\>\"", ",", "\"\<Menos de 30 minutos\>\""}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Extremadamente fuerte\>\"", ",", "140", ",", 
        "\"\<Clubes de baile, autoest\[EAcute]reos, algunos juguetes \
musicales\>\"", ",", "\"\<Menos de 15 minutos\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Doloroso\>\"", ",", "130", ",", 
        "\"\<Martillo perforador, juegos ruidosos de computadora, eventos \
deportivos\>\"", ",", "\"\<Menos de 15 minutos\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Doloroso\>\"", ",", "140", ",", 
        "\"\<Estampido en est\[EAcute]reos, explosi\[OAcute]n de un disparo, \
cohetes\>\"", ",", 
        "\"\<Cualquier duraci\[OAcute]n (p\[EAcute]rdida del o\[IAcute]do \
puede ocurrir)\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Doloroso\>\"", ",", "180", ",", 

  0.94, 0.91, 0.88],ExpressionUUID->"8563eea7-435a-c249-b524-4d004de1c40e"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SubscriptBox[
        StyleBox["I", "TI"], 
        StyleBox["o", "TI"]], "\[LongEqual]", "1", "\[Cross]", 
       SuperscriptBox["10", "-12"], " ", 
       StyleBox["W", "TI"], "/", 
       SuperscriptBox[
        StyleBox["m", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
   "input" -> "I_o = 1 \\times 10^{-12} \\; W/m^2", "state" -> "Boxes"|>,

Cell[TextData[{
 "Las unidades est\[AAcute]ndar de la intensidad (potencia/\[AAcute]rea) son \
watts por metro cuadrado (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["W", "TI"], "/", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "W/m^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "10c8bef9-5c99-b44f-af70-6b20bde496b0"],
 "). \n\nConsidere una fuente puntual que emite ondas esf\[EAcute]ricas de \
sonido. Si no hay p\[EAcute]rdidas, la intensidad del sonido a una distancia ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d2b0c071-1ffb-7b40-81e6-04124cab9d78"],
 " desde la fuente es:"
}], "Text",
 CellChangeTimes->{{3.935515855055318*^9, 3.935515912099792*^9}, {

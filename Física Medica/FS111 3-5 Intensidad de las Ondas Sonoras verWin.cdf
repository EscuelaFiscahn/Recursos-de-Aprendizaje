Cell["\<\
Como podr\[AAcute]n notar entre el umbral del dolor y la audici\[OAcute]n hay \
12 ordenes de magnitud de diferencia (la cual podemos calcular)\
\>", "Text",
 CellChangeTimes->{{3.983968611850252*^9, 3.983968661772192*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"cd412243-942a-0342-bbcb-e4bc51ae30a1"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       FractionBox[
        SubscriptBox[
         StyleBox["I", "TI"], 
         StyleBox["p", "TI"]], 
        SubscriptBox[
         StyleBox["I", "TI"], 
         StyleBox["o", "TI"]]], "\[LongEqual]", 
       FractionBox[
        RowBox[{"1 ", 
          StyleBox["W", "TI"], "/", 
          SuperscriptBox[
           StyleBox["m", "TI"], "2"]}], 
        RowBox[{"1", "\[Cross]", 
          SuperscriptBox["10", "-12"], " ", 
          StyleBox["W", "TI"], "/", 
          SuperscriptBox[
           StyleBox["m", "TI"], "2"]}]], "\[LongEqual]", "1", "\[Cross]", 
       SuperscriptBox["10", "12"]}], TraditionalForm], "errors" -> {}, 
   "input" -> 
   "\\frac{I_p}{I_o} = \\frac{1 \\: W/m^2}{1\\times 10^{-12} \\: W/m^2} = \
1\\times 10^{12}", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{3.983968677389738*^9},
 TextAlignment->Center,ExpressionUUID->"9292fbda-b201-2d42-9729-e292f07a6ec6"],

Cell[TextData[{
 "Lo cual hace complicado realizar cuentas u operaciones con tanta diferencia \
entre estos n\[UAcute]meros. \n\nPor eso se introduce el ",
 StyleBox["nivel de intensidad del sonido relativo ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Beta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\beta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"d2d2be64-8ec1-f942-af57-f199b137c7bc"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9839687717185974`*^9, 3.983968855596052*^9}, {
  3.983968901219431*^9, 3.983968903199419*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"6609a217-3e85-984e-8b76-f49d98933a93"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{"\[Beta]", "\[LongEqual]", "10", "\[Cross]", "log", 
       RowBox[{"(", 
         FractionBox[
          StyleBox["I", "TI"], 
          SubscriptBox[
           StyleBox["I", "TI"], 
           StyleBox["o", "TI"]]], ")"}]}], TraditionalForm], "errors" -> {}, 
   "input" -> "\\beta = 10 \\times \\log \\left(\\frac{I}{I_o} \\right)", 
   "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9839688712933426`*^9, 3.983968873923952*^9}},
 TextAlignment->Center,ExpressionUUID->"f414c55b-0901-784a-a043-8b7e81e24313"],


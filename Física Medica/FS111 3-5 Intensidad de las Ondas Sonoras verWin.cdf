Cell["El umbral de la audici\[OAcute]n es:", "Text",
 CellChangeTimes->{{3.935515855055318*^9, 3.935515912099792*^9}, {
   3.935516954447952*^9, 3.93551699985431*^9}, {3.935519109382757*^9, 
   3.93551913911549*^9}, {3.935522839672781*^9, 3.935522866929489*^9}, {
   3.935523049630577*^9, 3.935523172224823*^9}, {3.935524790818508*^9, 
   3.9355249797609673`*^9}, {3.935525010288503*^9, 3.9355252296034727`*^9}, {
   3.9355257862782793`*^9, 3.935525789935401*^9}, {3.935526237308247*^9, 
   3.935526243723904*^9}, 3.9356666473417077`*^9, {3.935666691713506*^9, 
   3.935666709774708*^9}, {3.9356668983263626`*^9, 3.935666903013552*^9}, {
   3.935667179633544*^9, 3.935667189753909*^9}, {3.935749202585615*^9, 
   3.935749206617687*^9}, {3.935749411112295*^9, 3.935749415706955*^9}, {
   3.935749536559646*^9, 3.9357497326932163`*^9}, 3.936352093656808*^9, {
   3.936352192174505*^9, 3.9363522577481823`*^9}, {3.936353643034759*^9, 
   3.936353662993716*^9}, {3.936353701248124*^9, 3.936353755834744*^9}, {

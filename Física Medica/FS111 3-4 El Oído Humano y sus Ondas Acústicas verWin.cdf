Cell[TextData[{
 "Para estudiar estos fen\[OAcute]menos, se pueden utilizar herramientas del ",
 ButtonBox["Wolfram Language",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/WolframLanguage"],
 " para visualizar y analizar los componentes del o\[IAcute]do humano y las \
caracter\[IAcute]sticas de las ondas sonoras. "
}], "Text",
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"6b6e17cd-a08f-e743-89ad-b708bc825cf7"],

Cell[CellGroupData[{

Cell["An\[AAcute]lisis de Estructuras del O\[IAcute]do", "Subsection",ExpressionUUID->"1609f2c9-e6a0-f344-a2e1-5a03f1b0d178"],

Cell[TextData[{
 "Podemos utilizar la funci\[OAcute]n ",
 ButtonBox["AnatomyData",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/AnatomyData"],
 " para obtener las partes constitutivas del o\[IAcute]do humano y para \
visualizar las partes del o\[IAcute]do, se puede emplear la funci\[OAcute]n ",
 ButtonBox["AnatomyPlot3D",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/AnatomyPlot3D"],
 ": "
}], "Text",
 CellChangeTimes->{{3.9832861505450745`*^9, 3.9832861573662186`*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"5a142dd3-175f-3542-9017-a5aa0e38827e"],


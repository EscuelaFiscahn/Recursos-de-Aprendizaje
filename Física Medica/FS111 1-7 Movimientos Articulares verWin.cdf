        StyleBox["F", "TI"], 
        RowBox[{"2", 
          StyleBox["x", "TI"]}]], "+", 
       SubscriptBox[
        StyleBox["F", "TI"], 
        RowBox[{"3", 
          StyleBox["x", "TI"]}]], "+", "\[Ellipsis]", "\[LongEqual]", "0"}], 
     TraditionalForm], "errors" -> {}, "input" -> 
   "F_{1x}+F_{2x}+F_{3x}+ \\dots =0", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"], "\[IndentingNewLine]", 
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SubscriptBox[
        StyleBox["F", "TI"], 
        RowBox[{"1", 
          StyleBox["y", "TI"]}]], "+", 
       SubscriptBox[
        StyleBox["F", "TI"], 
        RowBox[{"2", 
          StyleBox["y", "TI"]}]], "+", 
       SubscriptBox[
        StyleBox["F", "TI"], 

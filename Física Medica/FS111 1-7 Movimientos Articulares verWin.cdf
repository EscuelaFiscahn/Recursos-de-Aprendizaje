Cell[CellGroupData[{

Cell["Palanca", "Subsection",
 CellChangeTimes->{{3.962188287677763*^9, 
  3.962188288997076*^9}},ExpressionUUID->"4c119af3-8413-a74d-be92-\
794b3430b316"],

Cell[TextData[{
 "Una palanca es en esencia un sistema formado por una barra r\[IAcute]gida \
que puede girar alrededor de un punto fijo, llamado fulcro o punto de pivote. \
 Sobre la palanca act\[UAcute]an dos fuerzas, una fuerza esfuerzo ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["F", "TI"], TraditionalForm], "errors" -> {}, "input" -> "F", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "20259e3a-d5c2-424c-97d0-b3b029c321a3"],
 "  y una fuerza resistente o carga ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2005962b-216a-af44-9fb6-d265c9c23d59"],
 "."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.960370812766657*^9, 3.96037081397278*^9}, {
   3.9603709675768833`*^9, 3.9603709982043705`*^9}, 3.960464353881756*^9, {
   3.962110256624216*^9, 3.9621102632177277`*^9}, 3.9621882915860634`*^9, {
   3.962191746648199*^9, 3.9621918506224537`*^9}, 3.9621919846392403`*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"9e4dde28-b849-1a49-948c-68053844066d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"L", "[", 
    RowBox[{"n", ",", "\[Theta]"}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "\"\<tipo de palanca\>\""}], "}"}], ",", 
     RowBox[{"Range", "[", "3", "]"}], ",", "Setter"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", "0", ",", "\"\<fuerza aplicada\>\""}], "}"}], ",",
      "0", ",", 
     RowBox[{"\[Pi]", "/", "8"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"TrackedSymbols", "\[RuleDelayed]", 
    RowBox[{"{", 
     RowBox[{"n", ",", "\[Theta]"}], "}"}]}], ",", 
   RowBox[{"ControlPlacement", "\[Rule]", "Top"}], ",", 
   RowBox[{"SaveDefinitions", "\[Rule]", "True"}]}], "]"}]], "Input",
 CellOpen->False,
 CellChangeTimes->{{3.9621078295715523`*^9, 3.9621078389985466`*^9}},
 CellLabel->
  "In[108]:=",ExpressionUUID->"60d2f15b-d75a-5644-afa4-bf7be4d77503"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`n$$ = 1, $CellContext`\[Theta]$$ = 0, 
    Typeset`show$$ = True, Typeset`bookmarkList$$ = {}, 
    Typeset`bookmarkMode$$ = "Menu", Typeset`animator$$, Typeset`animvar$$ = 
    1, Typeset`name$$ = "\"sin t\[IAcute]tulo\"", Typeset`specs$$ = {{{
       Hold[$CellContext`n$$], 1, "tipo de palanca"}, {1, 2, 3}, ControlType -> 
      SetterBar}, {{
       Hold[$CellContext`\[Theta]$$], 0, "fuerza aplicada"}, 0, 
      Rational[1, 8] Pi, ControlType -> Manipulator}}, Typeset`size$$ = {
    431.25, {157.22552490234375`, 161.52447509765625`}}, Typeset`update$$ = 0,
     Typeset`initDone$$, Typeset`skipInitDone$$ = False, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`n$$ = 1, $CellContext`\[Theta]$$ = 0}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, 
      "Body" :> $CellContext`L[$CellContext`n$$, $CellContext`\[Theta]$$], 
      "Specifications" :> {{{$CellContext`n$$, 1, "tipo de palanca"}, {1, 2, 
         3}, ControlType -> 
         Setter}, {{$CellContext`\[Theta]$$, 0, "fuerza aplicada"}, 0, 
         Rational[1, 8] Pi}}, 
      "Options" :> {
       TrackedSymbols :> {$CellContext`n$$, $CellContext`\[Theta]$$}, 
        ControlPlacement -> Top}, "DefaultOptions" :> {}],
     ImageSizeCache->{
      466.8750000000001, {197.01388916015696`, 201.31283935546946`}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    Initialization:>({$CellContext`L[1, 
         Pattern[$CellContext`\[Theta], 
          Blank[]]] := Graphics[{
          Rotate[{Gray, 
            Rectangle[{-10, 0}, {10, 1}], Black, 
            
            Polygon[{{6.25, 1}, {6.75, 3.25}, {8.75, 3.25}, {9.25, 1}, {
              6.25, 1}}], Red, 
            Thickness[0.04], 
            Arrowheads[0.12], 
            Arrow[{{-9, 6}, {-9, 1}}]}, $CellContext`\[Theta], {2, 0}], Blue, 
          
          Polygon[{{2, 0}, {0.5, (-1.5) Sqrt[3]}, {3.5, (-1.5) Sqrt[3]}, {2, 
            0}}]}, PlotRange -> {{-12, 12}, {-12, 8}}, 
         ImageSize -> {575, 425}, Epilog -> Inset[
           $CellContext`scissors[$CellContext`\[Theta]], {
           8, -7}]], $CellContext`L[2, 
         Pattern[$CellContext`\[Theta], 
          Blank[]]] := Graphics[{
          Rotate[{Gray, 
            Rectangle[{-10, 0}, {10, 1}], Black, 
            Polygon[{{2.5, 1}, {3, 3.25}, {5, 3.25}, {5.5, 1}, {2.5, 1}}], 
            Red, 
            Thickness[0.04], 
            Arrowheads[0.12], 
            Arrow[{{-9, -5}, {-9, 0}}]}, -$CellContext`\[Theta], {8.5, 0}], 
          Blue, 
          
          Polygon[{{8.5, 0}, {7, (-1.5) Sqrt[3]}, {10, (-1.5) Sqrt[3]}, {
            8.5, 0}}]}, PlotRange -> {{-12, 12}, {-11, 9}}, 
         ImageSize -> {575, 425}, Epilog -> Inset[
           $CellContext`nutcracker[$CellContext`\[Theta]], {
           5, -6}]], $CellContext`L[3, 
         Pattern[$CellContext`\[Theta], 
          Blank[]]] := Graphics[{
          Rotate[{Gray, 
            Rectangle[{-10, 0}, {10, 1}], Black, 
            
            Polygon[{{-6.25, 1}, {-6.75, 3.25}, {-8.75, 
              3.25}, {-9.25, 1}, {-6.25, 1}}], Red, 
            Thickness[0.04], 
            Arrowheads[0.12], 
            Arrow[{{-4, -5}, {-4, 0}}]}, -$CellContext`\[Theta], {8.5, 0}], 
          Blue, 
          
          Polygon[{{8.5, 0}, {7, (-1.5) Sqrt[3]}, {10, (-1.5) Sqrt[3]}, {
            8.5, 0}}]}, PlotRange -> {{-12, 12}, {-10, 10}}, 
         ImageSize -> {575, 425}, Epilog -> Inset[
           $CellContext`bat[$CellContext`\[Theta]], {5, -6}]], $CellContext`L[
         Pattern[$CellContext`n, 
          Blank[]], 
         Pattern[$CellContext`\[Theta], 
          Blank[]]] := 
       Module[{$CellContext`fulcro = {5, 0}, $CellContext`length = 
          
          10, $CellContext`effortPos, $CellContext`loadPos, \
$CellContext`effortDir, $CellContext`loadDir, $CellContext`effortDirRot, \
$CellContext`rotMat}, 
         Print["n = ", $CellContext`n, 
           ", \[Theta] = ", $CellContext`\[Theta]]; 
         Switch[$CellContext`n, 
           1, $CellContext`effortPos = {2, 0}; $CellContext`loadPos = {8, 
             0}; $CellContext`effortDir = {0, 3}; $CellContext`loadDir = {
             0, -3}; Null, 
           2, $CellContext`effortPos = {8, 0}; $CellContext`loadPos = {5, 
             0}; $CellContext`effortDir = {0, 3}; $CellContext`loadDir = {
             0, -3}; Null, 
           3, $CellContext`effortPos = {5, 0}; $CellContext`loadPos = {8, 
             0}; $CellContext`effortDir = {0, 3}; $CellContext`loadDir = {
             0, -3}; Null]; $CellContext`rotMat = {{
             Cos[$CellContext`\[Theta]], -Sin[$CellContext`\[Theta]]}, {
             Sin[$CellContext`\[Theta]], 
             Cos[$CellContext`\[Theta]]}}; $CellContext`effortDirRot = 
          Dot[$CellContext`rotMat, $CellContext`effortDir]; Graphics[{Thick, 
            Line[{{0, 0}, {$CellContext`length, 0}}], Red, 
            
            Polygon[{$CellContext`fulcro + {-0.5, -1}, $CellContext`fulcro, \
$CellContext`fulcro + {0.5, -1}}], Blue, 
            
            Arrow[{$CellContext`effortPos, $CellContext`effortPos + \
$CellContext`effortDirRot}], 
            Text[
             Style[
             "F (Esfuerzo)", Blue, 
              Bold], $CellContext`effortPos + $CellContext`effortDirRot + {
              0.5, 0}], Orange, 
            
            Arrow[{$CellContext`loadPos, $CellContext`loadPos + \
$CellContext`loadDir}], 
            Text[
             Style[
             "R (Carga)", Orange, 
              Bold], $CellContext`loadPos + $CellContext`loadDir + {0.5, 0}], 
            Black, 
            Text[
             Style["Fulcro", Bold], $CellContext`fulcro + {0, -1.5}]}, 
           PlotRange -> {{0, $CellContext`length + 2}, {-5, 5}}, ImageSize -> 
           400]], $CellContext`scissors[
         Pattern[$CellContext`\[Theta], 
          Blank[]]] := Graphics[{
          Rotate[{
            Darker[Gray], 
            Thickness[0.0375], 
            Circle[{-5, 1.5}, {1.5, 1}], 
            Line[{{-5, 0.5}, {-2., 0.5}}], 
            
            Polygon[{{-2, 0.825}, {7, 

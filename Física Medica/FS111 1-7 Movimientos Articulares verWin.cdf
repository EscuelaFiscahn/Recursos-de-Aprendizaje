Cell[TextData[{
 StyleBox["Palanca Clase III",
  FontWeight->"Bold"],
 "\nEn la palanca de tercer g\[EAcute]nero, es la fuerza aplicada (esfuerzo) \
la que se encuentra entre el punto de apoyo o fulcro y la fuerza de \
resistencia."
}], "Text",

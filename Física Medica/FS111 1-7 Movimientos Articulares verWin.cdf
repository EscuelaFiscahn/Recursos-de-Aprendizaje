Cell[CellGroupData[{

Cell[TextData[StyleBox["Momento de fuerza",
 FontWeight->"Bold"]], "Subsection",
 CellChangeTimes->{
  3.962186172227049*^9},ExpressionUUID->"1f807a5c-4f31-484d-8239-\
110289eb259d"],

Cell[TextData[{
 "Se requiere una fuerza para producir un cambio en el movimiento rotacional. \
 La raz\[OAcute]n de cambio del movimiento depende no s\[OAcute]lo de la \
magnitud de la fuerza, sino tambi\[EAcute]n de la distancia perpendicular \
entre su l\[IAcute]nea de acci\[OAcute]n y el eje de rotaci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["r", "TI"], "\[Perpendicular]"], TraditionalForm], 
     "errors" -> {}, "input" -> "r_\\perp", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ee431d73-5146-fe43-8a7e-09f7ea017754"],
 ".\nLa l\[IAcute]nea de acci\[OAcute]n de una fuerza es una l\[IAcute]nea \
imaginaria que pasa por la flecha del vector de fuerza, es decir, la l\
\[IAcute]nea a lo largo de la cual act\[UAcute]a la fuerza.\nEsta distancia \
perpendicular ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["r", "TI"], "\[Perpendicular]"], TraditionalForm], 
     "errors" -> {}, "input" -> "r_\\perp", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4dca0328-9804-474c-9b27-baeb927f24e6"],
 " se llama brazo de palanca o brazo de momento.\nEl producto de la fuerza y \
el brazo de palanca se llama momento de fuerza ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox["\[Tau]", "\[RightVector]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\vec{\\tau}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "27fc174b-168b-324e-9193-fdf108ca2c85"],
 " y su magnitud es:"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9593447765266056`*^9, 3.9593448401419945`*^9}, {
   3.959344881578787*^9, 3.959344900134695*^9}, 3.960370692248539*^9, 
   3.9603711351819534`*^9, {3.9603712118370686`*^9, 3.9603712141269035`*^9}, {
   3.960371246798792*^9, 3.9603712511246777`*^9}, {3.9603713416495914`*^9, 
   3.96037138231209*^9}, {3.9603714385320473`*^9, 3.9603715801272964`*^9}, {
   3.9604624012797413`*^9, 3.960462403861725*^9}, {3.9604631082744217`*^9, 
   3.9604631204896545`*^9}, {3.9604642783358097`*^9, 3.960464284729603*^9}, {
   3.962186167082693*^9, 3.9621861747045765`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"5bab53ed-848f-7e4b-892e-57642b1b8c8f"],

Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{"\[Tau]", "\[LongEqual]", 
        SubscriptBox[
         StyleBox["r", "TI"], "\[Perpendicular]"], 
        StyleBox["F", "TI"], "\[LongEqual]", 
        StyleBox["r", "TI"], 
        StyleBox["F", "TI"], "sin", "\[Theta]"}], TraditionalForm], 
    "errors" -> {}, "input" -> "\\tau=r_\\perp F= rF\\sin \\theta", "state" -> 
    "Boxes"|>,
   "TeXAssistantTemplate"], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.960371585814495*^9, 3.960371593631933*^9}, {
  3.9604638244463367`*^9, 3.9604638244463367`*^9}},
 TextAlignment->Center,ExpressionUUID->"2e1c5bbe-ec28-b54c-bac4-e3196dd3ab66"],

Cell[TextData[{
 "Unidad del SI de momento de fuerza es metro-Newton ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["m", FontSlant -> "Plain"], "\[CenterDot]", 
           StyleBox["N", FontSlant -> "Plain"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(\\mathrm{m} \\cdot \\mathrm{N})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "83fe71bc-6e3e-804c-bcc2-888b53de6c81"],
 "\n\nEscribiremos las unidades de momento de fuerza en orden inverso, m \
\[CenterDot] N, para evitar confusiones; debemos tener presente que el \
momento de fuerza es un concepto independiente del de trabajo y su unidad no \
es el joule."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.960371652216669*^9, 3.9603716695380287`*^9}, {
  3.9603717363361435`*^9, 3.9603717363361435`*^9}, {3.960371906623188*^9, 
  3.96037192794553*^9}, {3.977657811704108*^9, 3.9776578122810783`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"74cc54d1-fbed-c341-a6ef-a96b6dbd836d"],

Cell["\<\
Este simulador muestra el concepto de momento de fuerza el cual es un vector, \
tomando como ejemplo una tuerca al aflojarla o apretarla y ver el momento de \
fuerza ejercido sobre esta.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9604641208601627`*^9, 3.9604642296076393`*^9}, {
  3.977657821809165*^9, 3.977657822170639*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"cf688928-4cd0-314b-a01f-bfa9d51e171e"],


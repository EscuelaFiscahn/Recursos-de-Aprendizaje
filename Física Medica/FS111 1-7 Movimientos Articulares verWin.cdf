Cell["\<\
By Enrique Zeleny (2011), \[OpenCurlyDoubleQuote]Rotation and Translation of \
a Rigid Body\[CloseCurlyDoubleQuote] Wolfram Demonstrations Project. \
demonstrations.wolfram.com/RotationAndTranslationOfARigidBody/\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9604635052358685`*^9, 3.9604635106154137`*^9}, {
   3.960463555462597*^9, 3.960463610997181*^9}, 3.965932702547367*^9, {
   3.9776577589327497`*^9, 3.977657766778352*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"df0e39b4-3b15-4f47-94c4-ae46a003e383"],

Cell[TextData[{
 StyleBox["Actividades de aprendizaje\n",
  FontWeight->"Bold"],
 "\n",
 StyleBox["Actividad 1",
  FontWeight->"Bold"],
 "\n\nObjetivo: Observar c\[OAcute]mo cambia la posici\[OAcute]n del objeto y \
su orientaci\[OAcute]n al variar solamente la velocidad angular.\n\
Instrucciones:\n1) Utiliza como valor fijo para la velocidad horizontal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["x", "TI"]], "\[LongEqual]", "6.25"}], TraditionalForm], 
     "errors" -> {}, "input" -> "v_x=6.25", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "123e0b60-67b9-0c4a-9d1d-a31ea2eb4f0a"],
 "  m/s.  Y para el tiempo utiliza ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["t", "TI"], "\[LongEqual]", "3.2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "t=3.2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e43a548-d208-ad43-92d6-00906a1657b8"],
 " s.\n2) Ahora mueve el control deslizante para la velocidad angular ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Omega]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\omega", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "26ff12d5-f13d-744a-86e6-91ff7e975f0c"],
 " desde -2 rad/s hasta 2 rad/s."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{
  3.96218455748184*^9, {3.977657791792836*^9, 3.9776577928829*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"50b4edd4-213b-ce43-a58f-6261bdf09848"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuestionObject", "[", 
  RowBox[{
   RowBox[{"QuestionInterface", "[", 
    RowBox[{"\"\<MultipleChoice\>\"", ",", 
     RowBox[{"\[LeftAssociation]", 
      RowBox[{
      "\"\<Prompt\>\"", "\[Rule]", 
       "\"\<\[DownQuestion]En qu\[EAcute] sentido gira el objeto si \[Omega] \
es negativo? \[DownQuestion]Y si es positivo?\>\""}], 
      "\[RightAssociation]"}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AssessmentFunction", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
       "\"\<Gira en sentido horario si \[Omega] es positivo y antihorario si \
es negativo\>\"", "\[Rule]", 
        RowBox[{"\[LeftAssociation]", 
         RowBox[{"\"\<Score\>\"", "\[Rule]", "0"}], "\[RightAssociation]"}]}],
        ",", 
       RowBox[{
       "\"\<Gira en sentido antihorario si \[Omega] es positivo y horario si \
es negativo\>\"", "\[Rule]", 
        RowBox[{"\[LeftAssociation]", 
         RowBox[{"\"\<Score\>\"", "\[Rule]", "1"}], "\[RightAssociation]"}]}],
        ",", 
       RowBox[{"\"\<No gira en ning\[UAcute]n caso\>\"", "\[Rule]", 
        RowBox[{"\[LeftAssociation]", 
         RowBox[{"\"\<Score\>\"", "\[Rule]", "0"}], 
         "\[RightAssociation]"}]}]}], "}"}], ",", "\"\<String\>\""}], "]"}], 
   ",", "\[IndentingNewLine]", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = True}, 
     TemplateBox[{"Expression", 
       RowBox[{
         DynamicBox[
          FEPrivate`FrontEndResource["FEBitmaps", "IconizeEllipsis"]], 
         "\[Rule]", 
         DynamicBox[
          FEPrivate`FrontEndResource["FEBitmaps", "IconizeEllipsis"]]}], 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Rule", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["680", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    MetaInformation -> <|
     "Label" -> "Optional question label", "Keywords" -> {}, "Difficulty" -> 
      2|>,
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellOpen->False,
 CellLabel->"In[24]:=",ExpressionUUID->"8a9282a4-5dc8-3d46-81ca-1c8b7364e535"],

Cell[BoxData[
 InterpretationBox[
  DynamicModuleBox[{QuestionFramework`Private`input$$ = "", 
   QuestionFramework`Private`result$$ = "", 
   QuestionFramework`Private`buttonenabled$$ = True, 
   QuestionFramework`Private`submissionCount$$ = 0, 
   QuestionFramework`Private`submittedvalue$$ = "", 
   QuestionFramework`Private`explanationstate$$ = False, 
   QuestionFramework`Private`explanationrow$$ = Nothing, 
   QuestionFramework`Private`i$$, 
   QuestionFramework`Private`questionnotebookflag$$ = False, 
   QuestionFramework`Private`qmflag$$ = False, 
   QuestionFramework`Private`ch$$ = {
   "Gira en sentido horario si \[Omega] es positivo y antihorario si es \
negativo" -> 
    "Gira en sentido horario si \[Omega] es positivo y antihorario si es \
negativo", 
    "Gira en sentido antihorario si \[Omega] es positivo y horario si es \
negativo" -> 
    "Gira en sentido antihorario si \[Omega] es positivo y horario si es \
negativo", "No gira en ning\[UAcute]n caso" -> 
    "No gira en ning\[UAcute]n caso"}, QuestionFramework`Private`qid$$}, 
   DynamicBox[ToBoxes[
    QuestionFramework`Private`$QuestionSubmissionContent[
      QuestionFramework`Private`input$$, 
       Hold[
        QuestionFramework`Private`postProcessAssessment[
         AssessmentFunction[{
          "Gira en sentido horario si \[Omega] es positivo y antihorario si \
es negativo" -> <|"Score" -> 0|>, 
           "Gira en sentido antihorario si \[Omega] es positivo y horario si \
es negativo" -> <|"Score" -> 1|>, 
           "No gira en ning\[UAcute]n caso" -> <|"Score" -> 0|>}, <|
          "ListAssessment" -> "WholeList", "ComparisonMethod" -> "String"|>, 
          "Validated" -> True][
         QuestionFramework`Private`input$$, "SubmissionCount" -> 

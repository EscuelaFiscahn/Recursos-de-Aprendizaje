Cell["\<\
Suponga que el centro de gravedad del antebrazo se encuentra a 13 cm de la \
articulaci\[OAcute]n del codo, que el peso sostenido por la mano est\[AAcute] \
a 35 cm de dicha articulaci\[OAcute]n y que la fuerza ejercida por los m\
\[UAcute]sculos flexores del codo act\[UAcute]a a 4 cm de la articulaci\
\[OAcute]n.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9659310198068867`*^9, 3.965931238270685*^9}, 
   3.9659313019768963`*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"dfa4bf60-b5da-2141-be6f-50bc61bdddbc"],

Cell[TextData[{
 "La condici\[OAcute]n de equilibrio es:\nAplicando la condici\[OAcute]n de \
equilibrio, la fuerza impulsora ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["F", "TI"], TraditionalForm], "errors" -> {}, "input" -> "F ",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b4f6b9e-bf95-b240-b659-874d11ee5505"],
 " se puede calcular:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["d", "TI"], "1"], 
         StyleBox["F", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["d", "TI"], "2"], 
         SubscriptBox[
          StyleBox["R", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["d", "TI"], "3"], 
         SubscriptBox[
          StyleBox["R", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "d_1 F=d_2R_1+d_3R_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c24986f0-8d1b-144b-b36a-1c237f01a9be"],
 " \n\nDespejando para ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["F", "TI"], TraditionalForm], "errors" -> {}, "input" -> "F", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d7b4a3a-dd37-9946-9799-0892ca4e125f"],
 " , tenemos: \n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["F", "TI"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SubscriptBox[
             StyleBox["d", "TI"], "2"], 
            SubscriptBox[
             StyleBox["R", "TI"], "1"], "+", 
            SubscriptBox[
             StyleBox["d", "TI"], "3"], 
            SubscriptBox[
             StyleBox["R", "TI"], "2"]}], 
          SubscriptBox[
           StyleBox["d", "TI"], "1"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "F=\\frac{d_2 R_1 + d_3R_2}{d_1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8a070184-2152-3e46-9f1c-2baf90315a76"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.965931333228874*^9},
 TextAlignment->Center,
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"0474ca6d-f596-6e4e-a912-42c7f43144d1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"d1", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d2", "=", "35"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d3", "=", "13"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"F3", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"d2", "*", "R1"}], "+", 
     RowBox[{"d3", "*", "R2"}]}], ")"}], "/", "d1"}]}]}], "Input",
 CellChangeTimes->{{3.965931370512821*^9, 3.965931373559719*^9}, {
  3.9659314608659554`*^9, 3.9659315414040127`*^9}},
 CellLabel->
  "In[136]:=",ExpressionUUID->"cb43aa7e-1c4e-4d4a-8472-05d192f4c4b3"],

Cell[BoxData["321.2775`"], "Output",
 CellChangeTimes->{3.9659315435298233`*^9, 3.977665664464172*^9},
 CellLabel->
  "Out[139]=",ExpressionUUID->"d68179fa-dcf0-4a38-af78-85730814bd6e"]
}, Open  ]],

Cell["\<\
Entonces los m\[UAcute]sculos deben ejercer de aproximadamente 321 N. La \
fuerza de reacci\[OAcute]n sobre la articulaci\[OAcute]n del codo es: \
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.965931560572151*^9, 3.965931602705715*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"1972417e-ad59-0c44-84e8-681e245844c6"],


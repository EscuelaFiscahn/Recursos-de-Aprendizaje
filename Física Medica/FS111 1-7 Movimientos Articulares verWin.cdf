Cell[TextData[{
 "No siempre se produce aceleraci\[OAcute]n rotacional cuando una fuerza act\
\[UAcute]a sobre un cuerpo r\[IAcute]gido estacionario. En la \
ecuaci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", "1", ")"}], TraditionalForm], "errors" -> {}, "input" -> 
     "(1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e536cf3a-6d3c-9043-8cad-115f492b225b"],
 " vemos que, cuando la fuerza act\[UAcute]a a trav\[EAcute]s del eje de \
rotaci\[OAcute]n tal que \.05 \.02 ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Theta]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\theta=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "212c89c9-38c2-ee45-a3bf-51603d2df865"],
 ", entonces \.08 \.02",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Tau]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\tau=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b7f891ab-4343-224d-a411-8ed409a06d9e"],
 ".\nTambi\[EAcute]n, cuando ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Theta]", "\[LongEqual]", "90"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\theta=90", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d7d14073-ecad-5f40-b3af-73db8d84d84f"],
 ", el momento de fuerza es m\[AAcute]ximo y la fuerza act\[UAcute]a \
perpendicularmente a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "r.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cd3dd610-3184-ab4f-a135-3a6e4537fa5d"],
 "\nPor lo tanto, la aceleraci\[OAcute]n angular depende de d\[OAcute]nde se \
aplique una fuerza perpendicular (y, por ende, de la longitud del brazo de \
palanca)."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.960467791830309*^9, 3.9604679073038425`*^9}, 
   3.9606643401805573`*^9, 3.9615882711904926`*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"487f600b-a12b-2a4b-8f1a-496004060821"],

Cell["\<\
El momento de fuerza es un vector. Su direcci\[OAcute]n siempre es \
perpendicular al plano que forman los vectores de fuerza y de brazo de \
palanca, y est\[AAcute] dada por una regla de la mano derecha.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9604680058952503`*^9, 3.960468014551861*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"a6817064-1262-c14f-808d-e8a45b8d85b3"],

Cell["Realicemos el c\[AAcute]lculo de la magnitud de momentos de fuerza:", \
"Text",
 CellChangeTimes->{{3.962204808228239*^9, 
  3.9622048551411*^9}},ExpressionUUID->"1c59b522-e087-cf4b-8a69-c8136bfdc706"],


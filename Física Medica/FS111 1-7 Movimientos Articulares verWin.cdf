   3.962208795903946*^9, 3.9622088247980804`*^9}, {3.962208861122156*^9, 
   3.962208861122156*^9}, {3.962209096682934*^9, 3.9622090966837864`*^9}, 
   3.965928475432619*^9, {3.9659288168006344`*^9, 3.9659288419425697`*^9}, {
   3.965929764521248*^9, 3.9659297881068516`*^9}, {3.9659304601392727`*^9, 

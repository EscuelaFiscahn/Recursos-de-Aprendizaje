  "ed84d5b5-7dc9-c14c-9490-2e8b9e2de285"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Tau]", 
          RowBox[{"1", 
            StyleBox["x", "TI"]}]], "+", 
         SubscriptBox["\[Tau]", 
          RowBox[{"2", 
            StyleBox["x", "TI"]}]], "+", 
         SubscriptBox["\[Tau]", 
          RowBox[{"3", 
            StyleBox["x", "TI"]}]], "+", "\[Ellipsis]", "\[LongEqual]", "0"}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "\\tau_{1x}+\\tau_{2x}+\\tau_{3x}+\\ldots=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0541f63e-00e6-454c-9c85-71bcb2a217d3"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Tau]", 
          RowBox[{"1", 
            StyleBox["y", "TI"]}]], "+", 
         SubscriptBox["\[Tau]", 
          RowBox[{"2", 
            StyleBox["y", "TI"]}]], "+", 
         SubscriptBox["\[Tau]", 
          RowBox[{"3", 
            StyleBox["y", "TI"]}]], "+", "\[Ellipsis]", "\[LongEqual]", "0"}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "\\tau_{1y}+\\tau_{2y}+\\tau_{3y}+\\ldots=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "718a0fc4-c07f-1a4c-9a7d-e019d61310c9"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Tau]", 
          RowBox[{"1", 
            StyleBox["z", "TI"]}]], "+", 
         SubscriptBox["\[Tau]", 
          RowBox[{"2", 
            StyleBox["z", "TI"]}]], "+", 
         SubscriptBox["\[Tau]", 
          RowBox[{"3", 
            StyleBox["z", "TI"]}]], "+", "\[Ellipsis]", "\[LongEqual]", "0"}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "\\tau_{1z}+\\tau_{2z}+\\tau_{3z}+\\ldots=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "baadc119-9aac-6b4d-a5c0-db86a5fdb384"]
}], "Text",
 CellChangeTimes->{
  3.9621892279379387`*^9, {3.9621893040467796`*^9, 3.962189364071724*^9}, {
   3.962189418016039*^9, 3.962189448839897*^9}},
 TextAlignment->Center,ExpressionUUID->"b4f863eb-8434-e441-8b32-eeb816293736"],

Cell[TextData[{
 "Si las fuerzas se encuentran en el mismo plano ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], 
         StyleBox["y", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "xy", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0c9f5a22-142b-6745-87dc-54c7a429d312"],
 " la condici\[OAcute]n de equilibrio sobre la componente ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["z", "TI"], TraditionalForm], "errors" -> {}, "input" -> "z", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "72c25984-8c57-b841-af1e-f4deac0607b4"],
 " ser\[IAcute]a cero  y los momento de fuerza son todos perpendiculares al \
plano, por lo que solo se debe considerar la condici\[OAcute]n sobre la \
componente ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["z", "TI"], TraditionalForm], "errors" -> {}, "input" -> "z", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5bb90a3b-f8b6-274f-9bdf-d7dfca08b0dd"],
 ". Por lo tanto, las seis condiciones de equilibrio mencionadas \
anteriormente se reducen a tres:"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.962190322243391*^9, 3.9621904879692135`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"afc43047-2fbc-9e43-9f76-03ba2e830453"],

Cell[BoxData[{
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SubscriptBox[
        StyleBox["F", "TI"], 
        RowBox[{"1", 
          StyleBox["x", "TI"]}]], "+", 

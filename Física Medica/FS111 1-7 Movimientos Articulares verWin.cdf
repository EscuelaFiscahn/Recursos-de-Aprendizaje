Cell[CellGroupData[{

Cell["Equilibrio", "Subsection",
 CellChangeTimes->{{3.9621881622926426`*^9, 
  3.962188164231926*^9}},ExpressionUUID->"31b9b6b7-8f68-654c-ba44-\
a18a95a65e5a"],

Cell["\<\
El equilibrio significa que las cosas est\[AAcute]n balanceadas o son \
estables. Esta definici\[OAcute]n se aplica en el sentido mec\[AAcute]nico a \
las fuerzas y momentos de fuerza. Las fuer-
zas no equilibradas producen aceleraciones traslacionales; pero las fuerzas \
equilibradas producen la condici\[OAcute]n que llamamos equilibrio \
traslacional. Asimismo, momentos de fuerza no equilibrados producen \
aceleraciones rotacionales; en tanto que momentos de fuerza equilibrados \
producen equilibrio rotacional.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.962103484591755*^9, 3.962103502772917*^9}, {
  3.9621881673630104`*^9, 3.9621881684501877`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"c39285a9-782a-264e-85ff-c7d209b65feb"],

Cell["\<\
 Se dice que un cuerpo est\[AAcute] en equilibrio mec\[AAcute]nico si se \
satisfacen las condiciones tanto para equilibrio traslacional como para el \
equilibrio rotacional:\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.962190769497324*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"15996286-51ef-8841-bae7-b95efc46ddcd"],

Cell[BoxData[{
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["F", "TI"], "\[RightVector]"], 
         RowBox[{
           StyleBox["n", "TI"], 
           StyleBox["e", "TI"], 
           StyleBox["t", "TI"], 
           StyleBox["a", "TI"]}]], "\[LongEqual]", "0"}], TraditionalForm], 
    "errors" -> {}, "input" -> "\\vec{F}_{neta}=0", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], TraditionalForm], "\n", 
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         OverscriptBox["\[Tau]", "\[RightVector]"], 
         RowBox[{
           StyleBox["n", "TI"], 
           StyleBox["e", "TI"], 
           StyleBox["t", "TI"], 
           StyleBox["o", "TI"]}]], "\[LongEqual]", "0"}], TraditionalForm], 
    "errors" -> {}, "input" -> "\\vec{\\tau}_{neto}=0", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], TraditionalForm]}], "DisplayFormulaNumbered",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9621035281629047`*^9, 3.9621035325733643`*^9}, {
  3.962103572424654*^9, 3.962103573427143*^9}, {3.9621036339598713`*^9, 
  3.962103650297268*^9}, {3.9621036869925213`*^9, 3.962103712105171*^9}, {
  3.9621907615426254`*^9, 3.9621907861067085`*^9}},
 TextAlignment->Center,
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"ec8a2836-f4db-3843-b55a-5281933a23e5"],

Cell["\<\
Estas dos condiciones vectoriales pueden escribirse como seis condiciones \
escalares, una para cada componente coordenada de los vectores; estas seis \
condiciones deben cumplirse al mismo tiempo para lograr el equilibrio.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.962188711335472*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"6426cbfe-6e27-424a-abcf-a2e20b978ae9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["F", "TI"], 
          RowBox[{"1", 
            StyleBox["x", "TI"]}]], "+", 
         SubscriptBox[
          StyleBox["F", "TI"], 
          RowBox[{"2", 
            StyleBox["x", "TI"]}]], "+", 
         SubscriptBox[
          StyleBox["F", "TI"], 
          RowBox[{"3", 
            StyleBox["x", "TI"]}]], "+", "\[Ellipsis]", "\[LongEqual]", "0"}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "F_{1x}+F_{2x}+F_{3x}+ \\dots =0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8ac6efee-f176-3249-830b-f439e08489dd"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["F", "TI"], 
          RowBox[{"1", 
            StyleBox["y", "TI"]}]], "+", 
         SubscriptBox[
          StyleBox["F", "TI"], 
          RowBox[{"2", 
            StyleBox["y", "TI"]}]], "+", 
         SubscriptBox[
          StyleBox["F", "TI"], 
          RowBox[{"3", 
            StyleBox["y", "TI"]}]], "+", "\[Ellipsis]", "\[LongEqual]", "0"}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "F_{1y}+F_{2y}+F_{3y}+\\ldots =0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fce53b5f-d7fe-0044-821b-68145d9697c8"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["F", "TI"], 
          RowBox[{"1", 
            StyleBox["z", "TI"]}]], "+", 
         SubscriptBox[
          StyleBox["F", "TI"], 
          RowBox[{"2", 
            StyleBox["z", "TI"]}]], "+", 
         SubscriptBox[
          StyleBox["F", "TI"], 
          RowBox[{"3", 
            StyleBox["z", "TI"]}]], "+", "\[Ellipsis]", "\[LongEqual]", "0"}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "F_{1z}+F_{2z}+F_{3z}+\\ldots =0", "state" -> "Boxes"|>,

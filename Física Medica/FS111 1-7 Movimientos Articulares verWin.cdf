 CellLabel->
  "Out[121]=",ExpressionUUID->"eaea55bc-70db-4388-aabf-7fe723fa638d"]
}, Open  ]],

Cell[TextData[{
 "Aplicando la condici\[OAcute]n de equilibrio, la fuerza impulsora ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["F", "TI"], TraditionalForm], "errors" -> {}, "input" -> "F ",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "29bcf23d-a38f-5145-ba22-132fa41949cd"],
 " se puede calcular:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["d", "TI"], "1"], 
         StyleBox["F", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["d", "TI"], "2"], 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "d_1 F=d_2R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "87e236bd-0f7c-3548-bf39-cfaa0be74add"],
 " \n\nDespejando para ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["F", "TI"], TraditionalForm], "errors" -> {}, "input" -> "F", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3142e303-d1f2-0445-ad89-f1b3f42d67d1"],
 " , tenemos: \n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["F", "TI"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SubscriptBox[
             StyleBox["d", "TI"], "2"], 
            StyleBox["R", "TI"]}], 
          SubscriptBox[
           StyleBox["d", "TI"], "1"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "F=\\frac{d_2 R}{d_1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d0b3f6bf-f6f4-c143-8742-c2e0750351b8"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9659272855532475`*^9, 3.9659272912343273`*^9}, {
  3.9659273338343163`*^9, 3.965927339622259*^9}, {3.9659275292073097`*^9, 
  3.965927579676832*^9}},
 TextAlignment->Center,
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"bc44832e-162e-0540-8909-d7e70aec61ac"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"d1", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d2", "=", "8"}], ";"}]}], "Input",
 CellChangeTimes->{{3.965927811239395*^9, 3.965927825361723*^9}},
 CellLabel->
  "In[122]:=",ExpressionUUID->"5c4a4627-7012-3948-9c80-db2014f6629d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"F", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"d2", "*", "R"}], ")"}], "/", "d1"}]}]], "Input",
 CellChangeTimes->{{3.9659277795835648`*^9, 3.9659277810785046`*^9}, {
   3.9659282346081066`*^9, 3.965928239219887*^9}, {3.965928275326206*^9, 
   3.9659282760987873`*^9}, 3.965928336735157*^9},
 CellLabel->
  "In[124]:=",ExpressionUUID->"b93694b3-8258-0549-9476-ad6d28ad4f0d"],

Cell[BoxData["313.92`"], "Output",
 CellChangeTimes->{
  3.9659277825664043`*^9, 3.965927832027775*^9, 3.965928241094393*^9, {
   3.965928276837309*^9, 3.965928292756159*^9}, 3.9659283382594833`*^9, 
   3.97766566442583*^9},
 CellLabel->
  "Out[124]=",ExpressionUUID->"4c16bdc9-db32-4c63-b643-ed971530e266"]
}, Open  ]],

Cell[TextData[{
 "Entonces los m\[UAcute]sculos deben ejercer una gran fuerza de \
aproximadamente 315 N para mantener la cabeza en posici\[OAcute]n vertical. \
La fuerza de reacci\[OAcute]n sobre las v\[EAcute]rtebras es ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["F", "TI"], "+", 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "F +R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bcac6976-5ed8-454e-b7de-dc570e371a3b"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.96592783899489*^9, 3.96592787183337*^9}, {
  3.9659279842120934`*^9, 3.9659280222693577`*^9}, {3.96592805917568*^9, 
  3.9659280601455326`*^9}, {3.9659281968949833`*^9, 3.965928199964737*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"b72f49c4-3e9e-ab44-b83a-5e03182e02e3"],


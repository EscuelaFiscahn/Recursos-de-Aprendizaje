Cell[TextData[{
 "Las ondas peri\[OAcute]dicas de cualquier tipo se caracterizan por par\
\[AAcute]metros f\[IAcute]sicos como su amplitud (altura), longitud de onda \
(distancia entre crestas), frecuencia (oscilaciones por segundo), velocidad \
entre otros, transmiten energ\[IAcute]a sin mover materia y presentan fen\
\[OAcute]menos como reflexi\[OAcute]n o refracci\[OAcute]n.\n\nA continuaci\
\[OAcute]n definiremos y describiremos estas diversas magnitudes \
f\[IAcute]sicas\n\n1. La amplitud (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> "A", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1c96f960-46f3-e84e-8a43-92c8dfe9775a"],
 ") [1] de una onda es la magnitud del desplazamiento m\[AAcute]ximo, es \
decir, la distancia m\[AAcute]xima respecto a la posici\[OAcute]n de \
equilibrio de la part\[IAcute]cula. Esta cantidad corresponde a la altura de \
una cresta de la onda o la profundidad de un valle. Asimismo, la energ\
\[IAcute]a transportada por una onda es proporcional al cuadrado de su \
amplitud (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["A", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "E=A^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b8b29940-4819-294a-ad44-1f1b407942a9"],
 "). "
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.950793806933075*^9, 3.9507938781776466`*^9}, {
   3.9507940031881733`*^9, 3.9507942454121456`*^9}, {3.9507942798606033`*^9, 
   3.950794287700882*^9}, 3.970739912035284*^9, {3.978177615868368*^9, 
   3.9781776290069313`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"0434b41a-40c2-3146-aa5f-865ab9898cd2"],


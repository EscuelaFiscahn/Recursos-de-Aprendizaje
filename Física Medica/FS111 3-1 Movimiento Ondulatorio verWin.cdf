Cell[TextData[{
 StyleBox["PREGUNTA DE AN\[CapitalAAcute]LISIS\[LineSeparator]",
  FontWeight->"Bold"],
 StyleBox["Re\[UAcute]nase en parejas y discuta la siguiente pregunta:\
\[LineSeparator]",
  FontSlant->"Italic"],
 "\nObserve las representaciones gr\[AAcute]ficas anteriores de las ondas. \
Identifique las crestas y los valles en cada una de las ondas y analice c\
\[OAcute]mo estos puntos se relacionan con la amplitud de la onda. \
\[DownQuestion]Qu\[EAcute] diferencias o similitudes observan en las crestas \
y los valles de diferentes tipos de ondas (por ejemplo, ondas transversales \
vs. longitudinales)?"
}], "Text",
 CellChangeTimes->{{3.9385186035409393`*^9, 3.938518701045223*^9}, {
   3.938518732492258*^9, 3.9385187331813498`*^9}, {3.938518814187855*^9, 

Cell["Caracter\[IAcute]sticas de las ondas", "Subsection",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9781787063519115`*^9, 
  3.978178725980177*^9}},ExpressionUUID->"eb370e04-c205-8d41-800c-\
d13018e29d55"],

Cell[TextData[{
 "La amplitud (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> "A", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f06a8161-ffed-a047-ad10-81f4a4a6c863"],
 ") de una onda es la magnitud del desplazamiento m\[AAcute]ximo, es decir, \
la distancia m\[AAcute]xima respecto a la posici\[OAcute]n de equilibrio de \
la part\[IAcute]cula. Esta cantidad corresponde a la altura de una cresta de \
la onda o la profundidad de un valle. Asimismo, la energ\[IAcute]a \
transportada por una onda es proporcional al cuadrado de su amplitud (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["A", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "E=A^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7b171e58-c39f-c24a-95a4-0bc4c7303144"],
 "). "
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9382489085224648`*^9, 3.938248927052606*^9}, {
   3.939293918461484*^9, 3.93929392926578*^9}, {3.9507944003703003`*^9, 
   3.9507944736954365`*^9}, 3.970739912035943*^9, 3.9781787530523434`*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"28583c10-efcf-ef40-8cbc-ce2198d59b69"],


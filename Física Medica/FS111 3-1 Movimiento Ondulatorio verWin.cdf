Cell[TextData[{
 StyleBox["PREGUNTA DE AN\[CapitalAAcute]LISIS\[LineSeparator]",
  FontWeight->"Bold"],
 StyleBox["Re\[UAcute]nase en parejas y discuta la siguiente pregunta:\n\n",
  FontSlant->"Italic"],
 "\[DownQuestion]c\[OAcute]mo ser\[IAcute]a el movimiento de las \
part\[IAcute]culas de la figura anterior si la onda se desplazara hacia la \
izquierda? "
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9385186035409393`*^9, 3.938518701045223*^9}, {
   3.938518732492258*^9, 3.9385187331813498`*^9}, {3.938518814187855*^9, 
   3.938518819948691*^9}, {3.938519960228487*^9, 3.938519968504284*^9}, 
   3.938530727756208*^9, 3.9392951531412277`*^9, 3.970739912043667*^9, 
   3.9781913252595806`*^9},
 Background->GrayLevel[
  0.85],ExpressionUUID->"4fca6a34-fcff-cc4b-88a6-36044ab56739"],

Cell[TextData[{
 "La frecuencia (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["f", "TI"], TraditionalForm], "errors" -> {}, "input" -> "f", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1e26280e-68c4-654f-993f-c886b7810ba4"],
 ") de una onda peri\[OAcute]dica es el n\[UAcute]mero de ciclos por segundo; \
esto es, el n\[UAcute]mero de formas de onda completas, o longitudes de onda, \
que pasan por un punto dado durante cada segundo.  Esta es medida en el SI en \
unidades de Hertz, que se abrevia como Hz. "
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9382489085224648`*^9, 3.938248927052606*^9}, {
   3.939293918461484*^9, 3.93929392926578*^9}, {3.9507944003703003`*^9, 
   3.9507944736954365`*^9}, 3.970739912035943*^9, 3.9781787530523434`*^9, {
   3.9781913453194923`*^9, 3.9781913779811764`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"61b326b0-edb1-c049-be53-d6eba0efa2a9"],

Cell[TextData[{
 "El periodo (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "T)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e97921f9-a67a-5e49-b76f-6a56c205d824"],
 " es el tiempo que tarda una forma de onda completa (una longitud de onda) \
en pasar por un punto dado. "
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9382489085224648`*^9, 3.938248927052606*^9}, {
   3.939293918461484*^9, 3.93929392926578*^9}, {3.9507944003703003`*^9, 
   3.9507944736954365`*^9}, 3.970739912035943*^9, 3.9781787530523434`*^9, {
   3.9781913453194923`*^9, 3.978191386969303*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"45d7d193-295e-0249-afbb-1f130099b8f6"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["T", "TI"], "\[LongEqual]", 
       FractionBox["1", 
        StyleBox["f", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
   "T = \\frac {1} {f}", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",

Cell["\<\
Note que en esta imagen superior la distancia entre crestas y valles (y \
cualquier otra secci\[OAcute]n sucesiva) se puede determinar por el numero de \
cuadros que esta de fondo, esta idea de caracterizar la periodicidad en t\
\[EAcute]rminos del numero de cuadros es muy \[UAcute]til y usada en la \
medicina cuando se da lectura a un ECG.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9382489085224648`*^9, 3.938248927052606*^9}, {
   3.939293918461484*^9, 3.93929392926578*^9}, {3.9507944003703003`*^9, 
   3.9507944736954365`*^9}, 3.970739912035943*^9, 3.9781787530523434`*^9, {
   3.9781913453194923`*^9, 3.978191358664692*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"c6dec97d-a4d4-f14b-b967-7f182666cc0c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "t_", "]"}], "=", 
   RowBox[{"0.15", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"50.3", "t"}], "-", 
      RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "t_", "]"}], "=", 
   RowBox[{"0.15", "*", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"50.3", "t"}], "-", 
      RowBox[{"0.7", "\[Pi]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "t_", "]"}], "=", 
   RowBox[{"0.15", "*", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"50.3", "t"}], "-", 
      RowBox[{"0.9", "\[Pi]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", "t", "]"}], ",", 

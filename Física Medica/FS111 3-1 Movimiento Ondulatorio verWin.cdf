     RowBox[{
      RowBox[{
       RowBox[{"onda", "[", 
        RowBox[{"x_", ",", "t_"}], "]"}], ":=", 
       RowBox[{"amplitud", "*", 
        RowBox[{"Sin", "[", 
         RowBox[{"2", "*", "Pi", "*", "frecuencia", "*", 
          RowBox[{"(", 
           RowBox[{"t", "-", 
            RowBox[{"x", "/", "velocidadFase"}]}], ")"}]}], "]"}]}]}], ";", 

Cell[TextData[{
 "donde el signo (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["-", TraditionalForm], "errors" -> {}, "input" -> "-", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "48b9d4e7-e404-5e44-afc3-33dac1a0da8d"],
 ") es para cuando la fuente se acerca al observador estacionario, mientras \
que el signo (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["+", TraditionalForm], "errors" -> {}, "input" -> "+", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d4bbeb4f-4270-eb42-a191-6ff5fe0c91b7"],

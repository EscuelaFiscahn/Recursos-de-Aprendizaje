Cell[CellGroupData[{

Cell["Efecto Doppler ", "Subsection",
 CellChangeTimes->{{3.984003774482004*^9, 
  3.984003782405611*^9}},ExpressionUUID->"1f8c4772-e5a5-cf4b-863d-\
ff891ae9bb1b"],

Cell[TextData[{
 "Para la siguiente parte utilizaremos la siguiente notaci\[OAcute]n: \n\n1. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["f", "TI"], 
        StyleBox["o", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "f_o", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "370ec658-d142-0c46-b167-2b53055f7f34"],
 " es la frecuencia percibida por el observador.\n2. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["f", "TI"], 
        StyleBox["s", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "f_s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d28e2479-a781-cc45-b31d-1619a50f4d50"],
 " es la frecuencia emitida por la fuente.\n3. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["v", "TI"], 
        StyleBox["o", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "v_o", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3658844a-f48b-1a4f-8097-3cec7702caf6"],
 " es la velocidad del observador.\n4. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["v", "TI"], 
        StyleBox["s", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "v_s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "606aaa3d-ccac-cc43-862e-57f062761b09"],
 " es la velocidad de la fuente del sonido.\n5. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["v", "TI"], TraditionalForm], "errors" -> {}, "input" -> "v", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d8bdc7f3-f499-9c40-a40d-76eb6dcdaac8"],
 " es la velocidad del sonido (la cual puede depender de la temperatura)."
}], "Text",
 CellChangeTimes->{{3.935515855055318*^9, 3.935515912099792*^9}, {
   3.935516954447952*^9, 3.93551699985431*^9}, {3.935519109382757*^9, 
   3.93551913911549*^9}, {3.935522839672781*^9, 3.935522866929489*^9}, {

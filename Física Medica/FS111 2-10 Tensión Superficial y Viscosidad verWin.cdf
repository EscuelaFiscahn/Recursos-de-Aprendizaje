Cell["\<\
En la pr\[AAcute]ctica es posible determinar las cualidades del flujo \
mediante la determinaci\[OAcute]n del n\[UAcute]mero de Reynolds que se \
define como:\
\>", "Text",
 CellChangeTimes->{{3.9657363824686527`*^9, 3.9657364195946007`*^9}, {
  3.96573900347114*^9, 3.9657390089648533`*^9}, {3.965739061922987*^9, 
  3.9657390714944935`*^9}, {3.9657391055782776`*^9, 3.9657391901918964`*^9}, {
  3.9805203092511063`*^9, 3.980520309589876*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"4b70bf31-bfd2-6e4d-8dc4-54c1fbd0c659"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SubscriptBox[
        StyleBox["R", "TI"], 
        StyleBox["e", "TI"]], "\[LongEqual]", 
       FractionBox[
        RowBox[{"2", "\[Rho]", 
          OverscriptBox[
           StyleBox["v", "TI"], "_"], 
          StyleBox["r", "TI"]}], "\[Eta]"]}], TraditionalForm], 
   "errors" -> {}, "input" -> "R_e = \\frac {2 \\rho\\bar{v} r} {\\eta}", 
   "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.980520289260933*^9, 3.980520291759964*^9}},
 TextAlignment->Center,ExpressionUUID->"91aca497-7696-934d-84fd-8fad7c5f3f39"],

Cell[TextData[{
 "Si ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["e", "TI"]], "<", "2000"}], TraditionalForm], 
     "errors" -> {}, "input" -> "R_e<2000", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a22a3a79-0351-7449-a1f6-f36c7197e86c"],
 ", se considera como flujo laminar.\n\nSi ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"2000", "<", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["e", "TI"]], "<", "3000"}], TraditionalForm], 
     "errors" -> {}, "input" -> "2000<R_e<3000", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4b003dd-a1d9-844c-ba72-74661f111d68"],
 ", se considera como un flujo inestable.\n\nSi ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["e", "TI"]], ">", "3000"}], TraditionalForm], 
     "errors" -> {}, "input" -> "R_e>3000", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1017f78e-aa75-2241-a56c-7e9ae0c35c03"],
 ", se considera como flujo turbulento."
}], "Text",
 CellChangeTimes->{{3.9657363824686527`*^9, 3.9657364195946007`*^9}, {
  3.96573900347114*^9, 3.9657390089648533`*^9}, {3.965739061922987*^9, 
  3.9657390714944935`*^9}, {3.9657391055782776`*^9, 3.9657391901918964`*^9}, {
  3.9805203132702465`*^9, 3.980520327730028*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"e11f2e7b-f43f-0643-a53d-1d1eb24b9173"],


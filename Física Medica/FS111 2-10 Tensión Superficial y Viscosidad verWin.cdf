Cell[CellGroupData[{

Cell["Flujo Turbulento", "Subsection",
 CellChangeTimes->{{3.9645288127733765`*^9, 3.964528823262932*^9}, {
   3.9646350699043674`*^9, 3.9646350834553127`*^9}, 3.9646396944969864`*^9, {
   3.9657339466815796`*^9, 3.965733950992607*^9}, {3.965735274408306*^9, 
   3.965735277956051*^9}},ExpressionUUID->"4463d5c8-92be-f948-a2c3-\
56e122d4ae87"],

Cell["\<\
El flujo turbulento es el movimiento de un fluido que se da en forma caotica \
debido a que las part\[IAcute]culas se mueven desordenadamente y las \
trayectorias de las part\[IAcute]culas se encuentran formando remolinos aperi\
\[OAcute]dicos y movimientos de colisi\[OAcute]n entre las mismas.\
\>", "Text",
 CellChangeTimes->{{3.965734990259739*^9, 3.9657350887167645`*^9}, {
   3.965735121609785*^9, 3.965735181527355*^9}, {3.9657352368191605`*^9, 
   3.9657352653488827`*^9}, {3.965735338634016*^9, 3.965735441901121*^9}, 

Cell["\<\
El flujo laminar es el movimiento no turbulento de un fluido en capas. El \
movimiento laminar plano se puede ilustrar empujando lateralmente la parte \
superior de un libro cerrado; la parte inferior no se mueve y la superior \
muestra el movimiento m\[AAcute]ximo. En el caso de un tubo, la velocidad del \
flujo cerca de las paredes es m\[IAcute]nima debido a la fricci\[OAcute]n. La \
f\[OAcute]rmula de Newton para la viscosidad se basa en el flujo laminar.\
\>", "Text",
 CellChangeTimes->{3.9805194808245296`*^9},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"de7e4153-ddb8-364b-94ab-4b6ef1738c86"],

Cell["\<\
Puesto que en el flujo laminar hay esfuerzos cortantes y deformaciones por \
corte, la propiedad de viscosidad de un fluido puede describirse con un \
coeficiente de viscosidad.\
\>", "Text",
 CellChangeTimes->{{3.9654705109699116`*^9, 3.965470513321987*^9}, {
   3.965470578311125*^9, 3.965470581886654*^9}, {3.9654708179149303`*^9, 
   3.965470821471987*^9}, {3.965470868759411*^9, 3.9654709018410263`*^9}, {
   3.9654709411879654`*^9, 3.965470954767618*^9}, {3.9654710053689976`*^9, 
   3.965471085058159*^9}, {3.965471189442623*^9, 3.965471219581848*^9}, {
   3.9654769011278343`*^9, 3.965476928702057*^9}, {3.965477013824095*^9, 
   3.965477054113291*^9}, {3.9654771256664734`*^9, 3.9654771831372013`*^9}, 
   3.965477237803072*^9, {3.9654772849976063`*^9, 3.9654772987385826`*^9}, {
   3.965728887810093*^9, 3.9657288905254726`*^9}, {3.9657300354358826`*^9, 
   3.965730037569891*^9}, {3.9657400152236843`*^9, 3.9657400170169735`*^9}, {
   3.9805195461724796`*^9, 3.980519547959631*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"25266ab5-5975-b64f-ab6f-a32c344a88d4"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{"\[Eta]", "\[LongEqual]", 
       FractionBox[
        RowBox[{
          StyleBox["F", "TI"], "/", 
          StyleBox["A", "TI"]}], 
        SubscriptBox[
         StyleBox["G", "TI"], 
         StyleBox["v", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
   "\\eta = \\frac {F/A} {G_v}", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9805195616060295`*^9, 3.98051956422476*^9}},
 TextAlignment->Center,ExpressionUUID->"01dd1ad2-b28d-e341-996c-4550dce92cf6"],

Cell[TextData[{
 "Donde:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9e4287b3-97fc-6b41-9400-670fd7dcb03a"],
 " : coeficiente de viscosidad\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["F", "TI"], TraditionalForm], "errors" -> {}, "input" -> "F", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4d1b54e2-80b3-5242-b4f0-7cf85549123d"],
 " : Fuerza cortante paralela a la superficie laminar\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> "A", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bee7c57e-3f73-5c42-bbc5-00f814fc4d35"],
 " : Superficie laminar\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["G", "TI"], 
          StyleBox["v", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[CapitalDelta]", 
            StyleBox["v", "TI"]}], 
          RowBox[{"\[CapitalDelta]", 
            StyleBox["y", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "G_v=\\frac{\\Delta v}{\\Delta y}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7134c861-721c-eb47-804a-579d9909e402"],
 " : Gradiente de velocidad definida como el cambio de velocidad (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["v", "TI"], TraditionalForm], "errors" -> {}, "input" -> "v", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9bd4529d-7939-2042-92ab-1b0b32186775"],
 ") respecto al cambio de desplazamiento longitudinal (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["y", "TI"], TraditionalForm], "errors" -> {}, "input" -> "y", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c9c125c9-e6c9-eb49-86f4-a1d27d157c6a"],
 ")."

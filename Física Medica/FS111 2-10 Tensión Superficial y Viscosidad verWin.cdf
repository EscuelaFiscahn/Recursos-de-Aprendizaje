Cell[CellGroupData[{

Cell["Ley de Poiseuille", "Subsection",
 CellChangeTimes->{{3.9645288127733765`*^9, 3.964528823262932*^9}, {
   3.9646350699043674`*^9, 3.9646350834553127`*^9}, 
   3.9646396944969864`*^9},ExpressionUUID->"a2fc3b86-0b2f-cc46-a879-\
28ab98aee3a9"],

Cell["\<\
La viscosidad es un factor importante al tener en cuenta el consumo energ\
\[EAcute]tico del coraz\[OAcute]n para mover la sangre debido a la \
concentraci\[OAcute]n de c\[EAcute]lulas sangu\[IAcute]neas, \
prote\[IAcute]nas y otras macromol\[EAcute]culas.

La Ley de Poiseuille es una aproximaci\[OAcute]n muy \[UAcute]til para \
entender la fisiolog\[IAcute]a cardiovascular y respiratoria ya que describe \
como fluye un l\[IAcute]quido viscoso a trav\[EAcute]s de un tubo estrecho. \
Para ello, se analiza su relaci\[OAcute]n con el caudal:\
\>", "Text",
 CellChangeTimes->{{3.9657315839507732`*^9, 3.9657315984487095`*^9}, {
   3.9657317097071743`*^9, 3.9657318032784195`*^9}, {3.9657320237177334`*^9, 
   3.965732103804123*^9}, {3.965732418542145*^9, 3.9657325203938503`*^9}, {
   3.965732582163555*^9, 3.9657327177143497`*^9}, {3.9657327773228397`*^9, 
   3.9657329473009815`*^9}, {3.965739228120306*^9, 3.965739278704756*^9}, {
   3.9657398517272453`*^9, 3.965739931547735*^9}, {3.96573996454056*^9, 
   3.9657399974359303`*^9}, {3.9657400279290695`*^9, 3.965740038593914*^9}, {
   3.9657400736643124`*^9, 3.9657401563428726`*^9}, {3.965740245056322*^9, 
   3.9657402671838684`*^9}, {3.96574030146772*^9, 3.965740305350563*^9}, {
   3.96574035946974*^9, 3.9657403596795063`*^9}, {3.965743626767479*^9, 
   3.9657437630460415`*^9}, {3.9657444609394703`*^9, 
   3.9657444618144283`*^9}, {3.9657446692828465`*^9, 
   3.9657446991618996`*^9}, {3.965744852399269*^9, 3.9657448788825893`*^9}, 
   3.98051990391337*^9, 3.980519944010792*^9, {3.980519990013111*^9, 
   3.9805200165098953`*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"3f942aad-1cea-224f-aa52-064ae3d8151b"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["Q", "TI"], "\[LongEqual]", 
       StyleBox["A", "TI"], 
       OverscriptBox[
        StyleBox["v", "TI"], "_"], "\[LongEqual]", 
       FractionBox[
        RowBox[{"\[CapitalDelta]", 
          StyleBox["V", "TI"]}], 
        RowBox[{"\[CapitalDelta]", 
          StyleBox["t", "TI"]}]], "\[LongEqual]", 
       FractionBox[
        RowBox[{"\[Pi]", 
          SuperscriptBox[
           StyleBox["r", "TI"], "4"], "\[CapitalDelta] ", 
          StyleBox["P", "TI"]}], 
        RowBox[{"8", "\[Eta]", 
          StyleBox["L", "TI"]}]]}], TraditionalForm], "errors" -> {}, "input" -> 
   "Q = A\\bar {v} = \\frac {\\Delta V} {\\Delta t} = \\frac {\\pi r^4 \
\\Delta \\\n\nP} {8\\eta L}", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.980520023059967*^9, 3.980520025852125*^9}},
 TextAlignment->Center,ExpressionUUID->"e2d90758-f187-744b-a441-a3dc4299e537"],

Cell["\<\
Una manera simple de representar la Ley de Poiseuille es implementando la \
resistencia de flujo y que contiene todos los aspectos que impactan \
directamente en el aumento o reducci\[OAcute]n del caudal. Si la resistencia \
de flujo aumenta, implica que el caudal se reduce, mientras que si la \
resistencia de flujo disminuye es porque existir\[AAcute] una mayor capacidad \
de flujo. Por ello, se representa de manera inversamente proporcional:\
\>", "Text",
 CellChangeTimes->{{3.9657315839507732`*^9, 3.9657315984487095`*^9}, {
   3.9657317097071743`*^9, 3.9657318032784195`*^9}, {3.9657320237177334`*^9, 
   3.965732103804123*^9}, {3.965732418542145*^9, 3.9657325203938503`*^9}, {
   3.965732582163555*^9, 3.9657327177143497`*^9}, {3.9657327773228397`*^9, 
   3.9657329473009815`*^9}, {3.965739228120306*^9, 3.965739278704756*^9}, {
   3.9657398517272453`*^9, 3.965739931547735*^9}, {3.96573996454056*^9, 
   3.9657399974359303`*^9}, {3.9657400279290695`*^9, 3.965740038593914*^9}, {
   3.9657400736643124`*^9, 3.9657401563428726`*^9}, {3.965740245056322*^9, 
   3.9657402671838684`*^9}, {3.96574030146772*^9, 3.965740305350563*^9}, {
   3.96574035946974*^9, 3.9657403596795063`*^9}, {3.965743626767479*^9, 
   3.9657437630460415`*^9}, {3.9657444609394703`*^9, 
   3.9657444618144283`*^9}, {3.9657446692828465`*^9, 
   3.9657446991618996`*^9}, {3.965744852399269*^9, 3.9657448788825893`*^9}, 
   3.98051990391337*^9, 3.980519944010792*^9, {3.980519990013111*^9, 
   3.980519990950096*^9}, {3.980520040585085*^9, 3.980520072010887*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"555f8ba4-7f34-5243-b4ba-f1d6435a699f"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["Q", "TI"], "\[LongEqual]", 
       FractionBox[
        RowBox[{"\[CapitalDelta]", 
          StyleBox["P", "TI"]}], 
        SubscriptBox[
         StyleBox["R", "TI"], 
         StyleBox["f", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
   "Q = \\frac {\\Delta P} {R_f}", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9805200518287926`*^9, 3.980520054759905*^9}},
 TextAlignment->Center,ExpressionUUID->"bafdf5a3-200e-2b49-bd3b-2ff3e4d10887"],

Cell["Por ello, la resistencia de flujo puede ser definida como:", "Text",
 CellChangeTimes->{{3.9657315839507732`*^9, 3.9657315984487095`*^9}, {
   3.9657317097071743`*^9, 3.9657318032784195`*^9}, {3.9657320237177334`*^9, 
   3.965732103804123*^9}, {3.965732418542145*^9, 3.9657325203938503`*^9}, {
   3.965732582163555*^9, 3.9657327177143497`*^9}, {3.9657327773228397`*^9, 
   3.9657329473009815`*^9}, {3.965739228120306*^9, 3.965739278704756*^9}, {
   3.9657398517272453`*^9, 3.965739931547735*^9}, {3.96573996454056*^9, 
   3.9657399974359303`*^9}, {3.9657400279290695`*^9, 3.965740038593914*^9}, {
   3.9657400736643124`*^9, 3.9657401563428726`*^9}, {3.965740245056322*^9, 
   3.9657402671838684`*^9}, {3.96574030146772*^9, 3.965740305350563*^9}, {
   3.96574035946974*^9, 3.9657403596795063`*^9}, {3.965743626767479*^9, 
   3.9657437630460415`*^9}, {3.9657444609394703`*^9, 
   3.9657444618144283`*^9}, {3.9657446692828465`*^9, 
   3.9657446991618996`*^9}, {3.965744852399269*^9, 3.9657448788825893`*^9}, 
   3.98051990391337*^9, 3.980519944010792*^9, {3.980519990013111*^9, 
   3.980519990950096*^9}, {3.9805200763697834`*^9, 3.980520103469675*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"191df326-016c-fc4b-a8c6-bd53e7f34f25"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SubscriptBox[
        StyleBox["R", "TI"], 
        StyleBox["f", "TI"]], "\[LongEqual]", 
       FractionBox[
        RowBox[{"8", "\[Eta]", 
          StyleBox["L", "TI"]}], 
        RowBox[{"\[Pi]", 
          SuperscriptBox[
           StyleBox["r", "TI"], "4"]}]]}], TraditionalForm], "errors" -> {}, 
   "input" -> "R_f = \\frac {8\\eta L} {\\pi r^4}", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.980520086940178*^9, 3.980520089469555*^9}},
 TextAlignment->Center,ExpressionUUID->"e8c18525-59a9-4147-8e3e-8aedab9bdca4"],

Cell[TextData[{
 "Recordando que el caudal se encuentra relacionado con el movimiento de la \
cantidad de fluido por unidad de tiempo, es posible mencionar algunas \
caracter\[IAcute]sticas importantes de la formulaci\[OAcute]n anterior en el \
flujo sangu\[IAcute]neo:\n\n1. Debido a que el caudal es directamente \
proporcional a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["r", "TI"], "4"], TraditionalForm], "errors" -> {}, "input" -> 
     "r^4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bfc6d827-eac1-204d-8c1c-4c8d7fc3e8f8"],
 ", peque\[NTilde]os cambios en el radio de los vasos producen grandes \
diferencias en la capacidad de flujo sangu\[IAcute]neo.\n\n2. El flujo sangu\
\[IAcute]neo es caracterizado por un movimiento desde zonas de alta presi\
\[OAcute]n hac\[IAcute]a zonas de baja presi\[OAcute]n y la diferencia de \
presi\[OAcute]n es principalmente mediada por el trabajo de bombeo realizado \
por el coraz\[OAcute]n, cuando esta diferencia de presi\[OAcute]n aumenta se \
considera que el caudal tambi\[EAcute]n aumenta.\n\n3. La viscosidad del \
torrente sangu\[IAcute]neo resulta una caracter\[IAcute]stica muy importante, \
ya que al ser inversamente proporcional fluido mas viscosos representa una \
reducci\[OAcute]n el caudal del flujo sangu\[IAcute]neo.\n\n4. En el cuerpo \
humano de un adulto saludable, no se considera que la longitud de los vasos \
cambian como lo har\[IAcute]a el radio de los mismos. Por ello, dentro del \
cuerpo se puede considera que no tiene un impacto directo; no obstante, \
cuando se trata de la utilizaci\[OAcute]n de dispositivos m\[EAcute]dicos \
externos, la longitud si puede brindar un efecto sobre el caudal del fluido.\n\
\n5.  Para fines pr\[AAcute]cticos, el caudal \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["Q", "TI"], TraditionalForm], "errors" -> {}, "input" -> "Q", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "60546996-15f2-5846-b4c6-bce8916fc89c"],
 "\[CloseCurlyDoubleQuote] es lo que en medicina se reconocer\[IAcute]a como \
gasto card\[IAcute]aco, la diferencia de presi\[OAcute]n \
\[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["P", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta P", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "129c107c-2c02-5c49-8e30-f503ccf0e323"],
 "\[CloseCurlyDoubleQuote] representa la presi\[OAcute]n arterial y la \
resistencia de flujo \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], 
        StyleBox["f", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "R_f", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5f2a5a22-a4e1-c544-9c67-57ea1ec32104"],
 "\[CloseCurlyDoubleQuote] es la resistencia vascular perif\[EAcute]rica."
}], "Text",
 CellChangeTimes->{{3.9657315839507732`*^9, 3.9657315984487095`*^9}, {
   3.9657317097071743`*^9, 3.9657318032784195`*^9}, {3.9657320237177334`*^9, 
   3.965732103804123*^9}, {3.965732418542145*^9, 3.9657325203938503`*^9}, {
   3.965732582163555*^9, 3.9657327177143497`*^9}, {3.9657327773228397`*^9, 
   3.9657329473009815`*^9}, {3.965739228120306*^9, 3.965739278704756*^9}, {
   3.9657398517272453`*^9, 3.965739931547735*^9}, {3.96573996454056*^9, 
   3.9657399974359303`*^9}, {3.9657400279290695`*^9, 3.965740038593914*^9}, {
   3.9657400736643124`*^9, 3.9657401563428726`*^9}, {3.965740245056322*^9, 
   3.9657402671838684`*^9}, {3.96574030146772*^9, 3.965740305350563*^9}, {

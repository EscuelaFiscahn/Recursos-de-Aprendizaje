Cell["\<\
La velocidad del flujo laminar en un tubo tiene su m\[AAcute]ximo en la capa \
central, pero la velocidad media del fluido puede calcularse como la mitad de \
la velocidad m\[AAcute]xima.\
\>", "Text",
 CellChangeTimes->{{3.9657278157585297`*^9, 3.9657279474979877`*^9}, {
   3.96572897491477*^9, 3.965728975903515*^9}, 3.965729401737566*^9, {
   3.9657294463373547`*^9, 3.9657295204497643`*^9}, {3.9657295542017765`*^9, 
   3.9657296414841213`*^9}, {3.965729678937895*^9, 3.9657296914240685`*^9}, {
   3.9657297235200863`*^9, 3.965729737586155*^9}, {3.9657300599597435`*^9, 
   3.965730060941454*^9}, {3.980519738504593*^9, 3.9805197659040337`*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"8e76f1f9-5f1d-b04b-be43-8184fc42be64"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       OverscriptBox[
        StyleBox["v", "TI"], "_"], "\[LongEqual]", 
       FractionBox[
        SubscriptBox[
         StyleBox["v", "TI"], 
         RowBox[{
           StyleBox["m", "TI"], 
           StyleBox["a", "TI"], 
           StyleBox["x", "TI"]}]], "2"]}], TraditionalForm], "errors" -> {}, 
   "input" -> "\\bar {v} = \\frac {v_ {max}} {2}", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9805197538097343`*^9, 3.980519756579729*^9}},
 TextAlignment->Center,ExpressionUUID->"2d53661a-587c-ef40-9317-016a50c2ddc9"],

Cell["\<\
Adem\[AAcute]s, la ca\[IAcute]da de presi\[OAcute]n a lo largo del tubo es \
proporcional a las fuerzas viscosas y por lo tanto a la velocidad media del \
fluido y de la longitud del tubo. En estos casos, la velocidad media puede \
ser calculada de la siguiente forma:\
\>", "Text",
 CellChangeTimes->{{3.9657278157585297`*^9, 3.9657279474979877`*^9}, {
   3.96572897491477*^9, 3.965728975903515*^9}, 3.965729401737566*^9, {
   3.9657294463373547`*^9, 3.9657295204497643`*^9}, {3.9657295542017765`*^9, 
   3.9657296414841213`*^9}, {3.965729678937895*^9, 3.9657296914240685`*^9}, {
   3.9657297235200863`*^9, 3.965729737586155*^9}, {3.9657300599597435`*^9, 
   3.965730060941454*^9}, 3.980519770711052*^9, {3.980519822297127*^9, 
   3.9805198238196583`*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"d5caa8f8-d36d-944e-8efb-52fc58c1f7ff"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       OverscriptBox[
        StyleBox["v", "TI"], "_"], "\[LongEqual]", 
       FractionBox[
        RowBox[{"\[CapitalDelta]", 
          StyleBox["P", "TI"], " ", 
          SuperscriptBox[
           StyleBox["r", "TI"], "2"]}], 
        RowBox[{"8 ", "\[Eta] ", 
          StyleBox["L", "TI"]}]]}], TraditionalForm], "errors" -> {}, "input" -> 
   "\\bar{v} = \\frac {\\Delta P \\: r^2} {8 \\: \\eta \\: L}", "state" -> 
   "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.980519783109808*^9, 3.9805197872394657`*^9}},
 TextAlignment->Center,ExpressionUUID->"24361898-12b8-8648-b3df-1e0120958a87"],


Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{"\[CapitalDelta]", 
       StyleBox["P", "TI"], "\[LongEqual]", 
       SubscriptBox[
        StyleBox["P", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["n", "TI"], 
          StyleBox["t", "TI"]}]], "-", 
       SubscriptBox[
        StyleBox["P", "TI"], 
        RowBox[{
          StyleBox["e", "TI"], 
          StyleBox["x", "TI"], 
          StyleBox["t", "TI"]}]], "\[LongEqual]", 
       FractionBox[
        RowBox[{"2", "\[Gamma]"}], 
        StyleBox["r", "TI"]], 
       StyleBox["c", "TI"], 
       StyleBox["o", "TI"], 
       StyleBox["s", "TI"], 
       RowBox[{"(", "\[Alpha]", ")"}]}], TraditionalForm], "errors" -> {}, 
   "input" -> 
   "\\Delta P = P_ {int} - P_ {ext} = \\frac {2 \\gamma} {r} cos (\\alpha)", 
   "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.980518600134796*^9, 3.9805186029926815`*^9}},
 TextAlignment->Center,ExpressionUUID->"1a011803-a8ef-1c4b-81bb-479a357c1067"],

Cell["\<\
Donde a es un factor de reducci\[OAcute]n de la tensi\[OAcute]n superficial \
mediante la concentraci\[OAcute]n de un agente tenso\[AAcute]ctivo en las \
paredes de los alv\[EAcute]olos.\
\>", "Text",
 CellChangeTimes->{{3.9653918344252243`*^9, 3.965391912833599*^9}, {
   3.9653920292951965`*^9, 3.9653920452952538`*^9}, 3.965392266829853*^9, {
   3.9653923458150196`*^9, 3.965392383298691*^9}, {3.9653924136200676`*^9, 
   3.965392441935158*^9}, {3.965392487651829*^9, 3.9653925362467556`*^9}, {

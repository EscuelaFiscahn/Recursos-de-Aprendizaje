      Module[{$CellContext`c$ = 
         1540., $CellContext`interfaces$, $CellContext`amplitudes$, \
$CellContext`tiempos$, $CellContext`tmax$, $CellContext`pulse$, \
$CellContext`signal$}, $CellContext`interfaces$ = {$CellContext`d1$$, \
$CellContext`d2$$, $CellContext`d3$$}; $CellContext`amplitudes$ = \
{$CellContext`a1$$, $CellContext`a2$$, $CellContext`a3$$}; \
$CellContext`tiempos$ = 

Cell["\<\
a) El pulso de ultrasonido pasa a trav\[EAcute]s del abdomen y en su \
trayectoria se refleja en las superficies.
b) Los pulsos reflejados se grafican como funci\[OAcute]n del tiempo una vez \
que el transductor los recibe. Las l\[IAcute]neas punteadas verticales se\
\[NTilde]alan cu\[AAcute]l pulso reflejado va con cu\[AAcute]l superficie.
c) Despliegue de puntos para los mismos ecos: la brillantez de cada punto est\
\[AAcute] relacionada con la intensidad de la se\[NTilde]al.\
\>", "Text",
 CellChangeTimes->{{3.984000829990841*^9, 3.9840008361233807`*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"cece9b2f-8da8-554d-9a37-750ae688788b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", "=", "1540.0"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "velocidad", " ", "del", " ", "sonido", " ", "en", " ", "tejidos"}], 
         ",", 
         RowBox[{"m", "/", "s"}]}], "*)"}], "interfaces", ",", "amplitudes", 
       ",", "tiempos", ",", "tmax", ",", "pulse", ",", "signal"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "Lista", " ", "de", " ", "profundidades", " ", "de", " ", "las", " ", 
       RowBox[{"interfaces", "[", "m", "]"}], " ", "y", " ", "amplitudes", 
       " ", "de", " ", "eco"}], "*)"}], 
     RowBox[{
      RowBox[{"interfaces", "=", 
       RowBox[{"{", 
        RowBox[{"d1", ",", "d2", ",", "d3"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"amplitudes", "=", 
       RowBox[{"{", 
        RowBox[{"a1", ",", "a2", ",", "a3"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Tiempos", " ", "de", " ", "llegada", " ", "de", " ", "los", " ", 
        "ecos", " ", 
        RowBox[{"(", 
         RowBox[{"ida", " ", "y", " ", "vuelta"}], ")"}]}], "*)"}], 
      RowBox[{"tiempos", "=", 
       RowBox[{"2.0", " ", 
        RowBox[{"interfaces", "/", "c"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tmax", "=", 
       RowBox[{"2.0", " ", 
        RowBox[{"dmax", "/", "c"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Pulso", " ", "gaussiano"}], "*)"}], 
      RowBox[{
       RowBox[{"pulse", "[", 
        RowBox[{
         RowBox[{"t_", "?", "NumericQ"}], ",", "t0_", ",", "amp_"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "arg", "}"}], ",", 
         RowBox[{
          RowBox[{"arg", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"t", "-", "t0"}], ")"}], "^", "2"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", 
              RowBox[{"sigma", "^", "2"}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"arg", ">", "50"}], ",", "0", ",", 
            RowBox[{"amp", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"-", "arg"}], "]"}]}]}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Se\[NTilde]al", " ", "total"}], "=", 
        RowBox[{"suma", " ", "de", " ", "ecos"}]}], "*)"}], 
      RowBox[{
       RowBox[{"signal", "[", 
        RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"pulse", "[", 
         RowBox[{"t", ",", 
          RowBox[{"tiempos", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"amplitudes", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "+", 
        RowBox[{"pulse", "[", 
         RowBox[{"t", ",", 
          RowBox[{"tiempos", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"amplitudes", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "+", 
        RowBox[{"pulse", "[", 
         RowBox[{"t", ",", 
          RowBox[{"tiempos", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", 
          RowBox[{"amplitudes", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Text", "[", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<A-Scan: Amplitud de los ecos en funci\[OAcute]n del \
tiempo\>\"", ",", "Bold", ",", "14"}], "]"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"signal", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "tmax"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1.1"}], "}"}]}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Tiempo (s)\>\"", ",", "\"\<Amplitud\>\""}], "}"}]}],
            ",", 
           RowBox[{"ImageSize", "->", "500"}], ",", 
           RowBox[{"Epilog", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Directive", "[", 
               RowBox[{"Red", ",", "Dashed", ",", 
                RowBox[{"Thickness", "[", "0.003", "]"}]}], "]"}], ",", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"Line", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"tiempos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "0"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"tiempos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"amplitudes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "}"}], "]"}], 
                ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "3"}], "}"}]}], "]"}]}], "}"}]}], ",", 
           RowBox[{"PlotLabel", "->", "\"\<Pulsos reflejados (ecos)\>\""}]}], 
          "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<B-Mode (una l\[IAcute]nea): Conversi\[OAcute]n de amplitud a \
brillo\>\"", ",", "Bold", ",", "14"}], "]"}], "]"}], ",", 
         RowBox[{"Graphics", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"GrayLevel", "[", 
                RowBox[{"1", "-", 
                 RowBox[{"amplitudes", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
               RowBox[{"(*", 
                RowBox[{
                 RowBox[{"Mayor", " ", "amplitud"}], "=", 
                 RowBox[{"m\[AAcute]s", " ", "oscuro"}]}], "*)"}], 
               RowBox[{"Disk", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"interfaces", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "0"}], "}"}], ",", 
                 "0.008"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "dmax"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "0.05"}], ",", "0.05"}], "}"}]}], "}"}]}], ",", 
           RowBox[{"Axes", "->", 
            RowBox[{"{", 
             RowBox[{"True", ",", "False"}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Profundidad (m)\>\"", ",", "\"\<\>\""}], "}"}]}], 
           ",", 
           RowBox[{"ImageSize", "->", "500"}], ",", 
           RowBox[{
           "PlotLabel", "->", 
            "\"\<Puntos cuyo brillo depende de la intensidad\>\""}], ",", 
           RowBox[{"Epilog", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Directive", "[", 
               RowBox[{"Blue", ",", "Dashed", ",", 
                RowBox[{"Thickness", "[", "0.002", "]"}]}], "]"}], ",", 
              RowBox[{"Table", "[", 
               RowBox[{

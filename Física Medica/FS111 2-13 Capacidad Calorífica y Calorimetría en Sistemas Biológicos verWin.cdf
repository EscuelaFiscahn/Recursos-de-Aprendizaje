Cell[TextData[{
 "La descripci\[OAcute]n se actualiza din\[AAcute]micamente mientras avanzas \
con el control deslizante.\n\n",
 StyleBox["Calentamiento del s\[OAcute]lido",
  FontWeight->"Bold"],
 ": Se observa desde el inicio hasta el punto de fusi\[OAcute]n.\n",
 StyleBox["Fusi\[OAcute]n:",
  FontWeight->"Bold"],
 " El s\[OAcute]lido se transforma en l\[IAcute]quido.\n",
 StyleBox["Calentamiento del l\[IAcute]quido",
  FontWeight->"Bold"],
 ": Ocurre despu\[EAcute]s de la fusi\[OAcute]n y antes de la vaporizaci\
\[OAcute]n.\n",
 StyleBox["Vaporizaci\[OAcute]n",
  FontWeight->"Bold"],
 ": El l\[IAcute]quido se transforma en gas.\n",
 StyleBox["Calentamiento del gas",
  FontWeight->"Bold"],
 ": Ocurre despu\[EAcute]s de la vaporizaci\[OAcute]n."
}], "Text",
 CellChangeTimes->{{3.980588027362776*^9, 3.9805880995424557`*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"c2400cde-2e5f-3c43-8384-e8c064eb2b61"],

Cell["\<\
Aplicar los conceptos de calorimetr\[IAcute]a en la sudoraci\[OAcute]n del \
cuerpo humano implica tener presentes algunos detalles:

1. La sudoraci\[OAcute]n obedece al fen\[OAcute]meno de evaporaci\[OAcute]n \
del agua el cual ocurre a la temperatura del cuerpo humano.
2. El proceso de evaporaci\[OAcute]n en este caso, es distinto al proceso de \
ebullici\[OAcute]n. La diferencia esencial es que la naturaleza del proceso \
de ebullici\[OAcute]n es estrictamente a una temperatura de 100\[Degree]C y \
ocurre en todo el volumen del l\[IAcute]quido, mientras que el proceso de \
evaporaci\[OAcute]n ocurre solo en la superficie del l\[IAcute]quido y por \
ende puede ocurrir a temperaturas menores de 100\[Degree]C. 
3. A medida se reduce la temperatura, aumenta la energ\[IAcute]a necesaria \
para el proceso de evaporaci\[OAcute]n.\
\>", "Text",
 CellChangeTimes->{{3.9688503943068275`*^9, 3.9688504160206985`*^9}, {
   3.968850532145586*^9, 3.968850611134678*^9}, {3.968873025908119*^9, 
   3.9688730507653275`*^9}, {3.968873085917246*^9, 3.968873112367285*^9}, 
   3.9708524121470947`*^9, {3.9805881508223896`*^9, 3.9805881640569134`*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"2146cb32-9c23-a94e-9e71-931a7e557d2c"],

Cell["\<\
Un modelo simple utilizado en aplicaciones de la ingenier\[IAcute]a \
t\[EAcute]rmica para el c\[AAcute]lculo del calor latente es descrito a \
continuaci\[OAcute]n:\
\>", "Text",
 CellChangeTimes->{{3.9688503943068275`*^9, 3.9688504160206985`*^9}, {
   3.968850532145586*^9, 3.968850611134678*^9}, {3.968873025908119*^9, 
   3.9688730507653275`*^9}, {3.968873085917246*^9, 3.968873112367285*^9}, 
   3.9708524121470947`*^9, {3.9805881508223896`*^9, 3.9805881927633495`*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"2a33a7c4-237c-254b-9bc0-c87ecc7dc64e"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SubscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["v", "TI"]], 
       RowBox[{"(", 
         StyleBox["T", "TI"], ")"}], "\[LongEqual]", 
       SubscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["v", "TI"]], 
       RowBox[{"(", 
         RowBox[{
           SuperscriptBox["0", "\[EmptySmallCircle]"], 
           StyleBox["C", "TI"]}], ")"}], "-", 
       StyleBox["c", "TI"], 
       StyleBox["T", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
   "L_v (T) = L_v (0^{\\circ} C) - cT", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9805881825723734`*^9, 3.980588185823303*^9}},
 TextAlignment->Center,ExpressionUUID->"9794991e-b9fe-5542-b82d-9d76f2e01efa"],

Cell[TextData[{
 "donde:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["v", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox["0", "\[EmptySmallCircle]"], 
             StyleBox["C", "TI"]}], ")"}], "\[LongEqual]", "2500.9", 
         StyleBox["k", "TI"], 
         StyleBox["J", "TI"], "/", 
         StyleBox["k", "TI"], 
         StyleBox["g", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "L_v(0^{\\circ}C)=2500.9 kJ/kg", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "019040dd-4f61-be42-923d-a0a59ee5dcda"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["c", "TI"], "\[LongEqual]", "2.36", 
         StyleBox["k", "TI"], 
         StyleBox["J", "TI"], "/", 
         StyleBox["k", "TI"], 
         StyleBox["g", "TI"], 
         SuperscriptBox["\[CenterDot]", "\[EmptySmallCircle]"], 
         StyleBox["C", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "c = 2.36 kJ/kg\\cdot ^{\\circ}C", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "07144805-e384-3043-9549-ceef8aa0caec"],
 " (tasa de variaci\[OAcute]n del calor latente)"
}], "Text",
 CellChangeTimes->{{3.968850394306827*^9, 3.968850416020698*^9}, {
   3.968850532145586*^9, 3.968850611134678*^9}, {3.968873025908119*^9, 
   3.968873050765328*^9}, {3.968873085917246*^9, 3.968873112367285*^9}, 
   3.9708524121470947`*^9, {3.9805881508223896`*^9, 3.980588200872652*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"7735b4bd-ee0d-444c-bdd8-f0ff4b29ea83"],


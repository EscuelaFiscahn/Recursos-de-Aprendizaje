Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`leftScaleName$$ = 
    "Kelvin", $CellContext`rightScaleName$$ = 
    "descriptions", $CellContext`t$$ = 37, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"sin t\[IAcute]tulo\"", Typeset`specs$$ = {{{
       Hold[$CellContext`t$$], 37, "temperature"}, -273, 100, 1, ControlType -> 
      VerticalSlider}, {{
       Hold[$CellContext`leftScaleName$$], "Kelvin", "left scale"}, {
      "Celsius", "Fahrenheit", "Kelvin", "Rankine", "empty"}, ControlType -> 
      SetterBar}, {{
       Hold[$CellContext`rightScaleName$$], "descriptions", "right scale"}, {
      "descriptions", "Celsius", "Fahrenheit", "Kelvin", "Rankine"}, 
      ControlType -> SetterBar}}, Typeset`size$$ = {
    270., {148., 151.07506702412877`}}, Typeset`update$$ = 0, 
    Typeset`initDone$$, Typeset`skipInitDone$$ = True}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`leftScaleName$$ = 
        "Kelvin", $CellContext`rightScaleName$$ = 
        "descriptions", $CellContext`t$$ = 37}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, "Body" :> 
      Module[{$CellContext`mintempC$ = -273, $CellContext`maxtempC$ = 
         100, $CellContext`tube$, $CellContext`mercury$, $CellContext`bulb$, \
$CellContext`scale$, $CellContext`readout$, $CellContext`convertTemp$}, \
$CellContext`tube$ = {
           EdgeForm[{Gray, 
             Thickness[0.01]}], 
           GrayLevel[0.95], 
           Rectangle[
            Scaled[{0.5 - 0.07, 0}], 
            Scaled[{0.5 + 0.07, 1}]]}; $CellContext`mercury$[
           Pattern[$CellContext`t, 
            Blank[]]] := {
           EdgeForm[], 
           RGBColor[0.7, 0, 0], 
           Rectangle[
            Scaled[{0.5 - 0.06, 0}], 
            Offset[{8, 0}, {0, $CellContext`t}]], 
           Thickness[0.02], 
           Line[{
             Offset[{-12, 0}, {0, $CellContext`t}], 
             Offset[{12, 0}, {0, $CellContext`t}]}]}; $CellContext`bulb$ = {
           RGBColor[0.69, 0, 0], 
           EdgeForm[{Gray, 
             Thickness[0.01]}], 
           Disk[{0, $CellContext`mintempC$ - 19}, 16]}; $CellContext`scale$[
          "descriptions"] := {{-273, "absolute zero"}, {-196, 
            "nitrogen boils"}, {-89, "coldest day (Antartic)"}, {
           0, "water freezes"}, {37, "body temperature"}, {
           56, "hottest day (Death Valley)"}, {
           100, "water boils"}}; $CellContext`scale$[
           Pattern[$CellContext`scaleName$, 
            Blank[]]] := ReplaceAll[
           $CellContext`scale$["descriptions"], {
             Pattern[$CellContext`t$, 
              Blank[]], 
             Blank[]} :> {$CellContext`t$, 
             $CellContext`convertTemp$[$CellContext`t$, \
$CellContext`scaleName$]}]; $CellContext`readout$[
           Pattern[$CellContext`t$, 
            Blank[]], 
           Pattern[$CellContext`sc$, 
            Blank[]], "left"] := {
           Text[
            $CellContext`convertTemp$[$CellContext`t$, $CellContext`sc$], 
            Offset[{-37, 0}, {0, $CellContext`t$}]]}; $CellContext`readout$[
           Pattern[$CellContext`t$, 
            Blank[]], 
           Pattern[$CellContext`sc$, 
            Blank[]], "right"] := {
           Text[
            $CellContext`convertTemp$[$CellContext`t$, $CellContext`sc$], 
            Offset[{45, 0}, {0, $CellContext`t$}]]}; $CellContext`convertTemp$[
           Pattern[$CellContext`t, 
            Blank[]], "Celsius"] := ToString[
            NumberForm[$CellContext`t, {3, 0}]] <> 
          " \[Degree]C"; $CellContext`convertTemp$[
           Pattern[$CellContext`t, 
            Blank[]], "Fahrenheit"] := ToString[
            NumberForm[
             N[32 + $CellContext`t (9/5)], {3, 0}]] <> 
          " \[Degree]F"; $CellContext`convertTemp$[
           Pattern[$CellContext`t, 
            Blank[]], "Kelvin"] := ToString[
            NumberForm[$CellContext`t + 273, {3, 0}]] <> 
          " K"; $CellContext`convertTemp$[
           Pattern[$CellContext`t, 
            Blank[]], "Rankine"] := ToString[
            NumberForm[($CellContext`t + 273) (9/5.), {3, 0}]] <> 
          " \[Degree]R"; $CellContext`convertTemp$[
           Blank[], 
           Blank[]] := ""; Graphics[{$CellContext`tube$, $CellContext`bulb$, 
           $CellContext`mercury$[$CellContext`t$$], 
           $CellContext`readout$[$CellContext`t$$, \
$CellContext`leftScaleName$$, "left"], 
           $CellContext`readout$[$CellContext`t$$, \
$CellContext`rightScaleName$$, "right"]}, 
          PlotRange -> {(($CellContext`maxtempC$ - $CellContext`mintempC$)/
             100) {-20, 20}, {$CellContext`mintempC$ - 
             20, $CellContext`maxtempC$}}, LabelStyle -> Directive[14, Gray], 
          Frame -> {False, True, False, True}, 
          ImagePadding -> {{70, 150}, {15, 15}}, FrameTicks -> {{
             $CellContext`scale$[$CellContext`leftScaleName$$], 
             $CellContext`scale$[$CellContext`rightScaleName$$]}, {
            True, None}}]], 
      "Specifications" :> {{{$CellContext`t$$, 37, "temperature"}, -273, 100, 
         1, ControlType -> VerticalSlider, ControlPlacement -> 
         Left}, {{$CellContext`leftScaleName$$, "Kelvin", "left scale"}, {
         "Celsius", "Fahrenheit", "Kelvin", "Rankine", 
          "empty"}}, {{$CellContext`rightScaleName$$, "descriptions", 
          "right scale"}, {
         "descriptions", "Celsius", "Fahrenheit", "Kelvin", "Rankine"}}}, 
      "Options" :> {
       TrackedSymbols :> {$CellContext`t$$, $CellContext`leftScaleName$$, \
$CellContext`rightScaleName$$}}, "DefaultOptions" :> {}],
     ImageSizeCache->{351., {190.85052490234375`, 195.14947509765625`}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,

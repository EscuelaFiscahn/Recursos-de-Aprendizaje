Cell[TextData[{
 StyleBox["2. Convecci\[OAcute]n:",
  FontWeight->"Bold"],
 " \n\nOcurre cuando el calor se transfiere entre una superficie y un fluido \
en movimiento (l\[IAcute]quido o gas)."
}], "Text",

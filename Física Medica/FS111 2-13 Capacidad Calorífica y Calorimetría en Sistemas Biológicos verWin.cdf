Cell["\<\
Esta demostraci\[OAcute]n estima las calor\[IAcute]as de una porci\[OAcute]n \
de alimento seg\[UAcute]n su contenido de grasas, carbohidratos y prote\
\[IAcute]nas. Se asume que las grasas aportan 9 calor\[IAcute]as por gramo y \
los carbohidratos y las prote\[IAcute]nas, 4 calor\[IAcute]as por gramo cada \
uno. Tambi\[EAcute]n calcula y muestra la contribuci\[OAcute]n relativa de \
estos componentes al contenido energ\[EAcute]tico del alimento. La \
configuraci\[OAcute]n en miniatura corresponde a una porci\[OAcute]n de leche \
entera.\
\>", "Text",
 CellChangeTimes->{3.9805864801191254`*^9},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"7bb68c7c-a039-4a4f-98ec-5a4ed6c86c47"],

Cell["\<\
El calor puede ser transferido debido a una diferencia de temperatura. Dicha \
transferencia puede ocurrir mediante los siguientes mecanismos.\
\>", "Text",
 CellChangeTimes->{{3.9645267041633606`*^9, 3.9645267221833115`*^9}, {
   3.9645269285620728`*^9, 3.9645269293734894`*^9}, 3.964527110519985*^9, 
   3.9645288402539806`*^9, {3.968845280171896*^9, 3.9688452840839996`*^9}, {
   3.968845333721691*^9, 3.968845383964571*^9}, {3.9688470464785633`*^9, 
   3.9688470474034367`*^9}, {3.968847084879677*^9, 3.9688471162209835`*^9}, {
   3.968847156981516*^9, 3.968847182733124*^9}, {3.9688472556247673`*^9, 
   3.9688472766256733`*^9}, {3.96884736227087*^9, 3.968847367084749*^9}, 
   3.970851258989298*^9, {3.9805865093074284`*^9, 3.980586510785244*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"91d6ca4c-1086-2a44-bd0d-b5a1b232f7f6"],

Cell[TextData[{
 StyleBox["1. Conducci\[OAcute]n:",
  FontWeight->"Bold"],
 " ocurre cuando el calor se transfiere directamente entre mol\[EAcute]culas \
o part\[IAcute]culas en contacto, sin movimiento neto de materia.\n\n\
Experimentalmente, se ha comprobado que la tasa de flujo de calor (\.04\
\[CapitalDelta]Q/\[CapitalDelta]\.04t en J/s) a trav\[EAcute]s de una plancha \
de material es directamente proporcional al \[AAcute]rea superficial del \
material (A) y a la diferencia de temperatura en sus extremos, e inversamente \
proporcional a su espesor (d). Es decir,"
}], "Text",
 CellChangeTimes->{{3.9645267041633606`*^9, 3.9645267221833115`*^9}, {
   3.9645269285620728`*^9, 3.9645269293734894`*^9}, 3.964527110519985*^9, 
   3.9645288402539806`*^9, {3.968845280171896*^9, 3.9688452840839996`*^9}, {
   3.968845333721691*^9, 3.968845383964571*^9}, {3.9688470464785633`*^9, 
   3.9688470474034367`*^9}, {3.968847084879677*^9, 3.9688471162209835`*^9}, {
   3.968847156981516*^9, 3.968847182733124*^9}, {3.9688472556247673`*^9, 
   3.9688472766256733`*^9}, {3.96884736227087*^9, 3.968847367084749*^9}, 
   3.970851258989298*^9, {3.9805865238452168`*^9, 3.9805865364825554`*^9}, {
   3.980586633759241*^9, 3.9805866542753353`*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"c5af7d18-29fe-304d-8bf4-83bb6a0d39d6"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       FractionBox[
        RowBox[{"\[CapitalDelta]", 
          StyleBox["Q", "TI"]}], 
        RowBox[{"\[CapitalDelta]", 
          StyleBox["t", "TI"]}]], "\[LongEqual]", 
       StyleBox["k", "TI"], 
       FractionBox[
        RowBox[{
          StyleBox["A", "TI"], "\[CapitalDelta]", 
          StyleBox["T", "TI"]}], 
        StyleBox["d", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
   "\\frac {\\Delta Q} {\\Delta t} = k\\frac {A\\Delta T} {d}", "state" -> 
   "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.980586556485876*^9, 3.980586582457716*^9}},
 TextAlignment->Center,ExpressionUUID->"f41c8018-2779-cb48-9fc7-8480547a1d45"],

Cell[TextData[{
 "donde ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b198ad7f-a4e8-d641-8243-8218abbc6942"],
 " es una constante de proporcionalidad denominada conductividad \
t\[EAcute]rmica."
}], "Text",
 CellChangeTimes->{{3.9645267041633606`*^9, 3.964526722183312*^9}, {
   3.9645269285620737`*^9, 3.964526929373489*^9}, 3.964527110519985*^9, 

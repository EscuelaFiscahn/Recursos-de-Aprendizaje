Cell[TextData[{
 StyleBox["3. Radiaci\[OAcute]n:",
  FontWeight->"Bold"],
 " \n\nLa radiaci\[OAcute]n t\[EAcute]rmica es la emisi\[OAcute]n de energ\
\[IAcute]a en forma de ondas electromagn\[EAcute]ticas (infrarrojo). Mediante \
la ley de Stefan-Boltzmann es posible describir la transferencia de energ\
\[IAcute]a por radiaci\[OAcute]n t\[EAcute]rmica."
}], "Text",
 CellChangeTimes->{{3.9645267041633606`*^9, 3.9645267221833115`*^9}, {
   3.9645269285620728`*^9, 3.9645269293734894`*^9}, 3.964527110519985*^9, 
   3.9645288402539806`*^9, {3.968845280171896*^9, 3.9688452840839996`*^9}, {
   3.968845333721691*^9, 3.968845383964571*^9}, {3.9688470464785633`*^9, 
   3.9688470474034367`*^9}, {3.968847084879677*^9, 3.9688471162209835`*^9}, {
   3.968847156981516*^9, 3.968847182733124*^9}, {3.9688472556247673`*^9, 
   3.9688472766256733`*^9}, {3.96884736227087*^9, 3.968847367084749*^9}, 
   3.9708513195536175`*^9, {3.980586752565235*^9, 3.9805867579154167`*^9}, {
   3.9805867900750675`*^9, 3.9805867945961*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"e2929e6b-2057-734f-a277-35aee80859eb"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["P", "TI"], "\[LongEqual]", "\[Sigma]", 
       StyleBox["A", "TI"], 
       StyleBox["e", "TI"], 
       RowBox[{"(", 
         RowBox[{
           SubsuperscriptBox[
            StyleBox["T", "TI"], 
            StyleBox["s", "TI"], "4"], "-", 
           SuperscriptBox[
            StyleBox["T", "TI"], "4"]}], ")"}]}], TraditionalForm], 
   "errors" -> {}, "input" -> "P = \\sigma A e (T_s^4 - T^4)", "state" -> 
   "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.980586775759215*^9, 3.980586778404646*^9}},
 TextAlignment->Center,ExpressionUUID->"fad6df67-f42a-6442-89b5-9d582a5f3b8e"],

Cell[TextData[{
 "donde:\n\t\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["P", "TI"], TraditionalForm], "errors" -> {}, "input" -> "P", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "196a6a67-7a84-f94e-a27e-6aad928e5b43"],
 ": Potencia radiada.\n",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "ecc9c5ba-c928-e34c-8acd-cd9cf0929324"],
 ": \[CapitalAAcute]rea superficial del objeto.\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Sigma]", "\[LongEqual]", "5.67", "\[Cross]", 
         SuperscriptBox["10", "8"], 
         StyleBox["W", "TI"], "/", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], 
         SuperscriptBox[
          StyleBox["K", "TI"], "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\sigma=5.67\\times 10^8 W/m^2\\cdto K^4", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0d468abd-e2f1-4048-82f4-79c4051b6728"],
 " : constante de Stefan-Boltzmann\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["e", "TI"], TraditionalForm], "errors" -> {}, "input" -> "e", 
     "state" -> "Boxes"|>,

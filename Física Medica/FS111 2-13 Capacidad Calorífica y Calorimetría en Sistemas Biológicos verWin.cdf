Cell[TextData[{
 StyleBox["1. Vasodilataci\[OAcute]n y vasoconstricci\[OAcute]n:",
  FontWeight->"Bold"],
 " \n\nAumento o reducci\[OAcute]n de las paredes de los vasos \
sangu\[IAcute]neos, aumentando o disminuyendo el flujo sangu\[IAcute]neo."
}], "Text",

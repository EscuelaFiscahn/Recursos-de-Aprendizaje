Cell[TextData[{
 "Una visualizaci\[OAcute]n interactiva que muestra la conversi\[OAcute]n de \
temperatura entre grados Celsius, Fahrenheit y Kelvin. Descripci\[OAcute]n de \
su funcionamiento:\n\n",
 StyleBox["Interfaz de Control:",
  FontWeight->"Bold"],
 "\nLa demostraci\[OAcute]n incluye un control deslizante para ajustar el \
valor de la temperatura en grados Celsius (variable ``t``). Este control \
deslizante permite seleccionar temperaturas en un rango de -17 a 120 grados \
Celsius. La apariencia del control deslizante est\[AAcute] etiquetada con \
\[OpenCurlyDoubleQuote]Celsius\[CloseCurlyDoubleQuote].\n\n",
 StyleBox["Visualizaci\[OAcute]n de Temperaturas:",
  FontWeight->"Bold"],
 "\nPara cada una de las escalas de temperatura (Celsius, Fahrenheit, \
Kelvin), se muestra un texto con la unidad de medida y el valor \
correspondiente de la temperatura.\nLas temperaturas en grados Fahrenheit y \
Kelvin se calculan a partir de la temperatura en grados Celsius usando las f\
\[OAcute]rmulas de conversi\[OAcute]n:\nFahrenheit: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{"32", "+", 
           FractionBox[
            RowBox[{"9", 
              StyleBox["T", "TI"]}], "5"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(32 + \\frac{9T}{5})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce9d2aae-f41c-bd4e-8bd3-7a58b5606b7c"],
 "\nKelvin: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["T", "TI"], "+", "273.15"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(T + 273.15)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a370468b-86c7-1849-9daf-2336058e9bb7"],
 "\n\nEsta demostraci\[OAcute]n es \[UAcute]til para entender c\[OAcute]mo \
var\[IAcute]an las temperaturas cuando se convierten entre diferentes escalas \
y proporciona una representaci\[OAcute]n visual intuitiva de las \
conversiones. Adem\[AAcute]s, al ser interactiva, permite al estudiante \
experimentar con diferentes valores de temperatura y observar los cambios \
instant\[AAcute]neamente."
}], "Text",
 CellChangeTimes->{{3.980585902350514*^9, 3.980586083968647*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"9ac981df-0bc4-524d-bdd1-176ebe1b17eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mintempC", "=", 
        RowBox[{"-", "273"}]}], ",", 
       RowBox[{"maxtempC", "=", "100"}], ",", "tube", ",", "mercury", ",", 
       "bulb", ",", "scale", ",", "readout", ",", "convertTemp"}], "}"}], ",", 
     RowBox[{
      RowBox[{"tube", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"EdgeForm", "[", 
          RowBox[{"{", 
           RowBox[{"Gray", ",", 
            RowBox[{"Thickness", "[", "0.01", "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"GrayLevel", "[", ".95", "]"}], ",", 
         RowBox[{"Rectangle", "[", 
          RowBox[{
           RowBox[{"Scaled", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{".5", "-", "0.07"}], ",", "0"}], "}"}], "]"}], ",", 
           RowBox[{"Scaled", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{".5", "+", "0.07"}], ",", "1"}], "}"}], "]"}]}], 
          "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mercury", "[", "t_", "]"}], ":=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"EdgeForm", "[", "]"}], ",", 
         RowBox[{"RGBColor", "[", 
          RowBox[{".7", ",", "0", ",", "0"}], "]"}], ",", 
         RowBox[{"Rectangle", "[", 
          RowBox[{
           RowBox[{"Scaled", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{".5", "-", "0.06"}], ",", "0"}], "}"}], "]"}], ",", 
           RowBox[{"Offset", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"8", ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "t"}], "}"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"Thickness", "[", ".02", "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Offset", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "12"}], ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "t"}], "}"}]}], "]"}], ",", 
            RowBox[{"Offset", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"12", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "t"}], "}"}]}], "]"}]}], "}"}], "]"}]}], 
        "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bulb", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"RGBColor", "[", 
          RowBox[{".69", ",", "0", ",", "0"}], "]"}], ",", 
         RowBox[{"EdgeForm", "[", 
          RowBox[{"{", 
           RowBox[{"Gray", ",", 
            RowBox[{"Thickness", "[", "0.01", "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Disk", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"mintempC", "-", "19"}]}], "}"}], ",", "16"}], "]"}]}], 
        "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"scale", "[", "\"\<descriptions\>\"", "]"}], ":=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "273"}], ",", "\"\<absolute zero\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "196"}], ",", "\"\<nitrogen boils\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "89"}], ",", "\"\<coldest day (Antartic)\>\""}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "\"\<water freezes\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"37", ",", "\"\<body temperature\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"56", ",", "\"\<hottest day (Death Valley)\>\""}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"100", ",", "\"\<water boils\>\""}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"scale", "[", "scaleName_", "]"}], ":=", 
       RowBox[{
        RowBox[{"scale", "[", "\"\<descriptions\>\"", "]"}], "/.", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t_", ",", "_"}], "}"}], ":>", 
         RowBox[{"{", 
          RowBox[{"t", ",", 
           RowBox[{"convertTemp", "[", 
            RowBox[{"t", ",", "scaleName"}], "]"}]}], "}"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"readout", "[", 
        RowBox[{"t_", ",", "sc_", ",", "\"\<left\>\""}], "]"}], ":=", 
       RowBox[{"{", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"convertTemp", "[", 
           RowBox[{"t", ",", "sc"}], "]"}], ",", 
          RowBox[{"Offset", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "37"}], ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "t"}], "}"}]}], "]"}]}], "]"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"readout", "[", 
        RowBox[{"t_", ",", "sc_", ",", "\"\<right\>\""}], "]"}], ":=", 
       RowBox[{"{", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"convertTemp", "[", 
           RowBox[{"t", ",", "sc"}], "]"}], ",", 
          RowBox[{"Offset", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"45", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "t"}], "}"}]}], "]"}]}], "]"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"convertTemp", "[", 
        RowBox[{"t_", ",", "\"\<Celsius\>\""}], "]"}], ":=", 
       RowBox[{
        RowBox[{"ToString", "@", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"t", ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "0"}], "}"}]}], "]"}]}], "<>", 
        "\"\< \[Degree]C\>\""}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"convertTemp", "[", 
        RowBox[{"t_", ",", "\"\<Fahrenheit\>\""}], "]"}], ":=", 
       RowBox[{
        RowBox[{"ToString", "@", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"32", "+", 
             RowBox[{"t", "*", 
              RowBox[{"(", 
               RowBox[{"9", "/", "5"}], ")"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "0"}], "}"}]}], "]"}]}], "<>", 
        "\"\< \[Degree]F\>\""}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"convertTemp", "[", 
        RowBox[{"t_", ",", "\"\<Kelvin\>\""}], "]"}], ":=", 
       RowBox[{
        RowBox[{"ToString", "@", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"t", "+", "273"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "0"}], "}"}]}], "]"}]}], "<>", "\"\< K\>\""}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"convertTemp", "[", 
        RowBox[{"t_", ",", "\"\<Rankine\>\""}], "]"}], ":=", 
       RowBox[{
        RowBox[{"ToString", "@", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"t", "+", "273"}], ")"}], "*", 
            RowBox[{"9", "/", "5."}]}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "0"}], "}"}]}], "]"}]}], "<>", 
        "\"\< \[Degree]R\>\""}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"convertTemp", "[", 
        RowBox[{"_", ",", "_"}], "]"}], ":=", "\"\<\>\""}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"tube", ",", "bulb", ",", 
          RowBox[{"mercury", "[", "t", "]"}], ",", 
          RowBox[{"readout", "[", 
           RowBox[{"t", ",", "leftScaleName", ",", "\"\<left\>\""}], "]"}], 
          ",", 
          RowBox[{"readout", "[", 
           RowBox[{"t", ",", "rightScaleName", ",", "\"\<right\>\""}], 
           "]"}]}], "}"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"maxtempC", "-", "mintempC"}], ")"}], "/", "100"}], 
             ")"}], "*", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "20"}], ",", "20"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"mintempC", "-", "20"}], ",", "maxtempC"}], "}"}]}], 
          "}"}]}], ",", 
        RowBox[{"LabelStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"14", ",", "Gray"}], "]"}]}], ",", 
        RowBox[{"Frame", "->", 
         RowBox[{"{", 

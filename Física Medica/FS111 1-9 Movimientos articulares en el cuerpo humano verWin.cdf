Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Tabla", " ", "de", " ", 
     RowBox[{"Inversi\[OAcute]n", "/", "Eversi\[OAcute]n"}]}], "-", 
    RowBox[{"Tobillo", " ", "y", " ", "Pie"}]}], "*)"}], 
  RowBox[{"Style", "[", 
   RowBox[{
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<\\*StyleBox[\\\"Articulaci\[OAcute]n\\\",FontFamily->\\\
\"Georgia\\\",FontSize->14,FontWeight->\\\"Bold\\\",FontColor->GrayLevel[0.3]]\
\>\"", ",", \
"\"\<\\*StyleBox[\\\"Movimiento\\\",FontFamily->\\\"Georgia\\\",FontSize->14,\

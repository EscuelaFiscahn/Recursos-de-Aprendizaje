          RowBox[{"Articulaciones", " ", "secundarias"}], "-", 
          RowBox[{"Gris", " ", "claro"}]}], "*)"}], 
        RowBox[{"{", 
         RowBox[{"\"\<\\*StyleBox[\\\"Metacarpofal\[AAcute]ngica \
(MCF)\\\",FontFamily->\\\"Georgia\\\",FontSlant->\\\"Italic\\\"]\>\"", ",", 
          RowBox[{"Column", "[", 
           RowBox[{
           "{", "\"\<Flexi\[OAcute]n + Rotaci\[OAcute]n ligera\>\"", "}"}], 
           "]"}], ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Bullet] Flexor pollicis longus\>\"", 

Cell[BoxData[
 RowBox[{"QuestionObject", "[", 
  RowBox[{
  "\"\<La elevaci\[OAcute]n de la esc\[AAcute]pula (encogimiento de hombros) \
es producida principalmente por los m\[UAcute]sculos trapecio superior y \
elevador de la esc\[AAcute]pula, y es clave en movimientos como cargar peso \
sobre los hombros.\>\"", ",", 
   RowBox[{"AssessmentFunction", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Verdadero\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<Falso\>\"", "->", "False"}]}], "}"}], "]"}]}], 

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuestionObject", "[", 
  RowBox[{
  "\"\<La protusi\[OAcute]n de la mand\[IAcute]bula es un movimiento hacia \
adelante del c\[OAcute]ndilo mandibular dentro de la fosa articular, \
producido principalmente por los m\[UAcute]sculos pterigoideos \
laterales.\>\"", ",", 
   RowBox[{"AssessmentFunction", "[", 

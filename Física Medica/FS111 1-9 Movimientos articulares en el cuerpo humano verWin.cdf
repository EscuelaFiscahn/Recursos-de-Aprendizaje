             ",", "\"\<3. Aducci\[OAcute]n + Flexi\[OAcute]n (contacto con \
dedos)\>\""}], "}"}], "]"}], ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Bullet] Op\[OAcute]nens pollicis (clave)\>\"", 
             ",", "\"\<\[Bullet] Flexor pollicis brevis \
(superficial/profundo)\>\"", 
             ",", "\"\<\[Bullet] Abductor pollicis brevis\>\""}], "}"}], 
           "]"}], ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Bullet] Superficie en silla de montar (libertad \

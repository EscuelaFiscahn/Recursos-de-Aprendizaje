        RowBox[{"{", 
         RowBox[{"\"\<\\*StyleBox[\\\"Hombro\\\",FontFamily->\\\"Georgia\\\",\
FontSlant->\\\"Italic\\\"]\>\"", ",", "\"\<Circunducci\[OAcute]n\>\"", ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Bullet] Deltoides (todas las fibras)\>\"", 
             ",", "\"\<\[Bullet] Rotadores del manguito:\>\"", 
             ",", "\"\<   - Supraespinoso (inicia)\>\"", 
             ",", "\"\<   - Infraespinoso/Redondo menor (control)\>\""}], 
            "}"}], "]"}], ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Bullet] Torque combinado: ~40 Nm\>\"", 
             ",", "\"\<\[Bullet] Trayectoria conoidal (3D)\>\"", 
             ",", "\"\<\[Bullet] Velocidad angular: 180\[Degree]/s\>\"", 
             ",", "\"\<\[Bullet] Energ\[IAcute]a cin\[EAcute]tica: 30 J en \

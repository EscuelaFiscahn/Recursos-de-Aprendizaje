J\>\""}], "}"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<\>\"", ",", "\"\<Aducci\[OAcute]n Horizontal\>\"", 
          ",", "\"\<\[Bullet] Pectoral mayor (esternocostal)\\n\[Bullet] \

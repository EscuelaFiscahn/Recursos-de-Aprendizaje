          ",", "\"\<\[Bullet] Redondo mayor\\n\[Bullet] Tr\[IAcute]ceps \
(cabeza larga)\>\"", ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Bullet] Fuerza compresiva: ~450 N\>\"", 
             ",", "\"\<\[Bullet] Trabajo contra resistencia: 30 J\>\"", 
             ",", "\"\<\[Bullet] Estabilidad en movimientos de empuje\>\""}], 
            "}"}], "]"}]}], "}"}], ",", 
        RowBox[{"(*", 

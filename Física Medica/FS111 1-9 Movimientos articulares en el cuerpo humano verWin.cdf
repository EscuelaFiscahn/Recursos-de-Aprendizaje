          RowBox[{"Column", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Bullet] Gl\[UAcute]teos (medio/mayor)\>\"", 
             ",", "\"\<\[Bullet] Iliopsoas (fase inicial)\>\"", 
             ",", "\"\<\[Bullet] Aductores (fase final)\>\""}], "}"}], "]"}], 
          ",", 
          RowBox[{"Column", "[", 

Cell[BoxData[
 RowBox[{"QuestionObject", "[", 
  RowBox[{
  "\"\<La pronaci\[OAcute]n del antebrazo es un movimiento que lleva la palma \
de la mano hacia abajo (o hacia atr\[AAcute]s en posici\[OAcute]n anat\
\[OAcute]mica) y est\[AAcute] controlado principalmente por los \
m\[UAcute]sculos pronador redondo y pronador cuadrado.\>\"", ",", 
   RowBox[{"AssessmentFunction", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Verdadero\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<Falso\>\"", "->", "False"}]}], "}"}], "]"}]}], 

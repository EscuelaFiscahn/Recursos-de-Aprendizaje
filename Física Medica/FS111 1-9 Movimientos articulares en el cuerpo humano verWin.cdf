          ",", "\"\<\\*StyleBox[\\\"M\[UAcute]sculos \
Principales\\\",FontFamily->\\\"Georgia\\\",FontSize->14,FontWeight->\\\"Bold\
\\\",FontColor->GrayLevel[0.3]]\>\"", 
          ",", "\"\<\\*StyleBox[\\\"Mec\[AAcute]nica \
Articular\\\",FontFamily->\\\"Georgia\\\",FontSize->14,FontWeight->\\\"Bold\\\
\",FontColor->GrayLevel[0.3]]\>\""}], "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Subtalar", " ", "y", " ", "Transversa", " ", "del", " ", "Tarso"}],
           "-", "Blanco"}], "*)"}], 
        RowBox[{"{", 
         RowBox[{"\"\<\\*StyleBox[\\\"Articulaci\[OAcute]n Subtalar y \
Transversa del \
Tarso\\\",FontFamily->\\\"Georgia\\\",FontSlant->\\\"Italic\\\"]\>\"", 
          ",", "\"\<Inversi\[OAcute]n\>\"", ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Bullet] Tibial anterior\>\"", 
             ",", "\"\<\[Bullet] Tibial posterior\>\"", 
             ",", "\"\<\[Bullet] Flexor largo del dedo gordo\>\"", 
             ",", "\"\<\[Bullet] Flexor largo de los dedos\>\""}], "}"}], 
           "]"}], ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Bullet] Eje de rotaci\[OAcute]n: 42\[Degree] \
inclinado\>\"", 
             ",", "\"\<\[Bullet] Palanca de 2\[Degree] g\[EAcute]nero (tibial \
anterior)\>\"", ",", "\"\<\[Bullet] Rango: 20-30\[Degree]\>\"", 
             ",", "\"\<\[Bullet] Fuerza media: ~200 N\>\""}], "}"}], "]"}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<\>\"", ",", "\"\<Eversi\[OAcute]n\>\"", ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Bullet] Fibular largo\>\"", 
             ",", "\"\<\[Bullet] Fibular corto\>\"", 
             ",", "\"\<\[Bullet] Extensor largo de los dedos*\>\""}], "}"}], 
           "]"}], ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Bullet] Estabilizado por ligamento calcaneofibular\
\>\"", ",", "\"\<\[Bullet] Mayor riesgo de esguince (inversi\[OAcute]n \
forzada)\>\"", ",", "\"\<\[Bullet] Rango: 5-15\[Degree]\>\""}], "}"}], 
           "]"}]}], "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Mec\[AAcute]nica", " ", "Integrada"}], "-", 
          RowBox[{"Gris", " ", "claro"}]}], "*)"}], 
        RowBox[{"{", 

             ",", "\"\<- Control proximal-distal\>\""}], "}"}], "]"}], ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Bullet] M\[UAcute]sculos extr\[IAcute]nsecos del \
pie\>\"", 
             ",", "\"\<\[Bullet] Fascia plantar (mec\[AAcute]nica \
tensigridad)\>\""}], "}"}], "]"}], ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Bullet] Distribuci\[OAcute]n de cargas:\>\"", 
             ",", "\"\<   - Inversi\[OAcute]n: 70% en 1er metatarsiano\>\"", 
             ",", "\"\<   - Eversi\[OAcute]n: carga lateral\>\""}], "}"}], 
           "]"}]}], "}"}]}], "}"}], ",", 
      RowBox[{"Background", "->", 

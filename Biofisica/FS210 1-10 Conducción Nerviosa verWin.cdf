              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"v", "[", "t", "]"}], ",", 
                 RowBox[{"w", "[", "t", "]"}]}], "}"}], ",", "iapp", ",", 
               "gCa", ",", "gK"}], "]"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
            RowBox[{"Last", "[", 
             RowBox[{"morrisLecar", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"v", "[", "t", "]"}], ",", 
                 RowBox[{"w", "[", "t", "]"}]}], "}"}], ",", "iapp", ",", 
               "gCa", ",", "gK"}], "]"}], "]"}]}], ",", "initialConditions"}],
           "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", ",", "w"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "200"}], "}"}], ",", 
         RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{"pasos", "=", 
   RowBox[{"{", 
    RowBox[{
    "\"\<Paso 1: las dendritas captan est\[IAcute]mulos\>\"", ",", 
     "\"\<Paso 2: el soma integra la se\[NTilde]al\>\"", ",", 
     "\"\<Paso 3: el ax\[OAcute]n transmite la se\[NTilde]al\>\"", ",", 
     "\"\<Paso 4: las terminales sin\[AAcute]pticas liberan neurotransmisores \
en la sinapsis\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{"ListAnimate", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Column", "[", 

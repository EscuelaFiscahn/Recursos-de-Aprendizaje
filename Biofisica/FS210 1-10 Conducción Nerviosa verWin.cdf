Cell[TextData[{
 "Las siguientes nubes de palabras (nervous system, neural cell, synapse, \
action potential) visualizan de forma gr\[AAcute]fica las palabras \
m\[AAcute]s frecuentes de un concepto y estas aparecen con mayor \
tama\[NTilde]o. Estas im\[AAcute]genes son basadas en la base de datos de ",
 ButtonBox["Wikipedia",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wikipedia.org/"], None},
  ButtonNote->"https://www.wikipedia.org/"],
 "."
}], "Text",
 CellChangeTimes->{{3.9500916235385323`*^9, 3.95009168546673*^9}, 
   3.9500918011134014`*^9, {3.9500918829752903`*^9, 3.9500918953358135`*^9}, {
   3.9500920495534725`*^9, 3.950092173865423*^9}, {3.9500922993769855`*^9, 
   3.9500923159839325`*^9}, {3.9515876309058857`*^9, 3.951587633249505*^9}, {
   3.95158775577759*^9, 3.951587756969208*^9}, {3.951587912420541*^9, 
   3.951587912624371*^9}, {3.951665337529869*^9, 3.95166535151502*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"9adcb47a-345d-4f12-8c46-7d551be2bce7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"texto", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"WikipediaData", "[", "\"\<nervous system\>\"", "]"}], ",", 
     RowBox[{"WikipediaData", "[", "\"\<neural cell\>\"", "]"}], ",", 
     RowBox[{"WikipediaData", "[", "\"\<synapse\>\"", "]"}], ",", 
     RowBox[{"WikipediaData", "[", "\"\<action potential\>\"", "]"}]}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nubes", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"WordCloud", "[", 
      RowBox[{
       RowBox[{"texto", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"RandomSeeding", "->", "i"}], ",", 
       RowBox[{"ImageSize", "->", "Large"}], ",", 
       RowBox[{"FontFamily", "->", "\"\<Verdana\>\""}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Panel", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<An\[AAcute]lisis visual (sistema nervioso \[UpperLeftArrow], c\
\[EAcute]lula nerviosa \[UpperRightArrow], sinapsis \[LowerLeftArrow] y \
potencial de acci\[OAcute]n \[LowerRightArrow])\>\"", ",", "Bold", ",", 
          "18"}], "]"}], "]"}], ",", "SpanFromLeft"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"nubes", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "2"}], "]"}], "]"}], ",", "SpanFromLeft"}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"nubes", "[", 
       RowBox[{"[", 
        RowBox[{"3", ";;", "4"}], "]"}], "]"}], "}"}]}], "}"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"FrameStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Thick", ",", "White"}], "]"}]}], ",", 
   RowBox[{"Alignment", "->", "Center"}], ",", 
   RowBox[{"Spacings", "->", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}]}], "Input",
 CellOpen->False,
 CellChangeTimes->{{3.951664382698391*^9, 3.9516645669889593`*^9}, {
  3.951664816190645*^9, 3.951664951065857*^9}, {3.951664986132349*^9, 
  3.9516650388057957`*^9}, {3.951665243002222*^9, 3.9516652579600267`*^9}, {

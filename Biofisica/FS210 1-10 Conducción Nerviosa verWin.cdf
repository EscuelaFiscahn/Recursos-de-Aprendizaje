         RowBox[{"1", ",", "1", ",", "0.5"}], "]"}]}], ",", 
       RowBox[{"Frame", "->", "True"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "pasos", "]"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"AnimationRate", "->", "0.5"}], ",", 
   RowBox[{"DefaultDuration", "->", "15"}]}], "]"}]}], "Input",

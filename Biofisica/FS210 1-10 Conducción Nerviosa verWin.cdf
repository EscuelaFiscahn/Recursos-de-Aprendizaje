       RowBox[{"t0", "*", 
        RowBox[{
         RowBox[{"Sech", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"v", "-", "v3"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "*", "v4"}], ")"}]}], "]"}], "^", "2"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"gCaTemp", ",", "gKTemp"}], "}"}], "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"temperature", "==", "98.7"}], ",", 
         RowBox[{"{", 
          RowBox[{"gCa", ",", "gK"}], "}"}], ",", 
         RowBox[{"temperature", "<", "98.7"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"gCa", "*", "0.7"}], ",", 
           RowBox[{"gK", "*", "0.7"}]}], "}"}], ",", 
         RowBox[{"temperature", ">", "98.7"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"gCa", "*", "1.2"}], ",", 
           RowBox[{"gK", "*", "1.2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"morrisLecar", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"v_", ",", "w_"}], "}"}], ",", "iapp_", ",", "gCaCurr_", ",",
          "gKCurr_"}], "]"}], ":=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", "c"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "gCaCurr"}], "*", 
             RowBox[{"Mss", "[", "v", "]"}], "*", 
             RowBox[{"(", 
              RowBox[{"v", "-", "vCa"}], ")"}]}], "-", 
            RowBox[{"gKCurr", "*", "w", "*", 
             RowBox[{"(", 
              RowBox[{"v", "-", "vK"}], ")"}]}], "-", 
            RowBox[{"gL", "*", 
             RowBox[{"(", 
              RowBox[{"v", "-", "vL"}], ")"}]}], "+", "iapp"}], ")"}]}], ",", 
         
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Wss", "[", "v", "]"}], "-", "w"}], ")"}], "/", 
          RowBox[{"TW", "[", "v", "]"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"initialConditions", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"v", "[", "0", "]"}], "==", 
          RowBox[{"-", "70"}]}], ",", 
         RowBox[{
          RowBox[{"w", "[", "0", "]"}], "==", "0.01"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 

 RowBox[{
  TemplateBox[{"\"nervous system\"", 
    RowBox[{"Entity", "[", 
      RowBox[{"\"AnatomicalStructure\"", ",", "\"NervousSystem\""}], "]"}], 
    "\"Entity[\\\"AnatomicalStructure\\\", \\\"NervousSystem\\\"]\"", 

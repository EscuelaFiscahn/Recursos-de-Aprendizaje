   QuestionInterface["MultipleChoice", <|"Prompt" -> Cell[
       TextData[
        StyleBox[
        "Un desfibrilador env\[IAcute]a una corriente el\[EAcute]ctrica al \
coraz\[OAcute]n a trav\[EAcute]s de dos electrodos colocados en el pecho del \
paciente. Los electrodos generan dos caminos paralelos de corriente:\n(1) La \
resistencia a trav\[EAcute]s del m\[UAcute]sculo es de 600 \[CapitalOmega].\n\
(2) La resistencia a trav\[EAcute]s del tejido adiposo es de 1500 \
\[CapitalOmega].\nSi el desfibrilador aplica un voltaje de 200 V, determina: \
la resistencia equivalente del cuerpo y la corriente total que atraviesa el \
paciente.", FontSlant -> "Italic"]], "QuestionTemplateText"]|>], 
   AssessmentFunction[{
    "Req\:200b=600 \[CapitalOmega], I=0.333 A" -> <|"Score" -> 0|>, 
     "Req\:200b=1500 \[CapitalOmega], I=0.133 A" -> <|"Score" -> 0|>, 
     "Req\:200b=428.57 \[CapitalOmega], I=0.467 A" -> <|"Score" -> 1|>, 
     "Req\:200b=1000 \[CapitalOmega], I=0.200 A" -> <|"Score" -> 0|>}, <|

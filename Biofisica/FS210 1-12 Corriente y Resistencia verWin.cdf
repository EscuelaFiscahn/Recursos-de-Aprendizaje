Cell[TextData[{
 "Para muchos materiales, especialmente los metales, la dependencia de la \
resistividad con respecto a la temperatura es casi lineal si el cambio de \
temperatura no es demasiado grande. Esto es, la resistividad a una \
temperatura ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "0956a66d-85a2-4295-9502-9bca0d53098e"],
 " despu\[EAcute]s de un cambio de temperatura ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["T", "TI"], "\[LongEqual]", 
         StyleBox["T", "TI"], "-", 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["o", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta T = T-T_o", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc45c9a6-89c8-4956-a7ec-322c8fd075dc"],
 " est\[AAcute] dada por:"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9526248521616898`*^9, 3.9526248600078487`*^9}, {
  3.9526249177146626`*^9, 3.952624924009943*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"23f9229d-156f-49ca-a17e-a9e9cc89a1b8"],

Cell[BoxData[
 RowBox[{"                          ", 
  RowBox[{
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"\[Rho]", "\[LongEqual]", 
          SubscriptBox["\[Rho]", 
           StyleBox["o", "TI"]], 
          RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]\[CapitalDelta]", 
              StyleBox["T", "TI"]}], ")"}]}], TraditionalForm], 
      "errors" -> {}, "input" -> "\\rho=\\rho_o (1+\\alpha \\Delta T)", 
      "state" -> "Boxes"|>,
     "TeXAssistantTemplate"],
    TraditionalForm], "\[OAcute]", 
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"\[CapitalDelta]\[Rho]", "\[LongEqual]", 
          SubscriptBox["\[Rho]", 
           StyleBox["o", "TI"]], "\[Alpha]\[CapitalDelta]", 
          StyleBox["T", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
      "\\Delta \\rho = \\rho_o \\alpha  \\Delta T", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"],
    TraditionalForm]}]}]], "DisplayFormulaNumbered",
 CellChangeTimes->{3.9526248674854717`*^9},
 TextAlignment->Center,ExpressionUUID->"f8a8f849-226a-49be-96f2-019ae7ad1e73"],

Cell[TextData[{
 "Donde: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Alpha]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5a445e47-82b9-40ae-ab2a-2c7593d88b75"],
 " es el coeficiente de temperatura de la resistividad y tiene unidades de 1/\
\[Degree]C\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Rho]", 
        StyleBox["o", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho_o", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8b8397dd-b9a9-4dd5-b941-04a8e6164f16"],
 " es la resistividad a una temperatura ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["o", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_o", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68eec6af-c346-45e8-9a4a-93f6ced248ab"],
 "  \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["T", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta T", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "078056a8-8992-490f-a549-7c569765c6b0"],
 " es el cambio en la temperatura "
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.952624882549721*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"4d2c14e0-4f1c-4aec-bb7a-cc77f0bae853"],

Cell["\<\
La resistencia es directamente proporcional a la resistividad. Esto significa \
que la resistencia de un objeto presenta la misma dependencia con respecto a \
la temperatura que la resistividad. La resistencia de un objeto de secci\
\[OAcute]n transversal uniforme var\[IAcute]a en funci\[OAcute]n de la \
temperatura:\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.95262489440119*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"e6c176b5-18be-43d3-b49e-f3b7cef7f41e"],

Cell[BoxData[
 RowBox[{"     ", 
  RowBox[{
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          StyleBox["R", "TI"], "\[LongEqual]", 
          SubscriptBox[
           StyleBox["R", "TI"], 
           StyleBox["o", "TI"]], 
          RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]\[CapitalDelta]", 
              StyleBox["T", "TI"]}], ")"}]}], TraditionalForm], 
      "errors" -> {}, "input" -> "R=R_o(1+\\alpha \\Delta T)", "state" -> 
      "Boxes"|>,
     "TeXAssistantTemplate"],
    TraditionalForm], "o", 
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"\[CapitalDelta]", 
          StyleBox["R", "TI"], "\[LongEqual]", 
          SubscriptBox[
           StyleBox["R", "TI"], 
           StyleBox["o", "TI"]], "\[Alpha]\[CapitalDelta]", 
          StyleBox["T", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
      "\\Delta R= R_o \\alpha \\Delta T", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"],
    TraditionalForm]}]}]], "DisplayFormulaNumbered",
 CellChangeTimes->{3.9526249061916428`*^9},
 TextAlignment->Center,ExpressionUUID->"f910fd07-73b8-4671-8b64-e01c32b9a3da"],


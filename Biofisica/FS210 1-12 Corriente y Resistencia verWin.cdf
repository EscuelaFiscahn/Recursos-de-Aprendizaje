Cell[TextData[{
 "Este flujo neto de electrones se caracteriza por una velocidad promedio \
llamada ",
 StyleBox["velocidad de deriva",
  FontWeight->"Bold"],
 ", que es mucho menor que las velocidades aleatorias (t\[EAcute]rmicas) de \
los mismos electrones. "
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.954948493001524*^9},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"23cea622-0d63-45f1-a581-f7b07064989f"],

Cell[CellGroupData[{

Cell["Resistencia y resistividad", "Subsubsection",
 CellChangeTimes->{{3.9526236612214165`*^9, 
  3.9526236665120125`*^9}},ExpressionUUID->"f793f27b-fd70-4771-95ce-\
c9c34f5d613a"],

Cell["\<\
Objetivos: 
a) Definir el concepto de resistencia el\[EAcute]ctrica.
b) Analizar los factores que influyen en el valor de la resistencia el\
\[EAcute]ctrica de un conductor.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.954952431957075*^9, 3.954952478793947*^9}, {
  3.954953725552*^9, 3.954953743742758*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"b46bcf75-ec7e-4ce4-9364-68120931a6e2"],

Cell[TextData[{
 "Cualquier objeto que ofrece resistencia considerable a la corriente el\
\[EAcute]ctrica se llama resistor. La resistencia ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], ")"}], TraditionalForm]],ExpressionUUID->
  "04e04fe1-7bf6-41a9-84a6-04c919307ff9"],
 " de cualquier objeto se define como la raz\[OAcute]n entre el voltaje a \
trav\[EAcute]s del objeto y la corriente resultante a trav\[EAcute]s de ese \
objeto.  "
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.952624520429981*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"5b40f378-0e87-47da-bb56-ca263c827508"],

Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        StyleBox["R", "TI"], "\[LongEqual]", 
        FractionBox[
         StyleBox["V", "TI"], 
         StyleBox["I", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
    "R=\\frac{V}{I}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{3.9526245490265427`*^9},
 TextAlignment->Center,ExpressionUUID->"a7c2d4fe-0d07-4d8f-a6d7-24f77ad29bfb"],

Cell[TextData[{
 "Unidad en el SI: volt por ampere (V/A) , u ohm ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", "\[CapitalOmega]", ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(\\Omega)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c1284cbe-4aeb-4beb-a3bb-c5748bd6ecbf"],
 "\nRecuerda que: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["V", "TI"], TraditionalForm], "errors" -> {}, "input" -> "V", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6a260090-14c0-4964-96bc-3453770f5df9"],
 " representa la diferencia de potencial, es decir, voltaje. Medido en \
Voltios.\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["I", "TI"], TraditionalForm], "errors" -> {}, "input" -> "I", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "376f3f23-0a29-40ff-ad7f-eaed837db990"],
 " es la corriente el\[EAcute]ctrica, medida en amperios."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.9526245367338142`*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"6a3b914a-d9d8-4ea0-9057-fc887ff1e7fb"],

Cell["\<\
Para algunos materiales, la resistencia es constante en un rango de voltajes. \
Se dice que un resistor que exhibe resistencia constante obedece la ley de \
Ohm. La ley se llam\[OAcute] as\[IAcute] en honor de Ohm, quien encontr\
\[OAcute] materiales que poseen esta propiedad.  Una forma com\[UAcute]n y pr\
\[AAcute]ctica de la ley de Ohm es:\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{
  3.9526245722096596`*^9, {3.9526251181796417`*^9, 3.9526251203377647`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"bb8ecfe8-12b3-48d5-8979-dcaaec3fd537"],


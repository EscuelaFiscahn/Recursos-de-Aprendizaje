         Thickness[0.007], 
         Table[
          ({
           Map[Map[Arrow, 
             Partition[#, 2, 1]]& , 
            Split[#, First[#2] > First[#]& ]], 
           PointSize[0.01], Green, 
           Point[
            First[#]], Red, 

Cell[BoxData[
 RowBox[{
  RowBox[{"Manipulate", "[", 
   RowBox[{
    RowBox[{"Graphics3D", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Arrowheads", "[", ".005", "]"}]}], ",", 
        RowBox[{"Thickness", "[", ".007", "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Arrow", "/@", 
                 RowBox[{"Partition", "[", 
                  RowBox[{"#", ",", "2", ",", "1"}], "]"}]}], "&"}], "/@", 
               RowBox[{"Split", "[", 
                RowBox[{"#", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"First", "[", "#2", "]"}], ">", 
                   RowBox[{"First", "[", "#1", "]"}]}], "&"}]}], "]"}]}], ",", 
              RowBox[{"PointSize", "[", ".01", "]"}], ",", "Green", ",", 
              RowBox[{"Point", "[", 
               RowBox[{"First", "@", "#"}], "]"}], ",", "Red", ",", 
              RowBox[{"Point", "[", 
               RowBox[{"Last", "@", "#"}], "]"}], ",", 
              RowBox[{"Text", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<q\>\"", ",", "Bold", ",", "8", ",", "Black"}], 
                 "]"}], ",", 
                RowBox[{"Last", "@", "#"}]}], "]"}]}], "}"}], "&"}], "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Flatten", "@", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"First", "@", "#"}], ",", "10"}], "]"}], ",", 
                RowBox[{"Rest", "@", "#"}]}], "}"}]}], "&"}], "/@", 
            RowBox[{"FoldList", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Flatten", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"First", "[", 
                   RowBox[{"#1", "+", "#2"}], "]"}], ",", 
                  RowBox[{"Rest", "@", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Norm", "[", 
                    RowBox[{"Rest", "[", 
                    RowBox[{"#1", "+", "#2"}], "]"}], "]"}], ">", "1"}], ",", 
                    
                    RowBox[{"Subtract", "[", 
                    RowBox[{"#1", ",", "#2"}], "]"}], ",", 
                    RowBox[{"Plus", "[", 
                    RowBox[{"#1", ",", "#2"}], "]"}]}], "]"}]}]}], "}"}], 
                "]"}], "&"}], ",", 
              RowBox[{"Flatten", "@", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"RandomReal", "[", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", "9.9"}], "}"}], "]"}], ",", 
                 RowBox[{"RandomReal", "[", 
                  RowBox[{"UniformDisk", "[", "1", "]"}], "]"}]}], "}"}]}], ",", 
              RowBox[{"Transpose", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"RandomReal", "[", 
                  RowBox[{
                   RowBox[{"NegativeOfUniform", "[", 
                    RowBox[{
                    RowBox[{"-", ".1"}], ",", "0"}], "]"}], ",", "t"}], "]"}],
                  ",", 
                 RowBox[{"RandomReal", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", ".1"}], ",", ".1"}], "}"}], ",", "t"}], 
                  "]"}], ",", 
                 RowBox[{"RandomReal", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", ".1"}], ",", ".1"}], "}"}], ",", "t"}], 
                  "]"}]}], "}"}], "]"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", "intensidad", "}"}]}], "]"}], ",", 
        RowBox[{"Opacity", "[", ".75", "]"}], ",", 
        RowBox[{"EdgeForm", "[", "]"}], ",", 
        RowBox[{"Cylinder", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"10", ",", "0", ",", "0"}], "}"}]}], "}"}], "]"}]}], 
       "}"}], ",", 
      RowBox[{"Boxed", "->", "False"}], ",", 
      RowBox[{"ImageSize", "->", 
       RowBox[{"{", 
        RowBox[{"550", ",", "350"}], "}"}]}], ",", 
      RowBox[{"SphericalRegion", "->", "True"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", "50", ",", "\"\<tiempo\>\""}], "}"}], ",", "3", ",", 
      "100", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"intensidad", ",", "5"}], "}"}], ",", "1", ",", "20", ",", 
      "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"seed", ",", 
        RowBox[{"10", "^", "5"}], ",", "\"\<cambiar el flujo\>\""}], "}"}], ",", 
      RowBox[{"10", "^", "5"}], ",", 
      RowBox[{"10", "^", "6"}], ",", "1"}], "}"}], ",", 
    RowBox[{"SaveDefinitions", "->", "True"}]}], "]"}], "\n"}]], "Input",

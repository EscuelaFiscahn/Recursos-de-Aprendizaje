Cell[TextData[StyleBox["En el simulador se muestra, una descripci\[OAcute]n \
de la Ley de Ohm en un circuito el\[EAcute]ctrico b\[AAcute]sico.  Puede \
introducir el valor del voltaje en unidades de Voltios y el valor de la \
resistencia en unidades de ohmios, y as\[IAcute] poder obtener el valor de la \
corriente el\[EAcute]ctrica a trav\[EAcute]s del circuito con el uso de la \
ley de Ohm.\nExtra\[IAcute]do de: https://demonstrations.wolfram.com/OhmsLaw/",
 FontSlant->"Italic"]], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.956830578844452*^9},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"8d2b0c85-43b0-4bae-8b69-ad2a321d0be0"],


Cell[TextData[{
 "En este caso, todos los resistores tienen conexiones comunes, esto es, \
todos los conductores al otro lado est\[AAcute]n unidos juntos a una terminal \
de la bater\[IAcute]a. Todos los conductores al otro lado est\[AAcute]n \
unidos a la otra terminal. Cuando los resistores est\[AAcute]n conectados en \
paralelo a una fuente de fem, el voltaje a trav\[EAcute]s de cada resistor es \
el mismo. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["V", "TI"], "1"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["V", "TI"], "2"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["V", "TI"], "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "V=V_1 =V_2=V_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "56c2edea-4355-4cfc-b57f-df8fdfa6d791"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.9549272845840073`*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"c2463874-842b-4ce6-b3b7-6c8bc1e30d43"],

Cell[TextData[{
 "La corriente el\[EAcute]ctrica se dividir\[AAcute] entre los resistores en \
proporci\[OAcute]n a sus resistencias que en general no ser\[AAcute]n \
iguales. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["I", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["I", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], "2"], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "I=I_1+I_2+I_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "01cba728-c868-446d-8716-eb7334866635"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.9549272947393703`*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"098c24ee-f2df-4bc1-9748-17655e90b688"],

Cell[TextData[{
 "La resistencia equivalente en paralelo ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["p", "TI"]], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(R_p)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6b8e06c0-ddb4-43dd-9b41-82fd0eb32673"],
 " es el valor de un solo resistor que podr\[IAcute]a reemplazar a todos los \
resistores y mantener la misma corriente en circuito. Entonces, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", 
          SubscriptBox[
           StyleBox["R", "TI"], 
           StyleBox["p", "TI"]]], "\[LongEqual]", 
         FractionBox["1", 
          SubscriptBox[
           StyleBox["R", "TI"], "1"]], "+", 
         FractionBox["1", 
          SubscriptBox[
           StyleBox["R", "TI"], "2"]], "+", 
         FractionBox["1", 
          SubscriptBox[
           StyleBox["R", "TI"], "3"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\frac{1}{R_p}=\\frac{1}{R_1}+\\frac{1}{R_2}+\\frac{1}{R_3}",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b995b8ff-802f-4a24-9f2d-93cb842e319c"],
 "  "
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.9549273137625217`*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"26917827-4537-44f1-99f6-6bfb53bdb3bc"],

Cell[BoxData[
 RowBox[{"Este", " ", "resultado", " ", "puede", " ", "generalizarse", " ", 
  "para", " ", "incluir", " ", "cualquier", " ", "n\[UAcute]mero", " ", "de", 
  " ", "resistores", " ", "en", " ", 
  RowBox[{"paralelo", ":", "\n", 
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          FractionBox["1", 
           SubscriptBox[
            StyleBox["R", "TI"], 
            StyleBox["p", "TI"]]], "\[LongEqual]", 
          FractionBox["1", 
           SubscriptBox[
            StyleBox["R", "TI"], "1"]], "+", 
          FractionBox["1", 
           SubscriptBox[
            StyleBox["R", "TI"], "2"]], "+", 
          FractionBox["1", 
           SubscriptBox[
            StyleBox["R", "TI"], "2"]], "+", 
          FractionBox["1", 
           SubscriptBox[
            StyleBox["R", "TI"], "3"]], "+", 
          FractionBox["1", 
           SubscriptBox[
            StyleBox["R", "TI"], "4"]], "+", ".."}], TraditionalForm], 
      "errors" -> {}, "input" -> 
      "\\frac{1}{R_p}=\\frac{1}{R_1}+\\frac{1}{R_2}+\\frac{1}{R_2}+\\frac{1}{\
R_3}+\\frac{1}{R_4}+..", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"],
    TraditionalForm]}]}]], "DisplayFormulaNumbered",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{
  3.9549273265526714`*^9, {3.954927473040394*^9, 3.9549274730413895`*^9}},
 TextAlignment->Center,
 Background->None,ExpressionUUID->"bce4dfba-7e7d-4a65-b19b-cb58cfee901f"],

Cell[TextData[{
 "Para el caso especial en que solo hay dos resistores, la resistencia \
equivalente puede expresarse en forma no rec\[IAcute]proca como, \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["p", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SubscriptBox[
             StyleBox["R", "TI"], "1"], 
            SubscriptBox[
             StyleBox["R", "TI"], "2"]}], 
          RowBox[{
            SubscriptBox[
             StyleBox["R", "TI"], "1"], "+", 
            SubscriptBox[
             StyleBox["R", "TI"], "2"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> "R_p=\\frac{R_1R_2}{R_1+R_2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "86244a01-aae4-4b38-b90c-16d465dc7cfa"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.954927336455675*^9},
 TextAlignment->Center,
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"41fa1ca2-b08c-413e-8f47-d6500e9a2969"],


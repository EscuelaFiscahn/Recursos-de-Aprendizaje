  0.87, 0.94, 1],ExpressionUUID->"4f28b8bc-4e4e-43e9-9299-81bbcb4f81ac"],

Cell[BoxData[
 InterpretationBox[
  DynamicModuleBox[{QuestionFramework`Private`input$$ = "", 
   QuestionFramework`Private`result$$ = "", 
   QuestionFramework`Private`buttonenabled$$ = True, 
   QuestionFramework`Private`submissionCount$$ = 0, 
   QuestionFramework`Private`submittedvalue$$ = "", 
   QuestionFramework`Private`qmflag$$ = False, 
   QuestionFramework`Private`explanationstate$$ = False, 
   QuestionFramework`Private`explanationrow$$ = Nothing}, 
   DynamicBox[ToBoxes[
    QuestionFramework`Private`$QuestionSubmissionContent[
      QuestionFramework`Private`input$$, 
       Hold[
        QuestionFramework`Private`postProcessAssessment[
         AssessmentFunction[{True -> <|"Score" -> 1|>}, <|
          "ListAssessment" -> "WholeList", "ComparisonMethod" -> 
           "Expression"|>, "Validated" -> True][
         QuestionFramework`Private`input$$, "SubmissionCount" -> 
          QuestionFramework`Private`submissionCount$$], <|
         "Choices" -> {True, False}, "MaxAnswers" -> 1, "MinAnswers" -> 1, 
          "Prompt" -> Cell[
            TextData[{
              StyleBox[
              "\[DownQuestion]Qu\[EAcute] suceder\[IAcute]a si una de las \
bombillas mostradas en la figura se funden? ", FontSlant -> "Italic"], 
              "Las dem\[AAcute]s bombillas seguir\[AAcute]n funcionando, \
porque el circuito sigue cerrado. Los circuitos dom\[EAcute]sticos se \
encuentran en una conexi\[OAcute]n en paralelo. Esto se debe a que cuando la \
conexi\[OAcute]n est\[AAcute] en paralelo, cada aparato dom\[EAcute]stico \
opera a pleno voltaje, y encender o apagar uno de ellos no afecta a los dem\
\[AAcute]s."}], "QuestionTemplateText"]|>]], 
       QuestionFramework`Private`submissionCount$$]; Framed[
       Grid[{{
          Framed[
           Style[
            DisplayForm[
             Cell[
              TextData[{
                StyleBox[
                "\[DownQuestion]Qu\[EAcute] suceder\[IAcute]a si una de las \
bombillas mostradas en la figura se funden? ", FontSlant -> "Italic"], 
                "Las dem\[AAcute]s bombillas seguir\[AAcute]n funcionando, \
porque el circuito sigue cerrado. Los circuitos dom\[EAcute]sticos se \
encuentran en una conexi\[OAcute]n en paralelo. Esto se debe a que cuando la \
conexi\[OAcute]n est\[AAcute] en paralelo, cada aparato dom\[EAcute]stico \
opera a pleno voltaje, y encender o apagar uno de ellos no afecta a los dem\
\[AAcute]s."}], "QuestionTemplateText"]], {
            FontSize -> 15, FontFamily -> "Source Sans Pro"}], 
           FrameMargins -> {{20, 20}, {12, 12}}, FrameStyle -> None], 
          SpanFromLeft}, {
          Framed[
           RadioButtonBar[
            Dynamic[QuestionFramework`Private`input$$], {
            True -> "True", False -> "False"}, Appearance -> "Vertical"], 
           Sequence[
           ContentPadding -> False, FrameMargins -> {{20, 20}, {12, 12}}, 
            Background -> GrayLevel[1], FrameStyle -> None]]}, {
          Row[{

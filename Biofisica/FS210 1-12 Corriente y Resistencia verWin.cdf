Cell[TextData[{
 "Cuando los resistores est\[AAcute]n en serie, la corriente debe ser la \
misma a trav\[EAcute]s de todos los resistores.   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["I", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["I", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], "2"], "+", 
         SubscriptBox[
          StyleBox["I", "TI"], "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "I=I_1 +I_2+I_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ebdae835-ff83-4dcd-8f74-5fae2416cda2"],
 "\nLa resistencia equivalente en serie  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["s", "TI"]], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(R_s)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9e14afe1-4e13-4f1f-96c7-901c1a931b82"],
 " es el valor de un solo resistor que podr\[IAcute]a reemplazar los tres \
resistores por un resistor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], 
        StyleBox["s", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "R_s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ea1c7039-959f-488d-95e5-b437f1cc89ba"],
 " y mantener la misma corriente, esto es: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["R", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["R", "TI"], "2"], "+", 
         SubscriptBox[
          StyleBox["R", "TI"], "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "R_s=R_1+R_2+R_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8980cec1-8e0e-4a21-8391-0571f696dbf0"],
 "\n\nObserve que la resistencia equivalente en serie es mayor que la \
resistencia del mayor resistor en la serie."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.9549270395650578`*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"aa851821-7e3b-4060-96c9-8fca72e7e04d"],

Cell[BoxData[
 RowBox[{"Esto", " ", "puede", " ", "ser", " ", "generalizado", " ", "a", " ",
   "m\[AAcute]s", " ", "de", " ", "3", " ", "resistencias", " ", 
  RowBox[{"como", ":", " ", "\n", 
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          SubscriptBox[
           StyleBox["R", "TI"], 
           StyleBox["s", "TI"]], "\[LongEqual]", 
          SubscriptBox[
           StyleBox["R", "TI"], "1"], "+", 
          SubscriptBox[
           StyleBox["R", "TI"], "2"], "+", 
          SubscriptBox[
           StyleBox["R", "TI"], "3"], "+", 
          SubscriptBox[
           StyleBox["R", "TI"], "4"], "+", "..."}], TraditionalForm], 
      "errors" -> {}, "input" -> "R_s=R_1+R_2+R_3+R_4+ ...", "state" -> 
      "Boxes"|>,
     "TeXAssistantTemplate"],
    TraditionalForm]}]}]], "DisplayFormulaNumbered",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{
  3.9549270571694775`*^9, {3.954949355448759*^9, 3.9549493554497566`*^9}},
 TextAlignment->Center,
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"1d365ff5-061e-4779-be7b-7bdeec1ebea8"],

Cell[TextData[{
 "En las conexiones en serie, cada resistor opera a un voltaje menor que el \
de la bater\[IAcute]a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         StyleBox["V", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(V)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f16c424f-f0e2-43ea-a83f-c7361f95d404"],
 ".\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["V", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["V", "TI"], "2"], "+", 
         SubscriptBox[
          StyleBox["V", "TI"], "3"], "+", ".."}], TraditionalForm], 
     "errors" -> {}, "input" -> "V=V_1+V_2+V_3+..", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2b354e45-356e-486c-ab34-9788432b4659"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.9549270716433716`*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"1d038493-e972-4d88-a32e-cb33fd1bd214"],


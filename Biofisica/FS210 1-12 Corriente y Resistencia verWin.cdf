Cell[TextData[{
 "La resistencia de un objeto est\[AAcute] determinada parcialmente por las \
propiedades at\[OAcute]micas del material que lo constituye, descritas \
cuantitativamente por la resistividad ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", "\[Rho]", ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(\\rho)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "60b48728-ba9c-43a5-acf6-83f096fed00c"],
 " del material. La resistencia de un objeto de secci\[OAcute]n transversal \
uniforme est\[AAcute] dada por:"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.952624662502554*^9, 3.95262466498106*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"5b3adce7-061c-4f5f-87e8-063408a815af"],

Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        StyleBox["R", "TI"], "\[LongEqual]", "\[Rho]", 
        RowBox[{"(", 
          FractionBox[
           StyleBox["L", "TI"], 
           StyleBox["A", "TI"]], ")"}]}], TraditionalForm], "errors" -> {}, 
    "input" -> "R =\\rho (\\frac{L}{A})", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{3.9526246776170654`*^9},
 TextAlignment->Center,ExpressionUUID->"6f3e2006-62ba-4902-86d0-899e9922b51a"],

Cell[TextData[{
 "Unidad SI de resistividad: ohm-metro ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{"\[CapitalOmega]", "\[CenterDot]", 
           StyleBox["m", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(\\Omega \\cdot m)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6121869e-b614-46a5-a8af-79b3882395fb"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.952624741339733*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"ff9a3892-6792-4be1-837a-701480064ae2"],


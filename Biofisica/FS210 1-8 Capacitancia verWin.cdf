Cell[CellGroupData[{

Cell["1-8 Capacitancia", "Section",
 CellFrame->{{3, 0}, {0, 0.5}},
 CellFrameColor->RGBColor[0, 0, 1],
 CellChangeTimes->{{3.935515845683177*^9, 3.935515849943137*^9}, {
   3.9356999575611343`*^9, 3.9356999632170334`*^9}, {3.939294636528504*^9, 
   3.939294642762233*^9}, {3.951589140619224*^9, 3.951589142010891*^9}, {
   3.951669940033366*^9, 3.9516699478229322`*^9}, {3.951670332399876*^9, 
   3.951670332931019*^9}, 3.960547930283841*^9, {3.969476521475095*^9, 
   3.969476526032505*^9}, {3.969476984571576*^9, 3.969477019166314*^9}, {
   3.96947709665718*^9, 3.969477097773543*^9}, {3.969477153094746*^9, 
   3.969477166124802*^9}, {3.96947722219353*^9, 3.9694772608754168`*^9}, {
   3.969477308863863*^9, 3.969477312848734*^9}, {3.969477347178466*^9, 
   3.969477354942912*^9}},
 FontFamily->"Times New Roman",
 FontColor->GrayLevel[0],
 Background->RGBColor[
  1., 1., 0.],ExpressionUUID->"309ec702-105d-49cd-8f25-1e1ece0e1f93"],

Cell["\<\
Objetivo:
a) Definir capacitancia y explicar lo que significa f\[IAcute]sicamente y
b) calcular la carga, el voltaje, el campo el\[EAcute]ctrico y el \
almacenamiento de energ\[IAcute]a en condensadores de placas paralelas.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9549523112738476`*^9, 3.9549523274195976`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"dba352af-53e0-f442-bc68-bb70b5e55753"],

Cell[TextData[{
 "La superficie de cualquier cuerpo cargado o electrizado se encuentra  a un \
determinado potencial, de tal modo que si se duplica la carga tambi\[EAcute]n \
se duplica el potencial, de tal manera que podemos escribir:  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Q", "TI"], "\[LongEqual]", 
         StyleBox["C", "TI"], 
         StyleBox["V", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "Q=CV", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a55df5f6-7f81-084b-8e5a-d24a4d68969b"],
 "\ndonde la constante de proporcionalidad ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["C", "TI"], TraditionalForm], "errors" -> {}, "input" -> "C", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd6e04c7-636a-554e-9b8b-5731d5b9016b"],
 " es una nueva propiedad el\[EAcute]ctrica de los cuerpos que se denomina \
capacitancia, y se define como la relaci\[OAcute]n constante entre la carga \
almacenada por un cuerpo y el potencial de su superficie:"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.952521370212473*^9, 3.95252140571134*^9}, {
  3.9525216136412086`*^9, 3.9525216510411854`*^9}, {3.952622213063238*^9, 
  3.952622217932169*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"75a3cd6d-4fe3-784a-af4d-5ad718bac759"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["C", "TI"], "\[LongEqual]", 
       FractionBox[
        StyleBox["Q", "TI"], 
        StyleBox["V", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
   "C=\\frac{Q}{V}", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9525216893815956`*^9, 3.9525218079507065`*^9}, {
   3.9525218475410233`*^9, 3.9525218484813423`*^9}, 3.952622081685772*^9, 
   3.952622968873356*^9},
 TextAlignment->Center,ExpressionUUID->"52cf4a7b-67ec-fc46-8cf2-4e852e9b40b5"],

Cell[TextData[{
 "La capacitancia ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["C", "TI"], TraditionalForm], "errors" -> {}, "input" -> "C", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3cb5744f-840b-e14c-8280-cdb6f4682bac"],
 " es medida en Faradio (F) que es una unidad muy grande y es muy \
com\[UAcute]n utilizarla el ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Mu]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a8c06ed9-50d3-ab4b-9e69-c801ae527616"],
 "F o el pF.\n\nLos dispositivos destinados a almacenar cargas \
el\[EAcute]ctricas se denominan condensadores o capacitores. Un condensador \
plano esta constituido por dos planchas met\[AAcute]licas separadas por una l\
\[AAcute]mina de material diel\[EAcute]ctrico. La capacidad del condensador \
plano est\[AAcute] dada por:"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.952622243821621*^9, 3.9526223811753464`*^9}, {

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["C", "TI"], "\[LongEqual]", 
       FractionBox[
        RowBox[{
          StyleBox["k", "TI"], 
          SubscriptBox["\[Epsilon]", 
           StyleBox["o", "TI"]], 
          StyleBox["A", "TI"]}], 
        StyleBox["d", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
   "C=\\frac{k\\epsilon_o A}{d}", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.952521860281126*^9, 3.9525220670103474`*^9}, 
   3.9526222969946804`*^9, {3.9526225074372597`*^9, 3.952622507955681*^9}, 
   3.9526229657904377`*^9},
 TextAlignment->Center,ExpressionUUID->"7df573e2-234c-7d48-8377-55e23cfc72b3"],

Cell[TextData[{
 "Donde:  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> "A", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1bc4cb57-27b2-5344-b40b-90595908f6a5"],
 " es el \[AAcute]rea de cada placa en unidades de ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m",
     FontSlant->"Plain"], 
    TemplateBox[<|"boxes" -> FormBox[
        SuperscriptBox["\[Null]", "2"], TraditionalForm], "errors" -> {}, 
      "input" -> "^2", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"]}], TraditionalForm]],ExpressionUUID->
  "7cc2ee66-13c7-854f-be41-5cd2ed803798"],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["d", "TI"], TraditionalForm], "errors" -> {}, "input" -> "d", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "702f29fd-9942-dc4f-94a2-0d23ba7cbad7"],
 " es la distancia entre las placas en unidades de ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m",
     FontSlant->"Plain"], 
    TemplateBox[<|"boxes" -> FormBox[
        SuperscriptBox["\[Null]", "2"], TraditionalForm], "errors" -> {}, 
      "input" -> "^2", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"]}], TraditionalForm]],ExpressionUUID->
  "f7b96da6-56c1-8444-b222-992804f82f97"],
 "."
}], "Text",

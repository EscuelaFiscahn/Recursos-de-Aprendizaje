Cell[TextData[Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
   "Cuando", " ", "un", " ", "condensador", " ", "esta", " ", "cargado"}], 
   ",", " ", 
   RowBox[{
   "sus", " ", "placas", " ", "tienen", " ", "cargas", " ", "iguales", " ", 
    "y", " ", "opuestas", " ", 
    FormBox[
     TemplateBox[<|"boxes" -> FormBox[
         RowBox[{"+", 
           StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
       "+q", "state" -> "Boxes"|>,
      "TeXAssistantTemplate"],
     TraditionalForm], " ", "y", " ", 
    RowBox[{
     FormBox[
      TemplateBox[<|"boxes" -> FormBox[
          RowBox[{"-", 
            StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
        "-q", "state" -> "Boxes"|>,
       "TeXAssistantTemplate"],
      TraditionalForm], ".", " ", "Sin"}], " ", "embargo", " ", "nos", " ", 
    "referimos", " ", "a", " ", "la", " ", "carga", " ", "del", " ", 
    "condensador", " ", "como", " ", 
    FormBox[
     TemplateBox[<|"boxes" -> FormBox[
         StyleBox["q", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
       "q", "state" -> "Boxes"|>,
      "TeXAssistantTemplate"],
     TraditionalForm]}], ",", " ", 
   RowBox[{
   "que", " ", "es", " ", "el", " ", "valor", " ", "absoluto", " ", "de", " ",
     "las", " ", "cargas", " ", "en", " ", "las", " ", 
    RowBox[{"placas", ".", "  ", "La"}], " ", "energ\[IAcute]a", " ", 
    "necesaria", " ", "para", " ", "cargar", " ", "un", " ", "condensador", 
    " ", "de", " ", "capacidad", " ", 
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["C", "TI"], TraditionalForm], "errors" -> {}, "input" -> "C",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "con", " ", "una", " ", "carga", " ", 
    FormBox[
     TemplateBox[<|"boxes" -> FormBox[
         StyleBox["Q", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
       "Q", "state" -> "Boxes"|>,
      "TeXAssistantTemplate"],
     TraditionalForm], " ", 
    RowBox[{"es", ":"}]}]}], 
  "Text"]],ExpressionUUID->"2e97188e-420a-9d43-aefc-a530e38e3006"]], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9526229080995884`*^9, 3.9526229324861603`*^9}, {
  3.9549324470100536`*^9, 3.954932453536604*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"640bf97e-0cb3-4745-b6d0-21b4a04415fb"],

Cell[BoxData[
 RowBox[{
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        StyleBox["U", "TI"], "\[LongEqual]", 
        FractionBox["1", "2"], 
        StyleBox["C", "TI"], 
        SuperscriptBox[
         StyleBox["V", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
    "input" -> "U=\\frac{1}{2}CV^2", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], "  "}]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9525224911903324`*^9, 3.9525226417400856`*^9}, {
   3.952522693710228*^9, 3.9525227050801105`*^9}, 3.952622903382702*^9, 
   3.952622962530201*^9},
 TextAlignment->Center,ExpressionUUID->"a8fff29d-08bc-cc4d-a6ae-01179d0de7e2"],

Cell["\<\
Esta simulaci\[OAcute]n interactiva modela un condensador de placas paralelas \
como an\[AAcute]logo de una membrana celular, permitiendo a los usuarios \
ajustar par\[AAcute]metros clave: la carga de las placas (Q, en \[Micro]C), \
la distancia entre ellas (d, en metros), la carga del punto de prueba (q, en \
nC) y su posici\[OAcute]n vertical dentro del campo. Se explora el impacto de \
diferentes materiales diel\[EAcute]ctricos biol\[OAcute]gicos (aire: \
\[Kappa]=1, membrana celular: \[Kappa]\[TildeTilde]3, prote\[IAcute]nas \
secas: \[Kappa]\[TildeTilde]4, citoplasma: \[Kappa]\[TildeTilde]75) en el \
sistema. El campo el\[EAcute]ctrico uniforme (E), el potencial electrost\
\[AAcute]tico (\[CapitalDelta]V), la capacitancia (C) y la energ\[IAcute]a \
almacenada (Uc) se visualizan en tiempo real. El modelo ilustra c\[OAcute]mo \
la presencia de un diel\[EAcute]ctrico reduce el campo el\[EAcute]ctrico y \
aumenta la capacitancia seg\[UAcute]n la relaci\[OAcute]n C = \
Sub\[IAcute]ndice[\[Kappa]\[CurlyEpsilon], 0]A/d, mientras que la energ\
\[IAcute]a del capacitor permanece Sub\[IAcute]ndice[U, c] = \
C(\[CapitalDelta]V)^2/2. Aplicable en biof\[IAcute]sica, demuestra la \
interacci\[OAcute]n de iones con membranas, el papel del citoplasma como \
aislante y la generaci\[OAcute]n de potenciales transmembrana. Resulta ideal \
para comprender fen\[OAcute]menos electrost\[AAcute]ticos en contextos biol\
\[OAcute]gicos mediante la manipulaci\[OAcute]n directa de variables f\
\[IAcute]sicas.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9549523112738476`*^9, 3.9549523274195976`*^9}, 
   3.969477634457045*^9, 3.969477665295034*^9},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"058f9635-e4e8-45ed-baad-de083e4236c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "placaSuperior", ",", "placaInferior", ",", "campoElectrico", ",", 
       "simbolosPositivos", ",", "simbolosNegativos", ",", "Efield", ",", 
       "cargaPuntual", ",", "margen", ",", "deltaUe", ",", "deltaV", ",", 
       "capacitancia", ",", "energiaCapacitor", ",", "distanciaReferencia", ",",
        "etiquetas", ",", "kappa", ",", "colorFondo", ",", "fondoGraphics"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"margen", "=", "0.1"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kappa", ",", "colorFondo"}], "}"}], "=", 
       RowBox[{"Switch", "[", 
        RowBox[{"material", ",", "\"\<Air\>\"", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "White"}], "}"}], ",", "\"\<Cell membrane\>\"", ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", 
           RowBox[{"RGBColor", "[", 
            RowBox[{"0.87", ",", "0.92", ",", "1"}], "]"}]}], "}"}], 
         ",", "\"\<Proteins (dry)\>\"", ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", 
           RowBox[{"RGBColor", "[", 
            RowBox[{"0.95", ",", "0.85", ",", "0.95"}], "]"}]}], "}"}], 
         ",", "\"\<Cytoplasm\>\"", ",", 
         RowBox[{"{", 
          RowBox[{"75", ",", 
           RowBox[{"RGBColor", "[", 
            RowBox[{"0.85", ",", "0.95", ",", "0.85"}], "]"}]}], "}"}], ",", 
         "_", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "White"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"k", "=", 
       RowBox[{"8.99", "*", 
        RowBox[{"10", "^", "9"}]}]}], ";", 
      RowBox[{"A", "=", "1.0"}], ";", 
      RowBox[{"epsilon0", "=", 
       RowBox[{"8.85", "*", 
        RowBox[{"10", "^", 
         RowBox[{"-", "12"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Campo", " ", "el\[EAcute]ctrico"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Efield", "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"4", "*", "Pi", "*", "k", "*", 
             RowBox[{"(", 
              RowBox[{"Q", "*", 
               RowBox[{"10", "^", 
                RowBox[{"-", "6"}]}]}], ")"}]}], ")"}], "/", "A"}], ")"}]}], "/",
         "kappa"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"distanciaReferencia", "=", 
       RowBox[{"posicionCarga", "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "distanciaPlacas"}], "/", "2"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"deltaUe", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"qPuntual", "*", 
          RowBox[{"10", "^", 
           RowBox[{"-", "9"}]}]}], ")"}], "*", "Efield", "*", 
        "distanciaReferencia"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"deltaV", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"qPuntual", "!=", "0"}], ",", 
         RowBox[{"deltaUe", "/", 
          RowBox[{"(", 
           RowBox[{"qPuntual", "*", 
            RowBox[{"10", "^", 
             RowBox[{"-", "9"}]}]}], ")"}]}], ",", "0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"capacitancia", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"kappa", "*", "epsilon0", "*", "A"}], ")"}], "/", 
        "distanciaPlacas"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"energiaCapacitor", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"Q", "*", 
          RowBox[{"10", "^", 
           RowBox[{"-", "6"}]}]}], ")"}], "*", "deltaV"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fondoGraphics", "=", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{"colorFondo", ",", 
          RowBox[{"Rectangle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1.5"}], ",", 
              RowBox[{
               RowBox[{"-", "distanciaPlacas"}], "/", "2"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1.5", ",", 
              RowBox[{"distanciaPlacas", "/", "2"}]}], "}"}]}], "]"}]}], 
         "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Q", ">=", "0"}], ",", 
        RowBox[{
         RowBox[{"placaSuperior", "=", 
          RowBox[{"Graphics", "[", 
           RowBox[{"{", 
            RowBox[{"Red", ",", 
             RowBox[{"Thickness", "[", "0.05", "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{"distanciaPlacas", "/", "2"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"distanciaPlacas", "/", "2"}]}], "}"}]}], "}"}], 
              "]"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"placaInferior", "=", 
          RowBox[{"Graphics", "[", 
           RowBox[{"{", 
            RowBox[{"Blue", ",", 
             RowBox[{"Thickness", "[", "0.05", "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{
                   RowBox[{"-", "distanciaPlacas"}], "/", "2"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{
                   RowBox[{"-", "distanciaPlacas"}], "/", "2"}]}], "}"}]}], 
               "}"}], "]"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"simbolosPositivos", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Text", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<+\>\"", ",", "Bold", ",", "30", ",", "White"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", 
                RowBox[{"distanciaPlacas", "/", "2"}]}], "}"}]}], "]"}], ",", 
            
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"-", "0.9"}], ",", "0.9", ",", "0.3"}], "}"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"simbolosNegativos", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Text", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<-\>\"", ",", "Bold", ",", "30", ",", "White"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", 
                RowBox[{
                 RowBox[{"-", "distanciaPlacas"}], "/", "2"}]}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"-", "0.9"}], ",", "0.9", ",", "0.3"}], "}"}]}], 
           "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"placaSuperior", "=", 
          RowBox[{"Graphics", "[", 
           RowBox[{"{", 
            RowBox[{"Blue", ",", 
             RowBox[{"Thickness", "[", "0.05", "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{"distanciaPlacas", "/", "2"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"distanciaPlacas", "/", "2"}]}], "}"}]}], "}"}], 
              "]"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"placaInferior", "=", 
          RowBox[{"Graphics", "[", 
           RowBox[{"{", 
            RowBox[{"Red", ",", 
             RowBox[{"Thickness", "[", "0.05", "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{
                   RowBox[{"-", "distanciaPlacas"}], "/", "2"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{
                   RowBox[{"-", "distanciaPlacas"}], "/", "2"}]}], "}"}]}], 
               "}"}], "]"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"simbolosPositivos", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Text", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<+\>\"", ",", "Bold", ",", "30", ",", "White"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", 
                RowBox[{
                 RowBox[{"-", "distanciaPlacas"}], "/", "2"}]}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"-", "0.9"}], ",", "0.9", ",", "0.3"}], "}"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"simbolosNegativos", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Text", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<-\>\"", ",", "Bold", ",", "30", ",", "White"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", 
                RowBox[{"distanciaPlacas", "/", "2"}]}], "}"}]}], "]"}], ",", 
            
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"-", "0.9"}], ",", "0.9", ",", "0.3"}], "}"}]}], 
           "]"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"cargaPuntual", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"qPuntual", "!=", "0"}], ",", 
         RowBox[{"Graphics", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"qPuntual", ">", "0"}], ",", "Red", ",", "Blue"}], 
             "]"}], ",", 
            RowBox[{"PointSize", "[", "0.05", "]"}], ",", 
            RowBox[{"Point", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", "posicionCarga"}], "}"}], "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Graphics", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"campoElectrico", "=", 
       RowBox[{"VectorPlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", "y", "]"}], "<=", 
              RowBox[{"distanciaPlacas", "/", "2"}]}], ",", "Efield", ",", 
             "0"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "distanciaPlacas"}], "/", "2"}], "-", "0.5"}], ",", 
           
           RowBox[{

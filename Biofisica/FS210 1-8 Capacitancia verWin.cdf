Cell[TextData[{
 "En general, la capacitancia depende de la geometr\[IAcute]a del condensador \
y de la constante diel\[EAcute]ctrica ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5a5c96bc-eb59-f042-9cc6-28545479e273"],
 " del medio material entre las placas. \n\nLas membranas celulares se \
comportan como condensadores: sus caras exterior e interior se hallan a \
diferente potencial, y sobre su superficie se almacenan cargas de diferente \
signo y procedencia. Dichos potenciales de membrana tienen importancia \
decisiva en muchos fen\[OAcute]menos biol\[OAcute]gicos a escala celular. "
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9525221139504585`*^9, 3.9525221489010124`*^9}, {
   3.952522378262596*^9, 3.952522471240881*^9}, {3.9549324721108456`*^9, 
   3.954932475401552*^9}, 3.9776823093651648`*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"260fac64-f3ce-a846-8152-24f3df3181d3"],


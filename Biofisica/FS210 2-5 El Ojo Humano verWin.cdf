Cell[TextData[{
 StyleBox["Hipermetrop\[IAcute]a",
  FontWeight->"Bold"],
 " ",
 StyleBox["(visi\[OAcute]n Larga):\n",
  FontWeight->"Bold"],
 "\nLas personas con hipermetrop\[IAcute]a ven claramente los objetos \
distantes, pero tienen dificultad para enfocar los objetos cercanos. El punto \
cercano, la distancia m\[AAcute]s cercana a la que se puede enfocar \
claramente, est\[AAcute] m\[AAcute]s lejos de lo normal, los rayos de luz de \
los objetos cercanos se enfocan detr\[AAcute]s de la retina.\n\n",
 StyleBox["Causas:",
  FontWeight->"Bold"],
 "\n\nGlobo ocular demasiado corto (achatado).\nCurvatura insuficiente de la \
c\[OAcute]rnea.\nPerdida de elasticidad del cristalino (Presbicia)\n\n",
 StyleBox["Correcci\[OAcute]n",
  FontWeight->"Bold"],
 ": \n\nLentes convergentes que ayudan a enfocar los rayos de luz en la \
retina. Tambi\[EAcute]n se utilizan para corregir la presbicia, que es la p\
\[EAcute]rdida de la capacidad de enfocar objetos cercanos debido a la \
rigidez del cristalino relacionada con la edad."
}], "Text",
 CellChangeTimes->{{3.954095714060224*^9, 3.954095869452855*^9}, {
  3.954095993933825*^9, 3.9540960056295013`*^9}, {3.9540960366241293`*^9, 
  3.9540960948215847`*^9}, {3.954930916807561*^9, 3.954930921376032*^9}, {
  3.9817285762465897`*^9, 3.981728600285248*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"0cdc17d9-5008-c042-b5db-4e542c3b2e47"],

Cell[TextData[{
 StyleBox["WOLFRAM DEMONSTRATIONS\n\n",
  FontWeight->"Bold"],
 "Esta demostraci\[OAcute]n muestra la hipermetr\[IAcute]a y la correcci\
\[OAcute]n con lentes."
}], "Text",
 CellChangeTimes->{{3.9413077236259212`*^9, 3.9413077317156353`*^9}, {

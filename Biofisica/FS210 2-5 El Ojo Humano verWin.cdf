Cell[TextData[{
 StyleBox["Anatom\[IAcute]a del ojo, una descripci\[OAcute]n m\[AAcute]s \
realista\n",
  FontWeight->"Bold"],
 "\[LineSeparator]",
 StyleBox["Instrucciones",
  FontSlant->"Italic"],
 ": Haga clic en las casillas de verificaci\[OAcute]n para visualizar las \
distintas partes del ojo. Podr\[AAcute] visualizar algunas de las partes del \
ojo en forma individual."
}], "Text",

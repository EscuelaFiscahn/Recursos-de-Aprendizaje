Cell[TextData[Cell[BoxData[
 PaneBox[
  StyleBox[
   RowBox[{"Reacciones", " ", "RedOx"}], "Subsubsection",
   ShowStringCharacters->False],
  ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
 Background->
  None,ExpressionUUID->"980c96f7-fa66-6144-9622-aeefa542d053"]], "Subsection",\

 CellChangeTimes->{
  3.984346754622055*^9, {3.9923718433724174`*^9, 
   3.9923718468161907`*^9}},ExpressionUUID->"2180b041-cb5b-334c-b0c5-\
17ebe70d54ed"],

Cell["\<\
En la interacci\[OAcute]n de las radiaciones con los tejidos vivos, suelen \
estar presentes las reacciones de Oxidaci\[OAcute]n y Reducci\[OAcute]n \
(RedOx) las cuales, posteriormente, tienen un impacto biol\[OAcute]gico \
importante.\
\>", "Text",
 CellChangeTimes->{{3.946578547563545*^9, 3.946578570864743*^9}, 
   3.9539926880385723`*^9, {3.953993167714464*^9, 3.953993202776102*^9}, {

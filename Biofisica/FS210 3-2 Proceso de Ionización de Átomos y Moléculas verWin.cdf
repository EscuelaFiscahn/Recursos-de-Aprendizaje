Cell["\<\
Puede ocurrir por diferentes medios:

- Radiaci\[OAcute]n electromagn\[EAcute]tica de alta energ\[IAcute]a (como \
rayos X o UV)
- Altas temperaturas
- Choques entre part\[IAcute]culas
- Reacciones qu\[IAcute]micas\
\>", "Text",
 CellChangeTimes->{{3.946578547563545*^9, 3.946578570864743*^9}, 
   3.9539926880385723`*^9, {3.953993167714464*^9, 3.953993202776102*^9}, {
   3.9539935750155525`*^9, 3.95399358874074*^9}, {3.984347162708767*^9, 
   3.9843471734299145`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"22c7d453-a548-6348-9ee6-21b91348daa4"]
}, Open  ]],


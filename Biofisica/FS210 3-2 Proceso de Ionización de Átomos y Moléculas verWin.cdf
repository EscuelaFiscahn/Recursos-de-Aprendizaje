Cell[TextData[{
 "Un \[AAcute]tomo est\[AAcute] formado por protones (positivos), neutrones \
(neutros) y electrones (negativos). \n\nEn estado neutro, tiene igual \
cantidad de protones y electrones. \n\nPero si pierde o gana electrones, \
cambia su carga:\n\n",
 StyleBox["Si pierde electrones ",
  FontWeight->"Bold"],
 "\[RightArrow] se convierte en un ",
 StyleBox["cati\[OAcute]n",
  FontWeight->"Bold"],
 " (ion positivo).\n\n",
 StyleBox["Si gana electrones",
  FontWeight->"Bold"],
 " \[RightArrow] se convierte en un ",
 StyleBox["ani\[OAcute]n",
  FontWeight->"Bold"],
 " (ion negativo)."
}], "Text",
 CellChangeTimes->{{3.946578547563545*^9, 3.946578570864743*^9}, 
   3.9539926880385723`*^9, {3.953993167714464*^9, 3.95399317066333*^9}, 
   3.953993341786993*^9, {3.953993395866539*^9, 3.9539934058654213`*^9}, {
   3.9843470986012363`*^9, 3.9843471307800617`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"027257e2-2dc4-a64e-830b-63cdabaaff5b"],


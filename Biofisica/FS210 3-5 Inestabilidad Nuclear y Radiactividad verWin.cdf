Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SubsuperscriptBox["\[Null]", 
        StyleBox["Z", "TI"], 
        StyleBox["A", "TI"]], 
       SubscriptBox[
        StyleBox["X", "TI"], 
        StyleBox["N", "TI"]], " ", "\[LongRightArrow] ", 
       SubsuperscriptBox["\[Null]", 
        RowBox[{
          StyleBox["Z", "TI"], "-", "2"}], 
        RowBox[{
          StyleBox["A", "TI"], "-", "4"}]], 
       SubscriptBox[
        StyleBox["Y", "TI"], 
        RowBox[{
          StyleBox["N", "TI"], "-", "2"}]], " ", "+ ", "\[Alpha]"}], 
     TraditionalForm], "errors" -> {}, "input" -> 
   "^A_Z X_N\\, \\longrightarrow \\, {} ^{A - 4} _ {Z - \n\n   2} Y_ {N - 2}  \

Cell[TextData[{
 StyleBox["2. Conservaci\[OAcute]n de la Energ\[IAcute]a ",
  FontWeight->"Bold"],
 "\n\nMisma energ\[IAcute]a mec\[AAcute]nica total antes y despu\[EAcute]s \
del decaimiento. Esencialmente se consideran la energ\[IAcute]a \
cin\[EAcute]tica de la part\[IAcute]cula emitida y la energ\[IAcute]a en \
reposo del sistema.\n\nLa energ\[IAcute]a en reposo se calcula mediante la \
expresi\[OAcute]n propuesta por Einstein:"
}], "Text",

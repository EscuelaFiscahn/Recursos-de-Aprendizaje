Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["n", "TI"], "\[Rule]", 
       StyleBox["p", "TI"], "+", 
       SuperscriptBox[
        StyleBox["e", "TI"], "-"]}], TraditionalForm], "errors" -> {}, 

Cell[TextData[{
 StyleBox["1. Conservaci\[OAcute]n del n\[UAcute]mero bari\[OAcute]nico:",
  FontWeight->"Bold"],
 "\n\nMismo n\[UAcute]mero de nucleones antes y despu\[EAcute]s del \
decaimiento. La cantidad de nucleones debe conservarse en cualquier reacci\
\[OAcute]n."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},

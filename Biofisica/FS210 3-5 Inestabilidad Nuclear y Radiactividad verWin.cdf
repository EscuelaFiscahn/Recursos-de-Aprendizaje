   RowBox[{
   "Eliminar", " ", "entradas", " ", "con", " ", "valores", " ", "Missing"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"allData", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"allData", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"NumericQ", "[", 

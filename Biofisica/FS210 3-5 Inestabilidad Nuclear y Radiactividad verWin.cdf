Cell[TextData[{
 StyleBox["3. Conservaci\[OAcute]n del momento lineal ",
  FontWeight->"Bold"],
 "\n\nEn decaimiento radiactivo es posible despreciar el momento lineal del n\
\[UAcute]cleo hijo. Para fines pr\[AAcute]cticos, el cantidad de movimiento \
es establecida por la part\[IAcute]cula emitida y tambi\[EAcute]n se puede \
despreciar la cantidad de momento lineal del n\[UAcute]cleo hijo."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.946578547563545*^9, 3.946578570864743*^9}, 

   3.954017219259508*^9}},ExpressionUUID->"4ac97051-f37f-dd4c-a923-\
f8b17b50e0e6"],

Cell[TextData[{
 "Consiste en la emisi\[OAcute]n de un fot\[OAcute]n, el cual es considerado \
energ\[IAcute]a pura ya que no posee ni carga ni masa. Esto sucede cuando el \
n\[UAcute]cleo padre se encuentra en un estado excitado y normalmente \
denominado un estado metaestable (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Null]", 
          StyleBox["Z", "TI"], 
          StyleBox["A", "TI"]], 
         SubsuperscriptBox[
          StyleBox["X", "TI"], 
          StyleBox["N", "TI"], "*"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "^A_ZX^*_N", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6d4dda7a-87ec-1547-8608-c77efbfa91e7"],
 ")."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.946578547563545*^9, 3.946578570864743*^9}, 
   3.9539926880385723`*^9, {3.953993167714464*^9, 3.953993202776102*^9}, {

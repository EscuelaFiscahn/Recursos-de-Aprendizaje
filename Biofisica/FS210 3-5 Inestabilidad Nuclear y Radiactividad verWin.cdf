  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Datos", " ", "de", " ", "is\[OAcute]topos", " ", "inestables", " ", 
    RowBox[{"(", 
     RowBox[{
     "los", " ", "que", " ", "est\[AAcute]n", " ", "en", " ", "allData", " ", 
      "pero", " ", "no", " ", "en", " ", "stableData"}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"unstableData", "=", 
    RowBox[{"Complement", "[", 
     RowBox[{"allData", ",", "stableData"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"stableData", ",", "unstableData"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 

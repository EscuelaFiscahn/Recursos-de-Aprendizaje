    "Funci\[OAcute]n", " ", "para", " ", "crear", " ", "la", " ", "red", " ", 
     "de", " ", "decaimiento"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DecayNetwork", "[", "iso_List", "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Apply", "[", 
     RowBox[{"Join", ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{"#", "->", 
           RowBox[{"DaughterNuclides", "[", 
            RowBox[{"{", "#", "}"}], "]"}]}], "]"}], " ", "&"}], ",", 
        RowBox[{"ReachableNuclides", "[", "iso", "]"}]}], "]"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 

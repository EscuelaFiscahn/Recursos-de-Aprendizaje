Cell[TextData[{
 "Consiste en la emisi\[OAcute]n de un n\[UAcute]cleo de Helio (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Null]", "2", "4"], 
         SubscriptBox[
          StyleBox["H", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "^4_2 H_{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "972bb9ec-6bc0-5343-84ac-31e234abe84c"],
 "), el cual es designado como part\[IAcute]cula alfa."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.946578547563545*^9, 3.946578570864743*^9}, 

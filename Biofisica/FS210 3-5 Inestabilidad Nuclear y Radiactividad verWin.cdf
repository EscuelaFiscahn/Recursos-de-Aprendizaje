Cell[TextData[{
 "Consideraciones de seguridad\n\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  StyleBox["Monitoreo:",
   FontWeight->Bold],
  " Uso de detectores de radiaci\[OAcute]n para medir niveles de exposici\
\[OAcute]n."
 }], "InlineItem",ExpressionUUID->"0baca05d-84ce-fb4c-9e58-8b432224c98d"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  StyleBox["Pr\[AAcute]cticas Seguras:",
   FontWeight->Bold],
  " Manejo adecuado y almacenamiento seguro de materiales radiactivos."
 }], "InlineItem",ExpressionUUID->"5ee1455f-bc13-a441-ab04-19decaf8f08f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  StyleBox["Protecci\[OAcute]n Personal:",
   FontWeight->Bold],
  " Uso de equipo de protecci\[OAcute]n personal (EPP) cuando sea necesario."
 }], "InlineItem",ExpressionUUID->"bf13cf27-b281-a444-b73f-adc044f725f9"],
 "\n\nLa radiaci\[OAcute]n se utiliza en diagn\[OAcute]sticos (por ejemplo, \
rayos X) y tratamientos (como la radioterapia) en medicina. La correcta \
aplicaci\[OAcute]n y manejo seguro de la radiaci\[OAcute]n permiten maximizar \
los beneficios terap\[EAcute]uticos al tiempo que minimizan los riesgos para \
pacientes y personal m\[EAcute]dico. \n\nLa comprensi\[OAcute]n de la \
inestabilidad nuclear, los tipos de radiaci\[OAcute]n, sus aplicaciones y el \
blindaje adecuado es esencial para aprovechar los beneficios de la radiaci\
\[OAcute]n en la medicina, garantizando siempre la seguridad de las personas \
involucradas."
}], "Text",
 CellChangeTimes->{{3.9843524803249493`*^9, 3.9843525234284267`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"b2c747c4-bd88-414b-90df-9127bb439f78"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Define", " ", "los", " ", "par\[AAcute]metros", " ", "de", " ", "la", " ",
     "animaci\[OAcute]n"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"frames", "=", "50"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alphaPath", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1", ",", 
         RowBox[{"1", "/", "frames"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Crear", " ", "la", " ", "animaci\[OAcute]n"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"animation", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", "     ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Dibujar", " ", "la", " ", "hoja", " ", "de", " ", "papel"}], " ", 
           "*)"}], "\[IndentingNewLine]", "     ", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Rectangle", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0.8", ",", 
                 RowBox[{"-", "0.2"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "0.2"}], "}"}]}], "]"}], ",", 
             "LightBrown"}], "]"}], ",", "\[IndentingNewLine]", "     ", 
           "\[IndentingNewLine]", "     ", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Dibujar", " ", "la", " ", "part\[IAcute]cula", " ", "alfa"}], 
            " ", "*)"}], "\[IndentingNewLine]", "     ", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Disk", "[", 
              RowBox[{
               RowBox[{"alphaPath", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "0.05"}], "]"}], ",", 
             "Red"}], "]"}]}], "\[IndentingNewLine]", "     ", "}"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "1.2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "0.5"}], ",", "0.5"}], "}"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"AspectRatio", "->", 
          RowBox[{"1", "/", "3"}]}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"Background", "->", "White"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"Axes", "->", "None"}]}], "\[IndentingNewLine]", "    ", 
        "]"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "alphaPath", "]"}]}], "}"}]}], 
      "\[IndentingNewLine]", "   ", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Mostrar", " ", "la", " ", "animaci\[OAcute]n"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"ListAnimate", "[", "animation", "]"}]}]}]], "Input",

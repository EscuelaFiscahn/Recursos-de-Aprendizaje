        RowBox[{"#", ",", "\"\<NeutronNumber\>\""}], "]"}]}], "}"}], "&"}], "/@",
     "stableIsotopes"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stableData", "=", 
    RowBox[{"Select", "[", 

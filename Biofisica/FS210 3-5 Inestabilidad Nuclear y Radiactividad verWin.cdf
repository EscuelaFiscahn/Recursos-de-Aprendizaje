Cell[CellGroupData[{

Cell[TextData[{
 "Decaimiento Beta (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Beta]", "\[PlusMinus]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\beta^{\\pm}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b3811857-4359-0948-942c-56dc7b5a9cde"],
 ")"
}], "Subsection",
 CellChangeTimes->{3.954017109544428*^9, 
  3.9540171774498825`*^9},ExpressionUUID->"9605be79-d1cd-704c-a349-\
b78060e05e93"],

Cell[TextData[{
 "Consiste en la emisi\[OAcute]n de una part\[IAcute]cula cargada liviana. El \
decaimiento ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Beta]", "-"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\beta^-", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7d94090d-eded-7e4f-8cae-3b8a592d524c"],
 " es cuando se emite un electr\[OAcute]n, mientras que el decaimiento ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Beta]", "+"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\beta^+", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be81c043-d64d-0241-9a17-b841125c56ba"],
 " es cuando se emite un positr\[OAcute]n."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.946578547563545*^9, 3.946578570864743*^9}, 
   3.9539926880385723`*^9, {3.953993167714464*^9, 3.953993202776102*^9}, {
   3.953997256844839*^9, 3.9539972837587585`*^9}, {3.9539973687132645`*^9, 
   3.953997370447798*^9}, 3.953998061072016*^9, {3.9539981199532356`*^9, 
   3.95399814844816*^9}, {3.953998319052103*^9, 3.953998449750841*^9}, {
   3.9540048169842987`*^9, 3.9540048363944435`*^9}, 3.954014901420683*^9, 
   3.954014949448761*^9, 3.954015562197695*^9, {3.954016968321081*^9, 
   3.9540169763784523`*^9}, 3.954017047536833*^9, {3.9540171313946056`*^9, 
   3.954017157530447*^9}, 3.9540171922363625`*^9, {3.984351263272148*^9, 
   3.984351263723467*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"6c2adaf1-735e-7049-bfa2-1ac2d15f7c32"],

Cell[TextData[{
 StyleBox["El decaimiento ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Beta]", "-"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\beta^-", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"7cc8c43f-acb9-114b-b359-e22fcca098a9"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "es posible cuando en el interior del n\[UAcute]cleo un neutr\[OAcute]n se \
convierte en un prot\[OAcute]n mientras emite un electr\[OAcute]n.\t"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.946578547563545*^9, 3.946578570864743*^9}, 
   3.9539926880385723`*^9, {3.953993167714464*^9, 3.953993202776102*^9}, {

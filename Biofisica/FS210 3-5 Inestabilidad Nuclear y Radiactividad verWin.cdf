Cell[TextData[{
 "La fracci\[OAcute]n de los n\[UAcute]cleos padre restantes (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["N", "TI"], "/", 
         SubscriptBox[
          StyleBox["N", "TI"], "0"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "N/N_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9be9ba43-57c4-8440-823b-71b2ccca0b64"],
 ") en una muestra radiactiva graficada como funci\[OAcute]n del tiempo sigue \
una curva de decaimiento exponencial. \n\nLa forma e inclinaci\[OAcute]n de \
la curva dependen de la constante de decaimiento (\[Lambda]) o la vida media \
(",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["t", "TI"], 
        RowBox[{"1", "/", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "t_{1/2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d7ff878a-bad8-3142-9fb4-4ba6aa153303"],
 ")"
}], "Text",
 CellChangeTimes->{{3.984350959600569*^9, 3.9843510225185776`*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"c6f46e04-f08b-9a49-a9c3-200d2556a18b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[Lambda]"}], " ", "t"}]], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "100"}], "}"}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", "\"\<Expressions\>\""}], ",", 
     RowBox[{"ImageSize", "->", "Large"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.1"}], ",", "1.1"}], "}"}]}]}], "]"}], ",", 

Cell[CellGroupData[{

Cell[TextData[{
 "Decaimiento Beta (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Beta]", "\[PlusMinus]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\beta^{\\pm}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b3811857-4359-0948-942c-56dc7b5a9cde"],
 ")"
}], "Subsection",
 CellChangeTimes->{3.954017109544428*^9, 
  3.9540171774498825`*^9},ExpressionUUID->"9605be79-d1cd-704c-a349-\
b78060e05e93"],

Cell[TextData[{
 "Consiste en la emisi\[OAcute]n de una part\[IAcute]cula cargada liviana. El \
decaimiento ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Beta]", "-"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\beta^-", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7d94090d-eded-7e4f-8cae-3b8a592d524c"],
 " es cuando se emite un electr\[OAcute]n, mientras que el decaimiento ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Beta]", "+"], TraditionalForm], "errors" -> {}, 

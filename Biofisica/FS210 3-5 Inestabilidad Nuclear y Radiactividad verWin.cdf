Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"isotopes", "=", 
   RowBox[{"IsotopeData", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stableIsotopes", "=", 
    RowBox[{"IsotopeData", "[", "\"\<Stable\>\"", "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Datos", " ", "completos", " ", "de", " ", "todos", " ", "los", " ", 
    "is\[OAcute]topos"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"allData", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"IsotopeData", "[", 
         RowBox[{"#", ",", "\"\<AtomicNumber\>\""}], "]"}], ",", 
        RowBox[{"IsotopeData", "[", 
         RowBox[{"#", ",", "\"\<NeutronNumber\>\""}], "]"}]}], "}"}], "&"}], "/@",
      "isotopes"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Eliminar", " ", "entradas", " ", "con", " ", "valores", " ", "Missing"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"allData", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"allData", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"NumericQ", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "&&", 
        RowBox[{"NumericQ", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Datos", " ", "de", " ", "is\[OAcute]topos", " ", "estables"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stableData", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"IsotopeData", "[", 
        RowBox[{"#", ",", "\"\<AtomicNumber\>\""}], "]"}], ",", 
       RowBox[{"IsotopeData", "[", 
        RowBox[{"#", ",", "\"\<NeutronNumber\>\""}], "]"}]}], "}"}], "&"}], "/@",
     "stableIsotopes"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stableData", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"stableData", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"NumericQ", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "&&", 
        RowBox[{"NumericQ", "[", 

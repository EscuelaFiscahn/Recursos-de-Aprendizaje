Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SubsuperscriptBox["\[Null]", 
        StyleBox["Z", "TI"], 
        StyleBox["A", "TI"]], 
       SubscriptBox[
        StyleBox["X", "TI"], 
        StyleBox["N", "TI"]], " ", "\[LongRightArrow] ", 
       SubsuperscriptBox["\[Null]", 
        RowBox[{
          StyleBox["Z", "TI"], "-", "2"}], 
        RowBox[{
          StyleBox["A", "TI"], "-", "4"}]], 
       SubscriptBox[
        StyleBox["Y", "TI"], 
        RowBox[{

      RowBox[{"{", 
       RowBox[{
        RowBox[{"IsotopeData", "[", 
         RowBox[{"#", ",", "\"\<AtomicNumber\>\""}], "]"}], ",", 
        RowBox[{"IsotopeData", "[", 
         RowBox[{"#", ",", "\"\<NeutronNumber\>\""}], "]"}]}], "}"}], "&"}], "/@",
      "isotopes"}]}], ";"}], "\n", 

  0.85],ExpressionUUID->"cf118770-15b1-43f4-9c64-5c19accaa216"],

Cell[CellGroupData[{

Cell["3-5 Inestabilidad nuclear y radiactividad", "Section",
 CellFrame->{{3, 0}, {0, 0.5}},
 CellFrameColor->RGBColor[0, 0, 1],
 CellChangeTimes->{{3.935515845683177*^9, 3.935515849943137*^9}, {
   3.9356999575611343`*^9, 3.9356999632170334`*^9}, {3.939294636528504*^9, 
   3.939294642762233*^9}, {3.951589140619224*^9, 3.951589142010891*^9}, {
   3.951669940033366*^9, 3.9516699478229322`*^9}, {3.951670332399876*^9, 
   3.951670332931019*^9}, 3.960547930283841*^9, {3.969476521475095*^9, 
   3.969476526032505*^9}, {3.969476984571576*^9, 3.96947699172572*^9}, {
   3.969567948678548*^9, 3.969567980938149*^9}, {3.969568021123867*^9, 
   3.969568032068366*^9}, {3.969568067081376*^9, 3.969568069578418*^9}, {
   3.96956815008892*^9, 3.969568175160637*^9}, {3.9700700579858646`*^9, 
   3.9700700641965714`*^9}, {3.977656454330055*^9, 3.9776564594789543`*^9}, {
   3.984319868343418*^9, 3.984319869775444*^9}, {3.984349969379711*^9, 
   3.984349972616337*^9}},
 FontFamily->"Times New Roman",
 FontColor->GrayLevel[0],
 Background->RGBColor[
  1., 1., 0.],ExpressionUUID->"7416e5ce-3031-fd43-be26-262d557df4b5"],

Cell["\<\
La inestabilidad nuclear se refiere a la tendencia de ciertos n\[UAcute]cleos \
at\[OAcute]micos a desintegrarse debido a un exceso de energ\[IAcute]a o \
inestabilidad en su configuraci\[OAcute]n interna. Esta \
desintegraci\[OAcute]n suele ir acompa\[NTilde]ada de la emisi\[OAcute]n de \
part\[IAcute]culas o radiaci\[OAcute]n.\
\>", "Text",
 CellChangeTimes->{{3.98435014651054*^9, 3.9843501765721416`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"24c5aa63-d27b-fe41-a439-5ae2467119de"],

Cell[TextData[{
 "Tipos de radiaciones:\n\n1. ",
 StyleBox["Radiaci\[OAcute]n Alfa (\[Alpha]):",
  FontWeight->Bold],
 "\n\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  "Consiste en la emisi\[OAcute]n de part\[IAcute]culas alfa, que son n\
\[UAcute]cleos de helio compuestos por dos protones y dos neutrones."
 }], "InlineSubitem",ExpressionUUID->"22f509f8-3e5c-2247-a325-7a68a5d182bc"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  "Tiene un poder de penetraci\[OAcute]n bajo, siendo detenida \
f\[AAcute]cilmente por una hoja de papel."
 }], "InlineSubitem",ExpressionUUID->"5b8da969-bb39-e14a-9d17-fe892e7ac175"],
 "\n\n2. ",
 StyleBox["Radiaci\[OAcute]n Beta (\[Beta]):",
  FontWeight->Bold],
 "\n\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  "Consiste en la emisi\[OAcute]n de electrones o positrones."
 }], "InlineSubitem",ExpressionUUID->"8404bc9b-5f6a-9e49-8658-b8a6347bdeda"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  "Tiene un poder de penetraci\[OAcute]n moderado, capaz de atravesar algunos \
cent\[IAcute]metros de tejido humano o una l\[AAcute]mina de aluminio delgada."
 }], "InlineSubitem",ExpressionUUID->"6ea13880-1672-154b-a7e9-e7695306cca5"],
 "\n\n3. ",
 StyleBox["Radiaci\[OAcute]n Gamma (\[Gamma]):",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  "Consiste en fotones de alta energ\[IAcute]a."
 }], "InlineSubitem",ExpressionUUID->"708fe274-28bb-0e4f-aa43-a8bc4521152a"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  "Tiene un alto poder de penetraci\[OAcute]n, requiriendo materiales densos \
como plomo o concreto para ser detenida."
 }], "InlineSubitem",ExpressionUUID->"6569a6c4-b4c5-ab48-9a34-769b01a67baf"]
}], "Text",
 CellChangeTimes->{{3.98435014651054*^9, 3.984350154994404*^9}, {
  3.98435019237228*^9, 3.9843502221601048`*^9}, {3.9843502864566536`*^9, 
  3.984350287432289*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"89f21b54-a95e-d24d-bfab-3e3271224d75"],


Cell[CellGroupData[{

Cell["Blindaje ante las Radiaciones Ionizantes", "Subsection",
 CellChangeTimes->{
  3.984352393630247*^9},ExpressionUUID->"a8c217c2-e84a-ef47-adbe-\
4153ffe53fca"],

Cell[TextData[{
 "El blindaje es crucial para proteger a las personas de las radiaciones \
ionizantes. Cada tipo de radiaci\[OAcute]n requiere diferentes materiales \
para su adecuada contenci\[OAcute]n:\n\n1. ",
 StyleBox["Radiaci\[OAcute]n Alfa (\[Alpha]):",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  StyleBox["Materiales:",
   FontWeight->Bold],
  " Puede ser detenida por una simple hoja de papel o incluso la piel \
humana."
 }], "InlineSubitem",ExpressionUUID->"d51368fb-9438-1147-a9ea-599cff8e1024"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  StyleBox["Aplicaci\[OAcute]n:",
   FontWeight->Bold],
  " Debido a su baja penetraci\[OAcute]n, no es peligrosa a menos que el \
material radiactivo sea ingerido o inhalado."
 }], "InlineSubitem",ExpressionUUID->"d15faeef-303d-9e41-8f2c-bdda1b399492"],
 "\n\n2. ",
 StyleBox["Radiaci\[OAcute]n Beta (\[Beta]):",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  StyleBox["Materiales:",
   FontWeight->Bold],
  " Se requiere plexigl\[AAcute]s, vidrio o aluminio para detener estos \
electrones o positrones."
 }], "InlineSubitem",ExpressionUUID->"a3c1ce93-d171-054f-a9ab-8af7240758a6"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  StyleBox["Aplicaci\[OAcute]n:",
   FontWeight->Bold],
  " Su moderada penetraci\[OAcute]n hace que el blindaje sea necesario para \
evitar da\[NTilde]os en la piel y tejidos subyacentes."
 }], "InlineSubitem",ExpressionUUID->"62dda07e-6a97-2547-9fce-6c726f0702bf"],
 "\n\n3. ",
 StyleBox["Radiaci\[OAcute]n Gamma (\[Gamma]):",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  StyleBox["Materiales:",
   FontWeight->Bold],
  " Requiere materiales densos como plomo, acero o concreto."
 }], "InlineSubitem",ExpressionUUID->"bc2f1f75-e180-9643-a7af-326d8ade7246"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  StyleBox["Aplicaci\[OAcute]n:",
   FontWeight->Bold],
  " Debido a su alta penetraci\[OAcute]n, el blindaje debe ser grueso y denso \
para reducir la exposici\[OAcute]n."
 }], "InlineSubitem",ExpressionUUID->"43ab9874-74f6-7c4e-b056-9dd4083501ee"]
}], "Text",
 CellChangeTimes->{{3.9843524481070175`*^9, 3.9843524726713905`*^9}, {
  3.992515319039606*^9, 3.99251532323489*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"d8ab9ed3-d958-f84d-8f1b-f95face35914"],


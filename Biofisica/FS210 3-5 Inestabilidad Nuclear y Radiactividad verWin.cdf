Cell[TextData[{
 StyleBox["El decaimiento ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Beta]", "+"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\beta^+", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"617d9b12-9ddc-544c-981d-df53ad7f9b25"],
 " es posible cuando en el interior del n\[UAcute]cleo un prot\[OAcute]n se \
convierte en un neutr\[OAcute]n mientras emite un positr\[OAcute]n."
}], "Text",

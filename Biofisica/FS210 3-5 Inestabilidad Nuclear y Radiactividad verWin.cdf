Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Funci\[OAcute]n", " ", "para", " ", "obtener", " ", "los", " ", 
    "n\[UAcute]clidos", " ", "hijos"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"DaughterNuclides", "[", "s_List", "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"DeleteCases", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"Union", "[", 
       RowBox[{"Apply", "[", 
        RowBox[{"Join", ",", "\[IndentingNewLine]", "     ", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"IsotopeData", "[", 
             RowBox[{"#", ",", "\"\<DaughterNuclides\>\""}], "]"}], " ", 
            "&"}], ",", "\[IndentingNewLine]", "      ", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{"s", ",", "_Missing"}], "]"}]}], "]"}]}], "]"}], "]"}], 
      ",", "_Missing"}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Funci\[OAcute]n", " ", "para", " ", "obtener", " ", "todos", " ", "los", 
     " ", "n\[UAcute]clidos", " ", "alcanzables"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ReachableNuclides", "[", "s_List", "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"FixedPoint", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Union", "[", 
        RowBox[{"Join", "[", 

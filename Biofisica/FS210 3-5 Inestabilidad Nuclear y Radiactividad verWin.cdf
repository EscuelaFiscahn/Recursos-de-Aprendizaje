Cell[TextData[{
 "Decaimiento Alfa (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Alpha]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b6e8bef9-4333-4a4d-860f-6f2d506cf8ba"],
 ")"

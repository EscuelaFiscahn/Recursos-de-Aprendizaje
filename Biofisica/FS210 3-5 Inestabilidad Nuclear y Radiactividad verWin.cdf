 RowBox[{
  RowBox[{"stableData", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"IsotopeData", "[", 
        RowBox[{"#", ",", "\"\<AtomicNumber\>\""}], "]"}], ",", 

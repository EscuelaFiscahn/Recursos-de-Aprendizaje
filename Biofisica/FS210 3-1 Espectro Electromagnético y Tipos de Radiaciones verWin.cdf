Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"datos", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Ondas de radio\>\"", ",", "\"\<100 Hz \[Dash] 300 MHz\>\"",
         ",", 
        RowBox[{"Row", "[", 

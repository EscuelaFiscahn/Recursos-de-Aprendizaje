         ",", "\"\<No ionizante\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Infrarrojo\>\"", ",", "\"\<300 GHz \[Dash] 430 THz\>\"", 
        ",", "\"\<1\[Times]10^-3 \[Dash] 1.8 eV\>\"", 

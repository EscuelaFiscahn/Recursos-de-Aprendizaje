Cell[TextData[{
 StyleBox["Ablaci\[OAcute]n por Microondas (MWA)\n",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 StyleBox[" Definici\[OAcute]n: \n",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["T\[EAcute]cnica terap\[EAcute]utica que utiliza campos electromagn\
\[EAcute]ticos de microondas para generar calentamiento localizado y \
destrucci\[OAcute]n t\[EAcute]rmica de tejidos.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Us",
  FontSize->15,
  FontWeight->Bold],
 StyleBox["o: ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nTratamiento de tumores hep\[AAcute]ticos, pulmonares, renales y \
\[OAcute]seos.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Ventaja",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nProduce temperaturas m\[AAcute]s elevadas y vol\[UAcute]menes de \
ablaci\[OAcute]n mayores que la radiofrecuencia.",
  FontSize->15]
}], "Text",
 CellChangeTimes->{{3.9530649721703463`*^9, 3.953064988003974*^9}, {

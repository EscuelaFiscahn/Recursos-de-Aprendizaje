Cell[BoxData[
 DynamicModuleBox[{$CellContext`respuesta$$ = None}, 
  FrameBox[
   TagBox[GridBox[{
      {
       StyleBox["\<\"Un fisioterapeuta sospecha que un atleta presenta una \
lesi\[OAcute]n muscular inflamatoria en una extremidad inferior. Al comparar \
ambos miembros, observa mediante termograf\[IAcute]a una regi\[OAcute]n con \
temperatura superficial significativamente mayor que los tejidos \
circundantes.\\n\[DownQuestion]Cu\[AAcute]l es la interpretaci\[OAcute]n m\
\[AAcute]s probable de este hallazgo?\"\>",
        StripOnInput->False,
        LineColor->RGBColor[0., 0.32, 0.6],
        FrontFaceColor->RGBColor[0., 0.32, 0.6],
        BackFaceColor->RGBColor[0., 0.32, 0.6],
        GraphicsColor->RGBColor[0., 0.32, 0.6],
        FontFamily->"Avenir",
        FontSize->15,
        FontWeight->Bold,
        FontColor->RGBColor[0., 0.32, 0.6]]},
      {
       TemplateBox[{10},
        "Spacer1"]},
      {
       TagBox[GridBox[{
          {
           TemplateBox[{
             RadioButtonBox[
              Dynamic[$CellContext`respuesta$$], {1}], 
             TemplateBox[{8}, "Spacer1"], 
             StyleBox[
             "\"A) Disminuci\[OAcute]n del flujo sangu\[IAcute]neo local.\"", 
              13, FontFamily -> "Avenir", StripOnInput -> False]},
            "RowDefault"]},
          {
           TemplateBox[{
             RadioButtonBox[
              Dynamic[$CellContext`respuesta$$], {2}], 
             TemplateBox[{8}, "Spacer1"], 
             StyleBox[
             "\"B) Incremento de la actividad metab\[OAcute]lica y del flujo \
sangu\[IAcute]neo asociado a inflamaci\[OAcute]n.\"", 13, FontFamily -> 
              "Avenir", StripOnInput -> False]},
            "RowDefault"]},
          {
           TemplateBox[{
             RadioButtonBox[
              Dynamic[$CellContext`respuesta$$], {3}], 
             TemplateBox[{8}, "Spacer1"], 
             StyleBox[
             "\"C) Presencia de tejido \[OAcute]seo fracturado.\"", 13, 
              FontFamily -> "Avenir", StripOnInput -> False]},
            "RowDefault"]},
          {
           TemplateBox[{
             RadioButtonBox[
              Dynamic[$CellContext`respuesta$$], {4}], 
             TemplateBox[{8}, "Spacer1"], 
             StyleBox[
             "\"D) Disminuci\[OAcute]n de la temperatura corporal central.\"",
               13, FontFamily -> "Avenir", StripOnInput -> False]},
            "RowDefault"]}
         },
         DefaultBaseStyle->"Column",
         GridBoxAlignment->{"Columns" -> {{Left}}},
         GridBoxItemSize->{
          "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
         GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{1.5}}}],
        "Column"]},
      {
       TemplateBox[{12},
        "Spacer1"]},
      {

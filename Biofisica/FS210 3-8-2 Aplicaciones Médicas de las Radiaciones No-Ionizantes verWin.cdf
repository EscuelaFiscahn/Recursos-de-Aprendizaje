Cell[TextData[{
 StyleBox["Oximetr\[IAcute]a cerebral por infrarrojo cercano\n",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 StyleBox[" Definici\[OAcute]n:",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nUtilizaci\[OAcute]n de procesos de espectroscop\[IAcute]a del \
infrarrojo para monitorizar la oxigenaci\[OAcute]n cerebral.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Uso",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nEstablecimiento de condiciones para cirug\[IAcute]a \
cardiovascular, neonatolog\[IAcute]a y neurocr\[IAcute]ticos.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Ventaja",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nMonitorizaci\[OAcute]n continua de la perfusi\[OAcute]n \
cerebral.",
  FontSize->15]
}], "Text",

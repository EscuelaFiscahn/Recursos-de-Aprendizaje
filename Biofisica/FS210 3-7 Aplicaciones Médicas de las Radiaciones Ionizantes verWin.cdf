Cell[TextData[{
 "8. ",
 StyleBox["Tomograf\[IAcute]a Computarizada (CT)",
  FontWeight->Bold],
 ": \n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  "Combina m\[UAcute]ltiples im\[AAcute]genes de rayos X tomadas desde \
diferentes \[AAcute]ngulos para crear im\[AAcute]genes transversales del \

Cell[TextData[{
 "9. ",
 StyleBox["Fluoroscop\[IAcute]a y Radiolog\[IAcute]a Intervencionista",
  FontWeight->Bold],
 ": \n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  "Proporciona im\[AAcute]genes en tiempo real del movimiento interno del \
cuerpo mediante el uso de rayos X continuos."
 }], "InlineSubitem",ExpressionUUID->"43a07a20-88ac-b440-be30-3e2dc75f177c"],
 "\n",

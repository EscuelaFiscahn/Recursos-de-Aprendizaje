Cell[CellGroupData[{

Cell["\<\
Ejemplos de aplicaciones en la medicina mediante demostraciones\
\>", "Subsection",
 CellChangeTimes->{{3.984406295624548*^9, 
  3.9844063183478184`*^9}},ExpressionUUID->"dc235650-3e25-6745-8a09-\
6b55ff92ff46"],

Cell["\<\
Esta demostraci\[OAcute]n muestra una secuencia de pulsos de eco de esp\
\[IAcute]n en im\[AAcute]genes por resonancia magn\[EAcute]tica (IRM). El \
\[OpenCurlyDoubleQuote]tiempo de eco\[CloseCurlyDoubleQuote] se puede \
manipular en un equipo de IRM para obtener im\[AAcute]genes con diferente \
contraste entre los tejidos. Esta demostraci\[OAcute]n examina una imagen del \
cerebro que muestra los tejidos: l\[IAcute]quido cefalorraqu\[IAcute]deo, \
sustancia gris, sustancia blanca, grasa, m\[UAcute]sculo, piel, duramadre, m\
\[EAcute]dula \[OAcute]sea y vasos sangu\[IAcute]neos, bajo un campo magn\
\[EAcute]tico de 3.0 T.\
\>", "Text",
 CellChangeTimes->{3.9844060111803303`*^9, 3.9844063628904667`*^9},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"5840b83e-0027-d147-99c0-b1e78aaf2852"],


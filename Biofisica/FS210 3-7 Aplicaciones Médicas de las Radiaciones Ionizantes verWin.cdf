Cell["\<\
La segmentaci\[OAcute]n es una de las operaciones m\[AAcute]s comunes en el \
procesamiento de im\[AAcute]genes m\[EAcute]dicas. Esta demostraci\[OAcute]n \
muestra una forma de segmentar diferentes regiones en una tomograf\[IAcute]a \
digital de la cabeza.\
\>", "Text",
 CellChangeTimes->{3.9844062823283157`*^9},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"7217fc2b-5613-bb43-a72b-7bcaf1c9041d"],


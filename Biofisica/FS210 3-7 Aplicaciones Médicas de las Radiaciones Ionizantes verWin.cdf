Cell[TextData[{
 "5. ",
 StyleBox["Braquiterapia",
  FontWeight->Bold],
 ": \n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  "Consiste en colocar fuentes de radiaci\[OAcute]n directamente dentro o \
cerca de un tumor."
 }], "InlineSubitem",ExpressionUUID->"4a2e6a64-bb41-0049-84b4-41142b93d878"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->GrayLevel[0.5]],
  " ",
  "Permite una alta dosis de radiaci\[OAcute]n al tumor mientras minimiza la \
exposici\[OAcute]n a los tejidos circundantes."
 }], "InlineSubitem",ExpressionUUID->"dd53c09d-f494-da45-87f3-8c2269d54bcb"]
}], "Text",

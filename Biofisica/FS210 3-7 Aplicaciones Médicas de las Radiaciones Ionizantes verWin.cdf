$CellContext`segment$, $CellContext`label$, $CellContext`p$, \
$CellContext`perimeter$}, $CellContext`mc$ = 
             MorphologicalComponents[$CellContext`image$, $CellContext`t$$, 
               CornerNeighbors -> False]; $CellContext`p$ = 
             MorphologicalPerimeter[
               ImageAdjust[
                Image[$CellContext`mc$]], 0]; $CellContext`perimeter$ = 
             Image[
               Replace[
                ImageData[$CellContext`p$], {
                1 -> {0, 1, 1, 1}, Blank[] -> {0, 0, 0, 0}}, {2}], ColorSpace -> 
               "RGB"]; $CellContext`sorted$ = Sort[
               Reverse[
                Tally[
                 Cases[
                  Flatten[$CellContext`mc$], 
                  PatternTest[
                   Blank[Integer], Positive]]], 2]]; $CellContext`label$ = 
             Part[$CellContext`sorted$, -Min[$CellContext`showobj$$, 
                 Length[$CellContext`sorted$]], 2]; $CellContext`segment$ = 
             Image[
               
               Replace[$CellContext`mc$, {$CellContext`label$ -> {
                  1, 0.5, 0.5, 1}, Blank[] -> {0, 0, 0, 0}}, {2}], ColorSpace -> 
               "RGB"]; ImageCompose[
              
              ImageCompose[$CellContext`image$, $CellContext`segment$], \

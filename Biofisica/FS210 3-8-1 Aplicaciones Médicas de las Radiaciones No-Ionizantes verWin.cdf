Cell[TextData[{
 StyleBox["Radiofrecuencia en Fisioterapia y Rehabilitaci\[OAcute]n \n",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 StyleBox[" Definici\[OAcute]n:",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nT\[EAcute]cnica terap\[EAcute]utica que emplea campos \
electromagn\[EAcute]ticos de radiofrecuencia para transferir energ\[IAcute]a \
a los tejidos y producir calentamiento profundo controlado.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Uso",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nTratamiento de lesiones musculares, tendinopat\[IAcute]as, dolor \
articular, rehabilitaci\[OAcute]n deportiva y recuperaci\[OAcute]n funcional.\
\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Ventaja",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nPermite alcanzar tejidos profundos de forma no invasiva, \
favoreciendo la circulaci\[OAcute]n, la reparaci\[OAcute]n tisular y la \
disminuci\[OAcute]n del dolor.",
  FontSize->15]
}], "Text",
 CellChangeTimes->{{3.9530649721703463`*^9, 3.953064988003974*^9}, {
   3.953065028655744*^9, 3.95306503663035*^9}, {3.953993265456999*^9, 

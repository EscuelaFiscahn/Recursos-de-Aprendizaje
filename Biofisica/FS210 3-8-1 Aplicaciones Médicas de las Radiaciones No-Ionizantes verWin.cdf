Cell[BoxData[
 DynamicModuleBox[{$CellContext`respuesta$$ = None}, 
  FrameBox[
   TagBox[GridBox[{
      {
       StyleBox["\<\"Un paciente presenta s\[IAcute]ntomas \
neurol\[OAcute]gicos compatibles con una posible lesi\[OAcute]n en la m\
\[EAcute]dula espinal. El m\[EAcute]dico necesita visualizar con gran detalle \
el tejido nervioso evitando la exposici\[OAcute]n a radiaciones \
ionizantes.\\n\[DownQuestion]Cu\[AAcute]l ser\[IAcute]a la t\[EAcute]cnica m\
\[AAcute]s apropiada?\"\>",
        StripOnInput->False,
        LineColor->RGBColor[0., 0.32, 0.6],
        FrontFaceColor->RGBColor[0., 0.32, 0.6],

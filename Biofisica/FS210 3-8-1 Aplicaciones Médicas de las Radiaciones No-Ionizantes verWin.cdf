  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 StyleBox[" Definici\[OAcute]n: \n",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["Detecta los potenciales el\[EAcute]ctricos generados por la \
actividad neuronal cerebral.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Uso",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nDiagn\[OAcute]stico y seguimiento de epilepsia, trastornos del \
sue\[NTilde]o y alteraciones neurol\[OAcute]gicas.",

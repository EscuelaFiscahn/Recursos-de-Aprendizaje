Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"respuesta", "=", "None"}], "}"}], ",", 
   RowBox[{"Framed", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<\[DownQuestion]Cu\[AAcute]l es el mecanismo \
f\[IAcute]sico principal mediante el cual la radiofrecuencia \
terap\[EAcute]utica produce sus efectos en los tejidos?\>\"", ",", "15", ",", 
           "Bold", ",", 
           RowBox[{"RGBColor", "[", 
            RowBox[{"0.0", ",", "0.32", ",", "0.60"}], "]"}], ",", 
           RowBox[{"FontFamily", "->", "\"\<Avenir\>\""}]}], "]"}], ",", 
         RowBox[{"Spacer", "[", "10", "]"}], ",", 
         RowBox[{"Column", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"RadioButton", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "respuesta", "]"}], ",", "1"}], 
                 "]"}], ",", 
                RowBox[{"Spacer", "[", "8", "]"}], ",", 
                RowBox[{"Style", "[", 
                 
                 RowBox[{"\"\<A) Producci\[OAcute]n de im\[AAcute]genes \
mediante resonancia nuclear.\>\"", ",", "13", ",", 
                  RowBox[{"FontFamily", "->", "\"\<Avenir\>\""}]}], "]"}]}], 
               "}"}], "]"}], ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"RadioButton", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "respuesta", "]"}], ",", "2"}], 
                 "]"}], ",", 
                RowBox[{"Spacer", "[", "8", "]"}], ",", 
                RowBox[{"Style", "[", 
                 
                 RowBox[{"\"\<B) Transferencia de energ\[IAcute]a electromagn\
\[EAcute]tica que genera calentamiento profundo en los tejidos.\>\"", ",", 
                  "13", ",", 
                  RowBox[{"FontFamily", "->", "\"\<Avenir\>\""}]}], "]"}]}], 
               "}"}], "]"}], ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"RadioButton", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "respuesta", "]"}], ",", "3"}], 
                 "]"}], ",", 
                RowBox[{"Spacer", "[", "8", "]"}], ",", 
                RowBox[{"Style", "[", 
                 
                 RowBox[{"\"\<C) Emisi\[OAcute]n de ultrasonido de alta \
frecuencia.\>\"", ",", "13", ",", 
                  RowBox[{"FontFamily", "->", "\"\<Avenir\>\""}]}], "]"}]}], 
               "}"}], "]"}], ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 

Cell[TextData[{
 StyleBox["Resonancia Magn\[EAcute]tica (RM)\n",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 StyleBox[" Definici\[OAcute]n: \n",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["T\[EAcute]cnica de imagen que utiliza campos magn\[EAcute]ticos \
intensos y pulsos de radiofrecuencia para generar im\[AAcute]genes anat\
\[OAcute]micas y funcionales.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Uso",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nDiagn\[OAcute]stico neurol\[OAcute]gico estructural y funcional, \
musculoesquel\[EAcute]tico, cardiovascular y oncol\[OAcute]gico. \n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Ventaja",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nExcelente contraste de tejidos blandos sin utilizar radiaci\
\[OAcute]n ionizante.",
  FontSize->15]
}], "Text",
 CellChangeTimes->{{3.9530649721703463`*^9, 3.953064988003974*^9}, {

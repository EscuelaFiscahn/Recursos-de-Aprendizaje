Cell[TextData[{
 StyleBox["Estimulaci\[OAcute]n el\[EAcute]ctrica funcional\n",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 StyleBox[" Definici\[OAcute]n: \n",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["Aplicaci\[OAcute]n controlada de pulsos el\[EAcute]ctricos sobre \
nervios o m\[UAcute]sculos.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Uso",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nFrecuentemente en rehabilitaci\[OAcute]n neurol\[OAcute]gica y \
recuperaci\[OAcute]n funcional.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Ventaja",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nFavorece la movilidad y previene la atrofia muscular.",
  FontSize->15]
}], "Text",

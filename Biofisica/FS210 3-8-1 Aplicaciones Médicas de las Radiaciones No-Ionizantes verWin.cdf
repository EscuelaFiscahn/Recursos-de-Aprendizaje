Cell[TextData[{
 StyleBox["Estimulaci\[OAcute]n Nerviosa El\[EAcute]ctrica \
Transcut\[AAcute]neal\n",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 StyleBox[" Definici\[OAcute]n: \n",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["Consiste en corrientes el\[EAcute]ctricas de baja intensidad \
aplicadas sobre la piel.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Uso",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nEn tratamiento del dolor agudo y cr\[OAcute]nico.\n\n",
  FontSize->15],

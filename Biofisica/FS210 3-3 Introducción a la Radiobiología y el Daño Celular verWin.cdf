Cell[BoxData[{
 RowBox[{
  RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Translate", "[", 
          RowBox[{
           RowBox[{"Scale", "[", 
            RowBox[{"interphase", ",", "1.8"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "8"}], ",", "0"}], "}"}]}], "]"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"Tooltip", "[", 
          RowBox[{
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<Interfase\>\"", ",", "16"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "8"}], ",", 
               RowBox[{"-", "2.5"}]}], "}"}]}], "]"}], ",", 
           RowBox[{
           "InsertLinebreaks", "[", 
            "\"\<Durante la interfase, la fase m\[AAcute]s larga del ciclo \
celular, la c\[EAcute]lula experimenta sus procesos normales cuando no se \
divide. La interfase consta de tres etapas: G1, S y G2. La c\[EAcute]lula \
crece durante las etapas G1 y G2, y el ADN se replica durante la etapa S. El \
ADN es el componente clave de la cromatina.\>\"", "]"}]}], "]"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"stage", "\[GreaterEqual]", " ", "1"}], ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Translate", "[", 
              RowBox[{
               RowBox[{"Scale", "[", 
                RowBox[{"prophase", ",", "1.8"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "3.6"}], ",", "5"}], "}"}]}], "]"}], "}"}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"Arrow", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "8"}], ",", "2.1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "5.7"}], ",", "5"}], "}"}]}], "}"}], "]"}], 
             "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"Tooltip", "[", 
              RowBox[{
               RowBox[{"Text", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Profase\>\"", ",", "16"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "3.5"}], ",", "2.5"}], "}"}]}], "]"}], ",", 
               RowBox[{
               "InsertLinebreaks", "[", 
                "\"\<La profase es la primera fase de la mitosis, denominada \
fase M del ciclo celular. El ADN se condensa fuertemente en cromosomas, \
compuestos por dos crom\[AAcute]tidas hermanas id\[EAcute]nticas. La membrana \
nuclear comienza a disolverse y el nucl\[EAcute]olo desaparece.\>\"", "]"}]}],
               "]"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"stage", "\[GreaterEqual]", " ", "2"}], ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Translate", "[", 
              RowBox[{
               RowBox[{"Scale", "[", 
                RowBox[{"metaphase", ",", "1.8"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"3.6", ",", "5"}], "}"}]}], "]"}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"Arrow", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1.5"}], ",", "5"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1.5", ",", "5"}], "}"}]}], "}"}], "]"}], "}"}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"Tooltip", "[", 
              RowBox[{
               RowBox[{"Text", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Metafase\>\"", ",", "16"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"3.5", ",", "2.5"}], "}"}]}], "]"}], ",", 
               RowBox[{
               "InsertLinebreaks", "[", 
                "\"\<La segunda fase de la mitosis es la metafase, en la que \
los cromosomas se alinean en el centro de la c\[EAcute]lula a lo largo de la \
placa metaf\[AAcute]sica. Los centr\[IAcute]olos viajan a los polos de la c\
\[EAcute]lula y las fibras del huso se extienden y se unen a cada crom\
\[AAcute]tida en estructuras llamadas cinetocoros.\>\"", "]"}]}], "]"}], 
             "}"}]}], "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"stage", "\[GreaterEqual]", " ", "3"}], ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Translate", "[", 
              RowBox[{
               RowBox[{"Scale", "[", 

                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Anafase\>\"", ",", "16"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"8", ",", 
                   RowBox[{"-", "2.9"}]}], "}"}]}], "]"}], ",", 
               RowBox[{
               "InsertLinebreaks", "[", 
                "\"\<Durante la anafase, las crom\[AAcute]tidas hermanas se \
separan y viajan a polos opuestos de la c\[EAcute]lula.\>\"", "]"}]}], "]"}], 
             "}"}]}], "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"stage", "\[GreaterEqual]", " ", "4"}], ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Translate", "[", 
              RowBox[{
               RowBox[{"Scale", "[", 
                RowBox[{"telophase", ",", "1.8"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"3.6", ",", 
                 RowBox[{"-", "4.5"}]}], "}"}]}], "]"}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"Arrow", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"8", ",", 
                  RowBox[{"-", "3.4"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"5.5", ",", 
                  RowBox[{"-", "4.5"}]}], "}"}]}], "}"}], "]"}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"Tooltip", "[", 
              RowBox[{
               RowBox[{"Text", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Telofase\>\"", ",", "16"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"3.6", ",", 
                   RowBox[{"-", "8"}]}], "}"}]}], "]"}], ",", 
               RowBox[{
               "InsertLinebreaks", "[", 
                "\"\<En la telofase, ambos polos de la c\[EAcute]lula \
contienen un conjunto completo de cromosomas. En cada polo se empiezan a \
formar una membrana nuclear y un nucl\[EAcute]olo. La segmentaci\[OAcute]n \
celular comienza a formarse a medida que la c\[EAcute]lula se comprime en el \
centro.\>\"", "]"}]}], "]"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"stage", "\[GreaterEqual]", " ", "5"}], ",", 

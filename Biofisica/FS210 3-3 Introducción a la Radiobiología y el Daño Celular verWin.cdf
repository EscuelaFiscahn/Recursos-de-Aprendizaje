                  RowBox[{"\"\<Citocinesis\>\"", ",", "16"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "3.3"}], ",", 
                   RowBox[{"-", "9"}]}], "}"}]}], "]"}], ",", 
               RowBox[{
               "InsertLinebreaks", "[", 
                "\"\<A trav\[EAcute]s de un proceso llamado citocinesis, la c\
\[EAcute]lula produce dos nuevas c\[EAcute]lulas hijas id\[EAcute]nticas y el \
ciclo contin\[UAcute]a.\>\"", "]"}]}], "]"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 

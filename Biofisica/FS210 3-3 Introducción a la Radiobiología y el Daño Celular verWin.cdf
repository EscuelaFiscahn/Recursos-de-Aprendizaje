 FontColor->GrayLevel[0],
 Background->RGBColor[
  1., 1., 0.],ExpressionUUID->"7416e5ce-3031-fd43-be26-262d557df4b5"],

Cell[TextData[{
 "La ",
 StyleBox["radiobiolog\[IAcute]a",
  IgnoreSpellCheck->True],
 " es la rama de la biolog\[IAcute]a que estudia los efectos de las \
radiaciones ionizantes sobre los sistemas biol\[OAcute]gicos, especialmente a \
nivel celular y molecular. \n\nEsta disciplina es fundamental para comprender \
c\[OAcute]mo la radiaci\[OAcute]n afecta a los tejidos vivos, tanto en \
aplicaciones m\[EAcute]dicas como en contextos de exposici\[OAcute]n \
accidental u ocupacional."
}], "Text",
 CellChangeTimes->{{3.9530649721703463`*^9, 3.953064988003974*^9}, {
   3.953065028655744*^9, 3.95306503663035*^9}, {3.953993265456999*^9, 
   3.9539932670006466`*^9}, 3.9539958208560524`*^9, {3.984347534269869*^9, 
   3.984347534930216*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"5fca3934-190d-8948-98a0-a64a21caa7d9"],

Cell[TextData[{
 "\[CapitalOAcute]rganos y tejidos est\[AAcute]n compuestos por \
c\[EAcute]lulas (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Tilde]", "5", "-", "10", "\[Mu]", 
         StyleBox["m", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sim 5-10 \\mu m", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c88c8e39-df2d-a045-bc7b-43452e0d9c58"],
 ") especializadas que garantizan aspectos estructurales y funcionales en el \
cuerpo humano."
}], "Text",
 CellChangeTimes->{{3.946578547563545*^9, 3.946578570864743*^9}, 
   3.9539926880385723`*^9, {3.953993167714464*^9, 3.953993202776102*^9}, 
   3.953997256844839*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"72fa7b47-bc0d-534e-9ead-b78bdcf31443"],


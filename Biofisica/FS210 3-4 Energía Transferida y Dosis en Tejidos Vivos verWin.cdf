Cell[TextData[{
 StyleBox["1. Dosis Absorbida(Gy):\n\n",
  FontWeight->"Bold"],
 "La dosis absorbida es la energ\[IAcute]a que la radiaci\[OAcute]n deposita \
por unidad de masa de un tejido. En forma microsc\[OAcute]pica, indica que \
depende del n\[UAcute]mero de interacciones (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "46f1f763-d1b6-b340-a471-32c5b1018024"],
 ") y de la energ\[IAcute]a transferida en cada una (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "E_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "25852f2c-b99e-eb40-8837-cc43883bb99f"],
 "). \n\nEsta magnitud, medida en gray (Gy), es clave en medicina porque \
determina el efecto biol\[OAcute]gico de la radiaci\[OAcute]n sobre los \
tejidos."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},

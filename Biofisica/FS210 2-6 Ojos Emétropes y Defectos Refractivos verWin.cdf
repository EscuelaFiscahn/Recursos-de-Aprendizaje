Cell[CellGroupData[{

Cell["\<\
Recomendaciones para la resoluci\[OAcute]n de problemas de miop\[IAcute]a e \
hipermetrop\[IAcute]a\
\>", "Subsection",
 CellChangeTimes->{{3.984317723717911*^9, 
  3.984317749849533*^9}},ExpressionUUID->"5a3ff3ca-28b9-634a-bf4a-\
bcf80e54e15f"],

Cell["\<\
Para la resoluci\[OAcute]n de problemas o ejercicios con miop\[IAcute]a o \
hipermetrop\[IAcute]a utilizaremos la siguiente f\[OAcute]rmula general para \
la potencia que nos permite combinar todas las variables involucradas \
independientemente del problema de estudio. 

Esta formula general esta dada por:\
\>", "Text",
 CellChangeTimes->{{3.952007733100542*^9, 3.952007738286831*^9}, {
   3.9520078509806423`*^9, 3.952007856504822*^9}, {3.9520079834694633`*^9, 
   3.952008155317444*^9}, {3.9520777891688366`*^9, 3.9520778148535194`*^9}, 
   3.984317753912983*^9, {3.984318008428753*^9, 3.984318025881773*^9}, {
   3.9843180596708736`*^9, 3.984318154019081*^9}, {3.984318354604475*^9, 
   3.984318373862335*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"9478b745-e697-fc48-9677-d29a24330c93"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["P", "TI"], "\[LongEqual]", 
       FractionBox["1", 
        StyleBox["f", "TI"]], "\[LongEqual]", 
       FractionBox["1", 
        TemplateBox[{
          RowBox[{
            SubscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["o", "TI"]], "-", 
            StyleBox["d", "TI"]}]}, "Abs"]], "+", 
       FractionBox["1", 
        RowBox[{"-|", 
          SubscriptBox[
           StyleBox["d", "TI"], 
           StyleBox["f", "TI"]], "-", 
          StyleBox["d", "TI"], "|"}]]}], TraditionalForm], "errors" -> {}, 
   "input" -> 
   "P = \\frac {1} {f} = \\frac {1} {| d_o - d |} + \\frac {1} {-| d_f - d \
|}", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.952007885695812*^9, 3.9520079534232216`*^9}},
 TextAlignment->Center,
 FontWeight->"Bold",ExpressionUUID->"e5e04327-ad38-a145-a38f-81b16a7aa419"],

Cell[TextData[{
 "donde la nomenclatura es:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"[", 
           StyleBox["D", "TI"], "]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "P[D]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3d05de93-41e0-c345-b355-e62a2dd35312"],
 " Potencia de la lente\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"[", 
           StyleBox["m", "TI"], "]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "f[m]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a05e35a6-645a-c44f-ade3-db189c68bbc8"],
 " Longitud focal de la lente\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["o", "TI"]], 
         RowBox[{"[", 
           StyleBox["m", "TI"], "]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "d_o[m]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "40aae6b2-61dd-ab47-94c0-ef16efc974fc"],
 " distancia de la lente al objeto\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"[", 
           StyleBox["m", "TI"], "]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "d_i[m]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a2d861c7-c5b4-0345-96b6-fdc61183ccd3"],
 " distancia de la lente a la imagen\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], 
         RowBox[{"[", 
           StyleBox["m", "TI"], "]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "d[m]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ca10b79a-21d4-8b4e-ab5a-bf4d7f662462"],
 " distancia del ojo a la lente o anteojos\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["f", "TI"]], 
         RowBox[{"[", 
           StyleBox["m", "TI"], "]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "d_f[m] ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f02f6167-63f7-604a-9897-a14067d5039a"],
 " distancia del ojo al ",
 StyleBox["punto lejano en miop\[IAcute]a",
  FontWeight->"Bold"],
 ", y en ",
 StyleBox["hipermetrop\[IAcute]a es punto cercano",
  FontWeight->"Bold"],
 ".\n\nNormalmente la distancia del ojo a la lente o anteojos se considera de \
3 cm (a menos que se indique lo contrario)."
}], "Text",
 CellChangeTimes->{{3.952007733100542*^9, 3.952007738286831*^9}, {
   3.9520078509806423`*^9, 3.952007856504822*^9}, {3.9520079834694633`*^9, 
   3.952008155317444*^9}, {3.9520777891688366`*^9, 3.9520778148535194`*^9}, 
   3.984317753912983*^9, {3.984318008428753*^9, 3.984318025881773*^9}, {
   3.9843181608063736`*^9, 3.9843182199673367`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"79d8550e-ebc6-c44f-8bfe-c6bf902a6e5e"],


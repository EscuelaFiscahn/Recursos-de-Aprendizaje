Cell[TextData[{
 StyleBox["Terapia Fotodin\[AAcute]mica\n",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 StyleBox[" Definici\[OAcute]n:",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nT\[EAcute]cnica terap\[EAcute]utica que combina un \
fotosensibilizador, luz l\[AAcute]ser de longitud de onda espec\[IAcute]fica \
y ox\[IAcute]geno molecular para generar especies reactivas de \
ox\[IAcute]geno capaces de destruir selectivamente c\[EAcute]lulas diana.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Uso",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nTratamiento de algunos c\[AAcute]nceres, lesiones precancerosas, \
enfermedades dermatol\[OAcute]gicas y determinadas patolog\[IAcute]as \
oftalmol\[OAcute]gicas.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Ventaja",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nProduce destrucci\[OAcute]n localizada del tejido \
patol\[OAcute]gico con preservaci\[OAcute]n relativa del tejido sano \
circundante.",
  FontSize->15]
}], "Text",
 CellChangeTimes->{{3.9530649721703463`*^9, 3.953064988003974*^9}, {
   3.953065028655744*^9, 3.95306503663035*^9}, {3.953993265456999*^9, 

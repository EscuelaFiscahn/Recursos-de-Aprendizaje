Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"respuesta", "=", "None"}], "}"}], ",", 
   RowBox[{"Framed", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<\[DownQuestion]Cu\[AAcute]l es el fundamento \
f\[IAcute]sico principal de la fototerapia neonatal?\>\"", ",", "15", ",", 
           "Bold", ",", 
           RowBox[{"RGBColor", "[", 
            RowBox[{"0.0", ",", "0.32", ",", "0.60"}], "]"}], ",", 
           RowBox[{"FontFamily", "->", "\"\<Avenir\>\""}]}], "]"}], ",", 
         RowBox[{"Spacer", "[", "10", "]"}], ",", 
         RowBox[{"Column", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"RadioButton", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "respuesta", "]"}], ",", "1"}], 
                 "]"}], ",", 
                RowBox[{"Spacer", "[", "8", "]"}], ",", 
                RowBox[{"Style", "[", 
                 
                 RowBox[{"\"\<A) Destruir la bilirrubina mediante \
calentamiento t\[EAcute]rmico intenso.\>\"", ",", "13", ",", 
                  RowBox[{"FontFamily", "->", "\"\<Avenir\>\""}]}], "]"}]}], 
               "}"}], "]"}], ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"RadioButton", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "respuesta", "]"}], ",", "2"}], 
                 "]"}], ",", 
                RowBox[{"Spacer", "[", "8", "]"}], ",", 
                RowBox[{"Style", "[", 
                 
                 RowBox[{"\"\<B) Generar una transformaci\[OAcute]n fotoqu\
\[IAcute]mica de la bilirrubina mediante exposici\[OAcute]n a luz visible, \
principalmente azul.\>\"", ",", "13", ",", 
                  RowBox[{"FontFamily", "->", "\"\<Avenir\>\""}]}], "]"}]}], 
               "}"}], "]"}], ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"RadioButton", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "respuesta", "]"}], ",", "3"}], 
                 "]"}], ",", 
                RowBox[{"Spacer", "[", "8", "]"}], ",", 
                RowBox[{"Style", "[", 
                 
                 RowBox[{"\"\<C) Ionizar la bilirrubina mediante radiaci\
\[OAcute]n ultravioleta.\>\"", ",", "13", ",", 
                  RowBox[{"FontFamily", "->", "\"\<Avenir\>\""}]}], "]"}]}], 
               "}"}], "]"}], ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"RadioButton", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "respuesta", "]"}], ",", "4"}], 
                 "]"}], ",", 
                RowBox[{"Spacer", "[", "8", "]"}], ",", 
                RowBox[{"Style", "[", 
                 
                 RowBox[{"\"\<D) Medir la concentraci\[OAcute]n de \
bilirrubina por fluorescencia.\>\"", ",", "13", ",", 
                  RowBox[{"FontFamily", "->", "\"\<Avenir\>\""}]}], "]"}]}], 
               "}"}], "]"}]}], "}"}], ",", 
           RowBox[{"Spacings", "->", "1.5"}]}], "]"}], ",", 
         RowBox[{"Spacer", "[", "12", "]"}], ",", 

Cell[TextData[{
 StyleBox["Endoscopia M\[EAcute]dica\n",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 StyleBox[" Definici\[OAcute]n:",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nT\[EAcute]cnica que utiliza luz visible y sistemas \
\[OAcute]pticos para visualizar estructuras internas del cuerpo.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Uso",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nDiagn\[OAcute]stico y seguimiento de enfermedades \
gastrointestinales, respiratorias y urol\[OAcute]gicas.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Ventaja",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nPermite observaci\[OAcute]n directa de tejidos de forma m\
\[IAcute]nimamente invasiva.",
  FontSize->15]
}], "Text",

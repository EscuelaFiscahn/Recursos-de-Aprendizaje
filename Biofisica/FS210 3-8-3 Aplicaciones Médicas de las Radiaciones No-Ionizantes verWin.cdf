Cell[TextData[{
 StyleBox["Producci\[OAcute]n terap\[EAcute]utica de vitamina D mediante \
espectros UV-B\n",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 StyleBox[" Definici\[OAcute]n:",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nExposici\[OAcute]n controlada a UV-B para estimular la \
s\[IAcute]ntesis cut\[AAcute]nea de vitamina D.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Uso",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nEn casos seleccionados de d\[EAcute]ficit de vitamina D.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Ventaja",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nActiva un proceso fisiol\[OAcute]gico natural del organismo.",
  FontSize->15]
}], "Text",

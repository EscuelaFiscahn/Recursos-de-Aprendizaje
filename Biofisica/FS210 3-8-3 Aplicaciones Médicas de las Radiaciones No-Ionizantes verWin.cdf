Cell[BoxData[
 DynamicModuleBox[{$CellContext`respuesta$$ = None}, 
  FrameBox[
   TagBox[GridBox[{
      {
       StyleBox["\<\"Un paciente recibe un fotosensibilizador que se acumula \
preferentemente en tejido patol\[OAcute]gico. Posteriormente se aplica una \
longitud de onda espec\[IAcute]fica de luz l\[AAcute]ser sobre la zona \
afectada.\\n\[DownQuestion]Por qu\[EAcute] la PDT puede producir un efecto \
terap\[EAcute]utico relativamente selectivo sobre el tejido diana?\"\>",
        StripOnInput->False,
        LineColor->RGBColor[0., 0.32, 0.6],
        FrontFaceColor->RGBColor[0., 0.32, 0.6],
        BackFaceColor->RGBColor[0., 0.32, 0.6],
        GraphicsColor->RGBColor[0., 0.32, 0.6],
        FontFamily->"Avenir",
        FontSize->15,
        FontWeight->Bold,
        FontColor->RGBColor[0., 0.32, 0.6]]},
      {
       TemplateBox[{10},
        "Spacer1"]},
      {
       TagBox[GridBox[{
          {
           TemplateBox[{
             RadioButtonBox[
              Dynamic[$CellContext`respuesta$$], {1}], 
             TemplateBox[{8}, "Spacer1"], 
             StyleBox[
             "\"A) Porque la radiaci\[OAcute]n l\[AAcute]ser atraviesa todos \
los tejidos sin interacci\[OAcute]n..\"", 13, FontFamily -> "Avenir", 
              StripOnInput -> False]},
            "RowDefault"]},
          {
           TemplateBox[{
             RadioButtonBox[
              Dynamic[$CellContext`respuesta$$], {2}], 
             TemplateBox[{8}, "Spacer1"], 
             StyleBox[
             "\"B) Porque \[UAcute]nicamente el tejido que contiene \
fotosensibilizador activado generar\[AAcute] especies reactivas de \
ox\[IAcute]geno en cantidades significativas.\"", 13, FontFamily -> "Avenir", 
              StripOnInput -> False]},
            "RowDefault"]},
          {
           TemplateBox[{
             RadioButtonBox[
              Dynamic[$CellContext`respuesta$$], {3}], 
             TemplateBox[{8}, "Spacer1"], 
             StyleBox[
             "\"C) Porque la luz l\[AAcute]ser elimina el ox\[IAcute]geno de \
los tejidos sanos.\"", 13, FontFamily -> "Avenir", StripOnInput -> False]},
            "RowDefault"]},
          {
           TemplateBox[{
             RadioButtonBox[
              Dynamic[$CellContext`respuesta$$], {4}], 
             TemplateBox[{8}, "Spacer1"], 
             StyleBox[
             "\"D) Porque el fotosensibilizador sustituye la funci\[OAcute]n \
metab\[OAcute]lica de las c\[EAcute]lulas tumorales.\"", 13, FontFamily -> 
              "Avenir", StripOnInput -> False]},
            "RowDefault"]}
         },
         DefaultBaseStyle->"Column",
         GridBoxAlignment->{"Columns" -> {{Left}}},
         GridBoxItemSize->{
          "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
         GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{1.5}}}],
        "Column"]},

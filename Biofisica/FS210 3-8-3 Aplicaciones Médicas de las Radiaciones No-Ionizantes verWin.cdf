Cell[TextData[{
 StyleBox["Desinfecci\[OAcute]n y esterilizaci\[OAcute]n mediante UV-C\n",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 StyleBox[" Definici\[OAcute]n:",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nUtilizaci\[OAcute]n de radiaci\[OAcute]n ultravioleta para \
inactivar microorganismos mediante da\[NTilde]o fotoqu\[IAcute]mico en su \
material gen\[EAcute]tico.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Uso",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nEsterilizaci\[OAcute]n de instrumental, descontaminaci\[OAcute]n \
de superficies, aire hospitalario, agua y componentes sangu\[IAcute]neos.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Ventaja",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nPermite reducir microorganismos sin utilizar agentes \
qu\[IAcute]micos.",
  FontSize->15]
}], "Text",
 CellChangeTimes->{{3.9530649721703463`*^9, 3.953064988003974*^9}, {

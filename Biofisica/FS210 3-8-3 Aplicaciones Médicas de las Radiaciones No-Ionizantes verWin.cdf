Cell[TextData[{
 StyleBox["Terapia PUVA (Psoraleno + UV-A)\n",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 StyleBox[" Definici\[OAcute]n:",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nCombinaci\[OAcute]n de un fotosensibilizante (psoraleno) con \
radiaci\[OAcute]n UVA para potenciar el efecto terap\[EAcute]utico.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Uso",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nT\[EAcute]cnica utilizada para mejora de afecciones inmunes como \
la psoriasis, vit\[IAcute]ligo y algunas dermatosis.\n\n",
  FontSize->15],
 StyleBox["\[Bullet]",
  FontSize->15,
  FontColor->GrayLevel[0.5]],
 StyleBox[" ",
  FontSize->15],
 StyleBox["Ventaja",
  FontSize->15,
  FontWeight->Bold],
 StyleBox[": ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["\nMayor eficacia en casos resistentes a otros tratamientos.",
  FontSize->15]
}], "Text",
 CellChangeTimes->{{3.9530649721703463`*^9, 3.953064988003974*^9}, {
   3.953065028655744*^9, 3.95306503663035*^9}, {3.953993265456999*^9, 
